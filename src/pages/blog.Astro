---
import HeaderBySection from "../components/astro/ui/HeaderBySection.astro";
import Layout from "../layouts/Layout.astro";
import Posts from "../sections/react/blog/Posts";
import logo from "../assets/images/logo.png";
import { fetchPosts } from "../utils/fetch-posts";

const data = await fetchPosts(1, 10);
const posts = data?.data ?? [];
---
<Layout>
    <!-- <section class="mb-16">
        <CarouselBlog client:load />
    </section> -->
    <section class="flex justify-center p-10">
        <HeaderBySection
            textHeader="Blog"
            title="Bienvenido a nuestro Blog — DYRA"
            paragraph="Consejos, noticias y artículos sobre salud y diagnóstico clínico."
            textColor="yellow-secondary"
            img={logo}
            navLinkBtn={true}
            btnProperties={{ text: "Contáctanos" }}
        />
    </section>
    <section>
        <Posts posts={posts} client:load/>
    </section>
</Layout>
