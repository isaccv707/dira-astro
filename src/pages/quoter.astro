---
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/astro/ui/Eyebrow.astro";
import Quoter from "../sections/react/quoter/Quoter";
import { getActiveBranchName } from "../api/branchesApi/branchesApi";

const hasBranchCookie = Boolean(Astro.cookies.get("dyra_branch_id")?.value);
const branchName = hasBranchCookie ? await getActiveBranchName() : null;
---

<Layout
  title="Cotizador de estudios | Laboratorio DYRA"
  description="Arma tu cotización de estudios clínicos: elige tus análisis, consulta el total con IVA incluido y descarga el PDF con los precios de tu sucursal DYRA."
>
  <div class="space-y-8">
    <header class="max-w-3xl">
      <Eyebrow>Cotizador</Eyebrow>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        Cotiza tus estudios
      </h1>
      <p class="mt-3 text-base leading-relaxed text-ink-muted">
        Elige los estudios, revisa el total con IVA incluido y descarga tu
        cotización en PDF{branchName ? <> con los precios de <strong class="font-semibold text-ink">{branchName}</strong></> : null}.
        ¿Solo quieres agendar? Agrega estudios desde el
        <a href="/estudios" class="font-semibold text-brand-ink underline-offset-4 hover:underline">catálogo</a>
        y envíalos por WhatsApp.
      </p>
    </header>

    <Quoter client:load />
  </div>
</Layout>
