---
import Eyebrow from "../components/astro/ui/Eyebrow.astro";
import Layout from "../layouts/Layout.astro";
import Branch from "../sections/react/branch/Branch";
import { getBranchesWithSchedules } from "../api/branchesApi/branchesApi";
import { branchJsonLd } from "../utils/structuredData";

const branches = await getBranchesWithSchedules();
const jsonLd = branches.map(branchJsonLd);
---

<Layout
  title="Nuestras Sucursales | DYRA"
  description="Encuentra tu sucursal de Laboratorio DYRA más cercana. Contamos con múltiples ubicaciones para tu comodidad."
  jsonLd={jsonLd}
>
  <header class="mb-14">
    <Eyebrow>Ubicaciones</Eyebrow>

    <h1
      class="mt-4 text-3xl font-bold tracking-tight text-yellow-ink sm:text-4xl lg:text-5xl"
    >
      Nuestras sucursales a
      <span
        class="block bg-linear-to-r from-green-primary via-green-secondary to-yellow-primary bg-clip-text text-transparent"
      >
        tu alcance en todo momento.
      </span>
    </h1>

    <p class="mt-4 max-w-xl text-pretty text-sm text-ink-muted sm:text-base">
      Contamos con múltiples puntos de atención para tu comodidad. Cada una de
      nuestras sucursales cumple con los más altos estándares de calidad y
      tecnología.
    </p>
  </header>
  <Branch client:load />
</Layout>
