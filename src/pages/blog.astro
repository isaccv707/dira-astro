---
import Layout from "../layouts/Layout.astro";
import HeaderBySection from "../components/astro/ui/HeaderBySection.astro";
import { PostsWrapper } from "../components/react/wrappers/PostsWrapper";

import logoDyra from "../assets/images/logo.png";
---

<Layout>
    <section class="flex justify-center p-10">
        <HeaderBySection
            textHeader="Blog"
            title="Bienvenido a nuestro Blog — DYRA"
            paragraph="Consejos, noticias y artículos sobre salud y diagnóstico clínico."
            textColor="yellow-secondary"
            img={logoDyra}
            navLinkBtn={true}
            btnProperties={{ text: "Contáctanos" }}
        />
    </section>
    <section>
        <PostsWrapper client:load/>
    </section>
</Layout>
