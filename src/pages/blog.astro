---
import Layout from "../layouts/Layout.astro";
import HeaderBySection from "../components/astro/ui/HeaderBySection.astro";
import { PostsWrapper } from "../components/react/wrappers/PostsWrapper";

import logoDyra from "../assets/images/logos/logo.png";
import PostsSection from "../sections/astro/Posts-section.astro";
---

<Layout>
    <section
        class="w-full max-w-7xl mx-auto flex justify-center px-6 py-12 sm:px-10 md:px-16 md:py-12 lg:px-20 lg:py-20"
    >
        <HeaderBySection
            textHeader="Blog"
            title="Bienvenido a nuestro Blog — DYRA"
            paragraph="Consejos, noticias y artículos sobre salud y diagnóstico clínico."
            textColor="yellow-secondary"
            img={logoDyra}
            navLinkBtn={true}
            btnProperties={{ text: "Contáctanos" }}
        />
    </section>
    <PostsSection />
</Layout>
