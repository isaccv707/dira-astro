---
import Layout from "../layouts/Layout.astro";
import HeaderBySection from "../components/astro/ui/HeaderBySection.astro";
import { PostsWrapper } from "../components/react/wrappers/PostsWrapper";

import logoDyra from "../assets/images/logos/logo.png";
---

<Layout>
    <section class="w-full max-w-7xl mx-auto flex justify-center px-6 py-12 sm:px-10 md:px-16 md:py-20 lg:px-20 lg:py-32">
        <HeaderBySection
            textHeader="Blog"
            title="Bienvenido a nuestro Blog — DYRA"
            paragraph="Consejos, noticias y artículos sobre salud y diagnóstico clínico."
            textColor="yellow-secondary"
            img={logoDyra}
            navLinkBtn={true}
            btnProperties={{ text: "Contáctanos" }}
        />
    </section>
    <section class="w-full max-w-7xl mx-auto px-6 pb-16 sm:px-10 md:px-16 md:pb-24 lg:px-20 lg:pb-32">
        <PostsWrapper client:load/>
    </section>
</Layout>
