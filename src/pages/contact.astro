---
import Layout from "../layouts/Layout.astro";

import CTAContact from "../components/astro/CTA/CTAContact.astro";
import { ContactForm } from "../sections/react/contact/ContactForm";
---

<Layout title="" description="">
  <section>
    <div class="relative flex flex-col gap-16 lg:gap-20">
      <section
        class="grid items-start gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]"
      >
        <div class="space-y-6 animate-fade-up">
          <h1
            class="text-balance text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl text-yellow-secondary"
          >
            Estamos listos para
            <span
              class="block bg-linear-to-r from-green-primary via-green-secondary to-yellow-primary bg-clip-text text-transparent"
            >
              atenderte y resolver tus dudas.
            </span>
          </h1>

          <p class="max-w-xl text-sm text-grey sm:text-base">
            Ya sea que necesites agendar una cita, resolver una duda sobre tus
            resultados o conocer más sobre nuestros servicios, en
            {" "}
            <span class="font-semibold text-green-secondary">DYRA</span>
            {" "}
            estamos para apoyarte con un trato cercano y profesional.
          </p>

          <CTAContact />
        </div>

        <div class="animate-fade-up">
          <ContactForm client:load />
        </div>
      </section>
    </div>
  </section>
</Layout>
