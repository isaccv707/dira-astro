---
import Layout from "../layouts/Layout.astro";
import ContactFormWrapper from "../components/react/wrappers/ContactFormWrapper";
import { whatsapp, gmail, facebook } from "../assets/icons/networks-icons";
import { PhoneCall } from "lucide-react";
---

<Layout>
    <section class="relative overflow-hidden bg-white text-black">
        <div
            class="relative mx-auto flex max-w-6xl flex-col gap-16 px-4 py-16 sm:px-6 lg:gap-20 lg:px-8 lg:py-24"
        >
            <section
                class="grid items-start gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]"
            >
                <div class="space-y-6 animate-fade-up">
                    <h1
                        class="text-balance text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl text-yellow-secondary"
                    >
                        Estamos listos para
                        <span
                            class="block bg-gradient-to-r from-green-primary via-green-secondary to-yellow-primary bg-clip-text text-transparent"
                        >
                            atenderte y resolver tus dudas.
                        </span>
                    </h1>

                    <p class="max-w-xl text-sm text-grey sm:text-base">
                        Ya sea que necesites agendar una cita, resolver una duda
                        sobre tus resultados o conocer más sobre nuestros
                        servicios, en
                        {" "}
                        <span class="font-semibold text-green-secondary"
                            >DYRA</span
                        >
                        {" "}
                        estamos para apoyarte con un trato cercano y profesional.
                    </p>

                    <div
                        class="rounded-2xl border border-green-primary/15 bg-green-primary/5 p-4"
                    >
                        <p
                            class="text-xs font-medium text-green-primary sm:text-sm"
                        >
                            ¿Necesitas más información?
                        </p>
                        <p
                            class="mt-1 text-xs text-neutral-600 sm:text-sm mb-2"
                        >
                            Contáctanos por el medio de tu preferencia
                        </p>
                        <div
                            class="flex gap-2 flex-row sm:items-center sm:gap-3"
                        >
                            <a
                                href="https://wa.me/523318622542"
                                target="_blank"
                                rel="noopener"
                                class="inline-flex items-center justify-center hover:opacity-95"
                            >
                                <img
                                    src={whatsapp.src}
                                    alt="WhatsApp DYRA"
                                    class="w-8 h-auto"
                                />
                            </a>

                            <a
                                href="mailto:contacto@dyra.com"
                                class="inline-flex items-center justify-center hover:opacity-95"
                            >
                                <img
                                    src={gmail.src}
                                    alt="Correo DYRA"
                                    class="w-8 h-auto"
                                />
                            </a>

                            <a
                                href="tel:+523318622542"
                                class="inline-flex items-center justify-center bg-green-primary rounded p-0.5 hover:opacity-95"
                                aria-label="Llamar a DYRA"
                            >
                                <PhoneCall className="text-white" />
                            </a>
                        </div>
                    </div>
                </div>

                <div class="animate-fade-up">
                    <ContactFormWrapper client:load />
                </div>
            </section>
        </div>
    </section>
</Layout>
