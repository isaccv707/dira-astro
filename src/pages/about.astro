---
import AboutCardCarousel from "../components/astro/cards/AboutCardCarousel.astro";
import Layout from "../layouts/Layout.astro";
import CompanyValuesSection from "../sections/astro/about/CompanyValues-section.astro";
import HeroAboutSection from "../sections/astro/about/HeroAbout-section.astro";
import MetricsDyra from "../sections/react/MetricsDyra-section";
import { carouselHomeData } from "../data/carousel/carouselHome-data";
import ReviewSection from "../sections/astro/Review-section.astro";
---

<Layout title="" description="">
    <div class="grid grid-cols-1 items-center lg:grid-cols-2 gap-10">
        <HeroAboutSection />

        <AboutCardCarousel
            title={"Laboratorio DYRA"}
            paragraph={"Diagnóstico y Referencia Analítica"}
            images={carouselHomeData}
            items={[
                {
                    icon: "✔",
                    text: "Resultados con controles de calidad internos y externos",
                },
                {
                    icon: "⏱",
                    text: "Procesos automatizados para tiempos de respuesta óptimos",
                },
                {
                    icon: "🌐",
                    text: "Entrega digital y segura de resultados",
                },
            ]}
        />
    </div>

    <CompanyValuesSection />

    <MetricsDyra client:visible />

    <div class="mt-14">
        <ReviewSection />
    </div>
</Layout>
