---
import Layout from "../layouts/Layout.astro";
import { branches } from "../data/branches/branches"; // ajusta la ruta

const formatPhoneToTel = (phone: string) => phone.replace(/[^\d+]/g, "");
const formatWhatsToWa = (phone: string) => phone.replace(/[^\d]/g, "");

const firstWithMap = branches.find(b => Boolean(b.location?.mapSrc)) ?? branches[0];
const initialId = firstWithMap?.id ?? branches[0]?.id;

const has24h = (schedule: any[]) =>
  schedule?.some((d) => String(d.day).toLowerCase().includes("24") && d.closed === false);

const isClosedDay = (d: any) => d.closed === true;

const scheduleLabel = (d: any) => {
  if (d.closed) return `${d.day}: Cerrado`;
  if (!d.open && !d.close) return `${d.day}`;
  return `${d.day}: ${d.open ?? ""}${d.open && d.close ? " – " : ""}${d.close ?? ""}`;
};
---

<Layout>
  <section class="w-full px-4 sm:px-6 lg:px-10 py-10">
    <!-- HERO -->
    <div class="relative overflow-hidden rounded-3xl border border-gray-100 bg-gradient-to-br from-green-50 via-white to-yellow-50 p-6 sm:p-10 shadow-sm">
      <div class="absolute -right-24 -top-24 h-64 w-64 rounded-full bg-green-200/30 blur-3xl"></div>
      <div class="absolute -left-24 -bottom-24 h-64 w-64 rounded-full bg-yellow-200/30 blur-3xl"></div>

      <div class="relative">
        <p class="inline-flex items-center gap-2 rounded-full bg-white/70 px-3 py-1 text-xs font-semibold text-green-700 ring-1 ring-green-200">
          <span class="h-2 w-2 rounded-full bg-green-500"></span>
          Sucursales DYRA
        </p>

        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
          Encuentra tu sucursal y consulta tus estudios
        </h1>

        <p class="mt-3 max-w-2xl text-sm text-gray-600 sm:text-base">
          Selecciona una sucursal para ver ubicación, horarios y abrir el portal de resultados.
        </p>
      </div>
    </div>

    <!-- CONTENT -->
    <div class="mt-8 grid gap-6 lg:grid-cols-12">
      <!-- LEFT: LIST -->
      <div class="lg:col-span-7">
        <div class="flex items-end justify-between gap-3">
          <div>
            <h2 class="text-xl font-extrabold text-gray-900">Nuestras sucursales</h2>
            <p class="text-sm text-gray-600">Haz click en una sucursal para ver el mapa.</p>
          </div>

          <!-- hint -->
          <div class="hidden sm:flex items-center gap-2 text-xs text-gray-500">
            <span class="inline-flex h-2 w-2 rounded-full bg-green-500"></span>
            Info actualizable
          </div>
        </div>

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {branches.map((b) => {
            const tel = formatPhoneToTel(b.contact.phone);
            const wa = formatWhatsToWa(b.contact.whatsApp);
            const twentyfour = has24h(b.schedule);

            return (
              <article
                class="branch-card group relative overflow-hidden rounded-3xl border border-gray-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
                data-branch-id={b.id}
              >
                <!-- subtle gradient -->
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-green-50/50 via-white to-yellow-50/40 opacity-0 transition group-hover:opacity-100"></div>

                <div class="relative">
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <p class="inline-flex items-center rounded-full bg-green-50 px-3 py-1 text-xs font-bold text-green-700 ring-1 ring-green-100">
                        {b.state}
                      </p>
                      <h3 class="mt-2 text-lg font-extrabold text-gray-900">
                        {b.name}
                      </h3>
                      <p class="mt-2 text-sm text-gray-600">
                        {b.location.address}
                      </p>
                      {b.location.references && (
                        <p class="mt-1 text-xs text-gray-500">
                          {b.location.references}
                        </p>
                      )}
                    </div>

                    {twentyfour ? (
                      <span class="shrink-0 rounded-full bg-yellow-100 px-3 py-1 text-xs font-extrabold text-yellow-800">
                        24/7
                      </span>
                    ) : (
                      <span class="shrink-0 rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-600">
                        Horarios
                      </span>
                    )}
                  </div>

                  <!-- Schedule chips -->
                  <div class="mt-4 flex flex-wrap gap-2">
                    {b.schedule.slice(0, 7).map((d) => (
                      <span
                        class={[
                          "rounded-full px-3 py-1 text-xs font-semibold ring-1",
                          isClosedDay(d)
                            ? "bg-red-50 text-red-700 ring-red-100"
                            : "bg-white text-gray-700 ring-gray-200",
                        ].join(" ")}
                      >
                        {scheduleLabel(d)}
                      </span>
                    ))}
                  </div>

                  <!-- Actions -->
                  <div class="mt-5 grid grid-cols-1 gap-2 sm:grid-cols-2">
                    <a
                      href={b.portals.urlResults}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center gap-2 rounded-2xl bg-green-600 px-4 py-3 text-sm font-extrabold text-white shadow-sm transition hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500"
                    >
                      Consultar resultados
                      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3z"></path>
                        <path d="M5 5h6V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-6h-2v6H5V5z"></path>
                      </svg>
                    </a>

                    <a
                      href={b.location.googleMapsUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center gap-2 rounded-2xl bg-white px-4 py-3 text-sm font-extrabold text-gray-900 ring-1 ring-gray-200 transition hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-green-500"
                    >
                      Ver en Google Maps
                      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2C8.14 2 5 5.14 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.86-3.14-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"></path>
                      </svg>
                    </a>
                  </div>

                  <div class="mt-3 grid grid-cols-2 gap-2">
                    <a
                      href={`https://wa.me/${wa}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center gap-2 rounded-2xl bg-green-50 px-4 py-2 text-xs font-extrabold text-green-800 ring-1 ring-green-100 transition hover:bg-green-100"
                    >
                      WhatsApp
                    </a>

                    <a
                      href={`tel:${tel}`}
                      class="inline-flex items-center justify-center gap-2 rounded-2xl bg-gray-50 px-4 py-2 text-xs font-extrabold text-gray-800 ring-1 ring-gray-100 transition hover:bg-gray-100"
                    >
                      Llamar
                    </a>
                  </div>

                  <!-- "Select" for map -->
                  <button
                    type="button"
                    class="select-branch mt-4 w-full rounded-2xl border border-gray-100 bg-gradient-to-r from-white to-gray-50 px-4 py-3 text-sm font-bold text-gray-900 transition hover:border-green-200 hover:shadow-sm focus:outline-none focus:ring-2 focus:ring-green-500"
                    data-select-branch={b.id}
                  >
                    Ver mapa y detalles
                  </button>
                </div>
              </article>
            );
          })}
        </div>
      </div>

      <!-- RIGHT: MAP + DETAILS -->
      <aside class="lg:col-span-5">
        <div class="sticky top-6">
          <div class="overflow-hidden rounded-3xl border border-gray-100 bg-white shadow-sm">
            <div class="border-b border-gray-100 p-5">
              <p class="text-xs font-semibold text-gray-500">Mapa y detalles</p>
              <h3 id="map-title" class="mt-1 text-lg font-extrabold text-gray-900">
                {firstWithMap?.name ?? branches[0]?.name}
              </h3>
              <p id="map-address" class="mt-2 text-sm text-gray-600">
                {firstWithMap?.location?.address ?? branches[0]?.location?.address}
              </p>
              <p id="map-ref" class="mt-1 text-xs text-gray-500">
                {firstWithMap?.location?.references ?? ""}
              </p>

              <div class="mt-4 flex flex-wrap gap-2">
                <a
                  id="map-results"
                  class="inline-flex items-center justify-center rounded-full bg-green-600 px-4 py-2 text-xs font-extrabold text-white transition hover:bg-green-700"
                  href={firstWithMap?.portals?.urlResults ?? branches[0]?.portals?.urlResults}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Consultar resultados
                </a>

                <a
                  id="map-gmaps"
                  class="inline-flex items-center justify-center rounded-full bg-white px-4 py-2 text-xs font-extrabold text-gray-900 ring-1 ring-gray-200 transition hover:bg-gray-50"
                  href={firstWithMap?.location?.googleMapsUrl ?? branches[0]?.location?.googleMapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Abrir en Maps
                </a>
              </div>
            </div>

            <div class="p-4">
              <!-- MAP -->
              <div id="map-container" class="overflow-hidden rounded-2xl bg-gray-50 ring-1 ring-gray-100">
                {firstWithMap?.location?.mapSrc ? (
                  <iframe
                    id="map-iframe"
                    class="h-[320px] w-full"
                    src={firstWithMap.location.mapSrc}
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen
                    title={`Mapa ${firstWithMap.name}`}
                  />
                ) : (
                  <div id="map-empty" class="flex min-h-[320px] flex-col items-center justify-center p-6 text-center">
                    <p class="text-sm font-bold text-gray-900">Mapa no disponible aquí</p>
                    <p class="mt-1 text-xs text-gray-600">Abre la ubicación en Google Maps.</p>
                    <a
                      id="map-empty-link"
                      class="mt-4 inline-flex items-center justify-center rounded-2xl bg-white px-4 py-2 text-xs font-extrabold text-gray-900 ring-1 ring-gray-200 transition hover:bg-gray-50"
                      href={firstWithMap?.location?.googleMapsUrl ?? branches[0]?.location?.googleMapsUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Abrir en Google Maps
                    </a>
                  </div>
                )}
              </div>

              <!-- CONTACT -->
              <div class="mt-4 grid gap-3 rounded-2xl bg-gradient-to-br from-green-50 to-white p-4 ring-1 ring-green-100">
                <p class="text-xs font-extrabold text-green-800">Contacto</p>
                <div class="grid gap-2 text-sm text-gray-800">
                  <p><span class="font-bold">Tel:</span> <span id="c-phone">{firstWithMap?.contact?.phone ?? branches[0]?.contact?.phone}</span></p>
                  <p><span class="font-bold">WhatsApp:</span> <span id="c-wa">{firstWithMap?.contact?.whatsApp ?? branches[0]?.contact?.whatsApp}</span></p>
                  <p class="text-xs text-gray-500" id="c-email">{firstWithMap?.contact?.email ?? ""}</p>
                </div>

                <div class="grid grid-cols-2 gap-2">
                  <a
                    id="c-wa-link"
                    href={`https://wa.me/${formatWhatsToWa(firstWithMap?.contact?.whatsApp ?? branches[0]?.contact?.whatsApp ?? "")}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center rounded-2xl bg-green-600 px-4 py-2 text-xs font-extrabold text-white hover:bg-green-700"
                  >
                    WhatsApp
                  </a>
                  <a
                    id="c-tel-link"
                    href={`tel:${formatPhoneToTel(firstWithMap?.contact?.phone ?? branches[0]?.contact?.phone ?? "")}`}
                    class="inline-flex items-center justify-center rounded-2xl bg-white px-4 py-2 text-xs font-extrabold text-gray-900 ring-1 ring-gray-200 hover:bg-gray-50"
                  >
                    Llamar
                  </a>
                </div>
              </div>

              <!-- SCHEDULE LIST -->
              <div class="mt-4 rounded-2xl border border-gray-100 bg-white p-4">
                <p class="text-xs font-extrabold text-gray-900">Horario</p>
                <ul id="schedule-list" class="mt-3 space-y-2 text-sm text-gray-700">
                  {(firstWithMap?.schedule ?? branches[0]?.schedule).map((d) => (
                    <li class="flex items-center justify-between rounded-xl bg-gray-50 px-3 py-2">
                      <span class="font-bold">{d.day}</span>
                      <span class={d.closed ? "text-red-600 font-semibold" : "text-gray-700"}>
                        {d.closed ? "Cerrado" : (d.open && d.close ? `${d.open} – ${d.close}` : "Abierto")}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <!-- small note -->
          <p class="mt-3 text-xs text-gray-500">
            Si tu sucursal no carga mapa embebido, usa “Abrir en Maps”.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <!-- CLIENT SCRIPT: switch right panel details -->
  <script define:vars={{ branches, initialId }}>
    const data = branches;

    const formatPhoneToTel = (phone) => (phone || "").replace(/[^\d+]/g, "");
    const formatWhatsToWa = (phone) => (phone || "").replace(/[^\d]/g, "");

    const $ = (sel) => document.querySelector(sel);

    const mapTitle = $("#map-title");
    const mapAddress = $("#map-address");
    const mapRef = $("#map-ref");
    const mapResults = $("#map-results");
    const mapGmaps = $("#map-gmaps");

    const mapContainer = $("#map-container");
    const scheduleList = $("#schedule-list");

    const cPhone = $("#c-phone");
    const cWa = $("#c-wa");
    const cEmail = $("#c-email");
    const cWaLink = $("#c-wa-link");
    const cTelLink = $("#c-tel-link");

    const renderSchedule = (branch) => {
      if (!scheduleList) return;
      scheduleList.innerHTML = "";

      (branch.schedule || []).forEach((d) => {
        const li = document.createElement("li");
        li.className = "flex items-center justify-between rounded-xl bg-gray-50 px-3 py-2";

        const left = document.createElement("span");
        left.className = "font-bold";
        left.textContent = d.day;

        const right = document.createElement("span");
        if (d.closed) {
          right.className = "text-red-600 font-semibold";
          right.textContent = "Cerrado";
        } else if (d.open && d.close) {
          right.className = "text-gray-700";
          right.textContent = `${d.open} – ${d.close}`;
        } else {
          right.className = "text-gray-700";
          right.textContent = "Abierto";
        }

        li.appendChild(left);
        li.appendChild(right);
        scheduleList.appendChild(li);
      });
    };

    const renderMap = (branch) => {
      if (!mapContainer) return;

      // Clear map container
      mapContainer.innerHTML = "";

      const mapSrc = branch.location?.mapSrc;

      if (mapSrc) {
        const iframe = document.createElement("iframe");
        iframe.className = "h-[320px] w-full";
        iframe.src = mapSrc;
        iframe.loading = "lazy";
        iframe.referrerPolicy = "no-referrer-when-downgrade";
        iframe.allowFullscreen = true;
        iframe.title = `Mapa ${branch.name}`;
        mapContainer.appendChild(iframe);
      } else {
        const wrap = document.createElement("div");
        wrap.className = "flex min-h-[320px] flex-col items-center justify-center p-6 text-center";

        const t = document.createElement("p");
        t.className = "text-sm font-bold text-gray-900";
        t.textContent = "Mapa no disponible aquí";

        const s = document.createElement("p");
        s.className = "mt-1 text-xs text-gray-600";
        s.textContent = "Abre la ubicación en Google Maps.";

        const a = document.createElement("a");
        a.className =
          "mt-4 inline-flex items-center justify-center rounded-2xl bg-white px-4 py-2 text-xs font-extrabold text-gray-900 ring-1 ring-gray-200 transition hover:bg-gray-50";
        a.href = branch.location?.googleMapsUrl || "#";
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.textContent = "Abrir en Google Maps";

        wrap.appendChild(t);
        wrap.appendChild(s);
        wrap.appendChild(a);
        mapContainer.appendChild(wrap);
      }
    };

    const renderRightPanel = (branch) => {
      mapTitle && (mapTitle.textContent = branch.name);
      mapAddress && (mapAddress.textContent = branch.location?.address || "");
      mapRef && (mapRef.textContent = branch.location?.references || "");

      if (mapResults) mapResults.href = branch.portals?.urlResults || "#";
      if (mapGmaps) mapGmaps.href = branch.location?.googleMapsUrl || "#";

      if (cPhone) cPhone.textContent = branch.contact?.phone || "";
      if (cWa) cWa.textContent = branch.contact?.whatsApp || "";
      if (cEmail) cEmail.textContent = branch.contact?.email || "";

      if (cWaLink) cWaLink.href = `https://wa.me/${formatWhatsToWa(branch.contact?.whatsApp)}`;
      if (cTelLink) cTelLink.href = `tel:${formatPhoneToTel(branch.contact?.phone)}`;

      renderMap(branch);
      renderSchedule(branch);
    };

    // initial render
    const initial = data.find((b) => b.id === initialId) || data[0];
    if (initial) renderRightPanel(initial);

    // click handlers
    document.querySelectorAll("[data-select-branch]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-select-branch");
        const branch = data.find((b) => b.id === id);
        if (!branch) return;

        // highlight selected card
        document.querySelectorAll(".branch-card").forEach((card) => {
          card.classList.remove("ring-2", "ring-green-500");
        });
        const card = document.querySelector(`[data-branch-id="${id}"]`);
        card?.classList.add("ring-2", "ring-green-500");

        renderRightPanel(branch);
      });
    });
  </script>
</Layout>
