---
import Layout from "../layouts/Layout.astro";
import HeroHome from "../sections/astro/HeroHome.astro";
import OurServices from "../sections/astro/OurServices.astro";
import About from "../sections/astro/About.astro";
import Benefits from "../sections/astro/Benefits.astro";
import QuickActionsWrapper from "../components/react/wrappers/QuickActionsWrapper";
---

<Layout>
    <main class="overflow-x-hidden flex flex-col">
        <section class="w-full">
            <HeroHome />
        </section>

        <section class="w-full py-12 md:py-16 lg:py-20 px-4 sm:px-8 lg:px-12">
            <QuickActionsWrapper client:load />
        </section>

        <section class="w-full py-12 md:py-20 lg:py-24 px-4 sm:px-8 lg:px-12">
            <OurServices />
        </section>

        <section class="w-full bg-white py-16 md:py-24 lg:py-32 px-4 sm:px-8 lg:px-12">
            <About />
        </section>

        <section
            class="w-full h-auto flex flex-col justify-center bg-green-secondary py-16 md:py-24 lg:py-32 px-4 sm:px-8 lg:px-12"
        >
            <Benefits />
        </section>
    </main>
</Layout>
