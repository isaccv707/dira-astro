---
import Layout from "../layouts/Layout.astro";
import HeroHome from "../sections/astro/hero/HeroHome.astro";
import OurServices from "../sections/astro/service/OurServices.astro";
import HowItWorks from "../sections/astro/home/HowItWorks.astro";
import About from "../sections/astro/about/About.astro";
import Review from "../sections/astro/review/Review.astro";
import { getBranchesWithSchedules } from "../api/branchesApi/branchesApi";
import { branchJsonLd } from "../utils/structuredData";

// Local-business data for every branch (address, phone, hours).
const branches = await getBranchesWithSchedules();
const jsonLd = branches.map(branchJsonLd);
---

<Layout
  title="Laboratorio DYRA | Diagnóstico y Referencia Analítica"
  description="Laboratorio clínico en Jalisco y Colima. Consulta precio, preparación y tiempo de entrega de tus estudios, cotiza en línea y agenda por WhatsApp."
  jsonLd={jsonLd}
>
  <HeroHome />
  <OurServices />
  <HowItWorks />
  <About />
  <Review />
</Layout>
