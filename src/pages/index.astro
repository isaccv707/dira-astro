---
import Layout from "../layouts/Layout.astro";
import HeroHome from "../sections/astro/HeroHome.astro";
import OurServices from "../sections/astro/OurServices.astro";
import About from "../sections/astro/About.astro";
import Benefits from "../sections/astro/Benefits.astro";
import QuickActionsWrapper from "../components/react/wrappers/QuickActionsWrapper";
---

<Layout>
    <main>
        <section class="w-full">
            <HeroHome />
        </section>

        <section class="py-10">
            <QuickActionsWrapper client:load />
        </section>

        <section class="py-10">
            <OurServices />
        </section>

        <section class="w-full bg-white py-10 sm:py-20">
            <About />
        </section>

        <section
            class="w-full h-auto flex flex-col justify-center bg-green-secondary py-10"
        >
            <Benefits />
        </section>
    </main>
</Layout>
