---
import Layout from "../layouts/Layout.astro";
import QuickActions from "../sections/astro/QuickActions.astro";
import About from "../sections/astro/about/About.astro";
import Benefits from "../sections/astro/about/Benefits.astro";
import HeroHome from "../sections/astro/hero/HeroHome.astro";
import Review from "../sections/astro/review/Review.astro";
import OurServices from "../sections/astro/service/OurServices.astro";
import MetricsDyra from "../sections/react/common/MetricsDyra";
---

<Layout
  title="Laboratorio DYRA | Diagnóstico y Referencia Analítica"
  description="Bienvenido a Laboratorio DYRA. Ofrecemos análisis clínicos con tecnología de punta y calidez humana en Guadalajara y Colima."
>
  <div class="-mt-10">
    <HeroHome />
  </div>

  <div class="-mt-32">
    <QuickActions />
  </div>

  <OurServices />

  <About />

  <Benefits />

  <section class="mb-24">
    <MetricsDyra client:visible />
  </section>

  <Review />
</Layout>
