---
import NavLinkButton from "../components/react/navigation/NavLinkButton";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Página no encontrada | DYRA"
  description="La página que buscas no existe o fue movida. Regresa al inicio de Laboratorio DYRA."
>
  <main class="grid min-h-screen place-items-center">
    <div class="text-center max-w-lg">
      <h1
        class="text-7xl sm:text-8xl font-black text-green-secondary drop-shadow-md"
      >
        404
      </h1>

      <h2
        class="mt-6 text-3xl sm:text-4xl font-black tracking-tight text-green-light"
      >
        Página no encontrada
      </h2>

      <p class="mt-4 text-lg sm:text-xl text-grey-custom">
        Lo sentimos, no pudimos encontrar la página que estás buscando.
      </p>

      <div class="mt-10 flex justify-center">
        <NavLinkButton
          path="/"
          text="Ir al inicio"
          variant={"primary"}
          size="md"
        />
      </div>
    </div>
  </main>
</Layout>
