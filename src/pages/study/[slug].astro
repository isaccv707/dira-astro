---
import Layout from "../../layouts/Layout.astro";
import { getOneResource } from "../../utils/getOneResource";
import { getAllStudies } from "../../api/studiesApi/studiesApi";
import { resolveBranchId } from "../../stores/branchStore";
import type { Study } from "../../interfaces/study.interface";
import StudyDetail from "../../sections/astro/StudyDetail.astro";

const RECOMMENDED_STUDIES_COUNT = 4;

const { slug = "" } = Astro.params;
const branchId = resolveBranchId();

const study = await getOneResource<Study>("studies", slug as string, {
  branchId,
});

if (!study) {
  return Astro.redirect("/404");
}

const { name, description = "" } = study;

const { data: otherStudies } = await getAllStudies({
  limit: 20,
  branchId,
});

const recommendedStudies = otherStudies
  .filter((item) => item.id !== study.id)
  .sort(() => Math.random() - 0.5)
  .slice(0, RECOMMENDED_STUDIES_COUNT);
---

<Layout
  title={`${name} | Laboratorio DYRA`}
  description={description ||
    `Conoce todo sobre el estudio ${name}: preparación, tipo de muestra y tiempo de entrega en Laboratorio DYRA.`}
>
  <StudyDetail study={study} recommendedStudies={recommendedStudies} />
</Layout>
