---
import Layout from "../../layouts/Layout.astro";

import ServiceHeroSection from "../../sections/astro/service/ServiceHero-section.astro";
import ServiceBenefitsSection from "../../sections/astro/service/ServiceBenefits-section.astro";
import ServicesSection from "../../sections/astro/service/Services-section.astro";

import type { Service } from "../../interfaces/service.interface";
import { getOneResource } from "../../utils/getOneResource";
import CTAContact from "../../components/astro/CTA/CTAContact.astro";

const { slug } = Astro.params;

const service = (await getOneResource<Service>(
  "services",
  slug as string,
)) as Service;

if (!service) {
  return Astro.redirect("/404");
}
const { name, description = "", imageUrl = "", benefits = [] } = service;
---

<Layout
  title={`${name} | Laboratorio DYRA`}
  description={description ||
    `Conoce nuestro servicio de ${name}: información, beneficios y estudios disponibles en Laboratorio DYRA.`}
>
  <ServiceHeroSection
    name={name}
    description={description}
    imageUrl={imageUrl}
  />

  <ServiceBenefitsSection benefits={benefits} />

  <ServicesSection service={service} />

  <CTAContact />
</Layout>
