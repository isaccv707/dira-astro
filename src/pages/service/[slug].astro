---
import Layout from "../../layouts/Layout.astro";

import ServiceHeroSection from "../../sections/astro/service/ServiceHero.astro";
import ServiceBenefitsSection from "../../sections/astro/service/ServiceBenefits.astro";
import ServiceDetailsSection from "../../sections/astro/service/ServiceDetails.astro";
import ServicesSection from "../../sections/astro/service/Services.astro";
import ServiceRecommendedSection from "../../sections/astro/service/ServiceRecommended.astro";

import type { ServiceDetail } from "../../interfaces/service.interface";
import { breadcrumbJsonLd } from "../../utils/structuredData";
import { getCloudinaryUrl } from "../../utils/cloudinary";
import { getOneResource } from "../../utils/getOneResource";
import { resolveBranchId } from "../../stores/branchStore";
import CTAContact from "../../components/astro/CTA/CTAContact.astro";
import { studyTypeToIsPanel } from "../../utils/studyTypeFilter";
import { parseCatalogQuery } from "../../utils/catalogQuery";

const { slug } = Astro.params;
const branchId = resolveBranchId();

const STUDIES_PAGE_SIZE = 20;

// ?q=&tipo=&pagina= — SSR the exact catalog view so shared links match.
const catalogQuery = parseCatalogQuery(Astro.url.searchParams);

const service = await getOneResource<ServiceDetail>("services", slug as string, {
  branchId,
  page: catalogQuery.page,
  limit: STUDIES_PAGE_SIZE,
  search: catalogQuery.search || undefined,
  isPanel: studyTypeToIsPanel(catalogQuery.studyType),
});

if (!service) {
  return Astro.rewrite("/404");
}
const {
  id,
  name,
  description = "",
  imageUrl = "",
  mobileImageUrl,
  benefits = [],
  details = [],
} = service;

const ogImage = imageUrl
  ? getCloudinaryUrl(imageUrl, { width: 1200, height: 630, format: "jpg" })
  : undefined;
const jsonLd = [
  breadcrumbJsonLd([
    { name: "Inicio", path: "/" },
    { name, path: `/service/${service.slug}` },
  ]),
];
---

<Layout
  title={`${name} | Laboratorio DYRA`}
  image={ogImage}
  imageAlt={name}
  jsonLd={jsonLd}
  noindex={Boolean(catalogQuery.search)}
  description={description ||
    `Conoce nuestro servicio de ${name}: información, beneficios y estudios disponibles en Laboratorio DYRA.`}
>
  <ServiceHeroSection
    name={name}
    description={description}
    imageUrl={imageUrl}
    mobileImageUrl={mobileImageUrl}
    studyCount={catalogQuery.search || catalogQuery.studyType !== "all" ? 0 : (service.studies?.total ?? 0)}
  />

  <ServicesSection
    service={service}
    catalogQuery={catalogQuery}
    pageSize={STUDIES_PAGE_SIZE}
  />

  <ServiceBenefitsSection benefits={benefits} />

  <ServiceDetailsSection details={details} />

  <ServiceRecommendedSection currentServiceId={id} />

  <CTAContact />
</Layout>
