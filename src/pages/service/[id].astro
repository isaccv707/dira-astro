---
import { services } from "../../data/services/services";
import Layout from "../../layouts/Layout.astro";
import ServicesWrapper from "../../components/react/wrappers/ServicesWrapper";
import ServiceHeroSection from "../../sections/astro/service/ServiceHeroSection.astro";
import ServiceBenefitsSection from "../../sections/astro/service/ServiceBenefitsSection.astro";
import Cat from "../../components/astro/ui/Cat.astro";

const {id} = Astro.params;
const service = services.find((service) => service.id === id);

if (!service) {
  return Astro.redirect("/404");
}
---

<Layout>

  <ServiceHeroSection service={service} />

  <section class="w-full">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-12 lg:pb-16">
      <ServiceBenefitsSection />

      <div class="mt-10">
        <ServicesWrapper service={service} client:load />
      </div>

      <Cat
        title="¿No sabes cuál estudio necesitas?"
        paragraph={`Te ayudamos a elegir el estudio ideal según tu caso y te
                indicamos preparación, tiempos y cómo agendar.`}
      />
    </div>
  </section>
</Layout>
