---
import Header from "../sections/astro/Header-section.astro";
import logo from "../assets/images/logos/logo_dyra.png";
import "../styles/global.css";
import { ToastContainer } from "react-toastify";
import "react-toastify/dist/ReactToastify.css";
import ModalManager from "../components/react/modal/ModalManager";
import BranchSelectorManager from "../components/react/branch/BranchSelectorManager";
import FloatingActions from "../sections/react/FloatingActions";
import DrawerManager from "../components/react/drawer/DrawerManager";
import Footer from "../sections/astro/layout/Footer.astro";
import { getServicesNavRoutes } from "../api/servicesApi/serviceApi";
import {
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_ALT,
  SITE_LANG,
  SITE_LOCALE,
  SITE_NAME,
  absoluteUrl,
} from "../constants/site";
import { organizationJsonLd, websiteJsonLd } from "../utils/structuredData";
import { resolveBranchId } from "../stores/branchStore";

interface Props {
  title: string;
  description: string;
  keywords?: string;
  lang?: string;
  /** Relative path or absolute URL; defaults to the 1200×630 brand card. */
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  /** Extra schema.org objects for this page (organization is always added). */
  jsonLd?: Record<string, unknown>[];
}

const {
  title = "Diagnóstico y Referencia Analítica | DYRA",
  description = "Laboratorio clínico confiable, humano y tecnológico. Ofrecemos análisis clínicos, salud empresarial y tomas a domicilio.",
  keywords = "laboratorio clínico, análisis de sangre, salud empresarial, diagnóstico médico, DYRA",
  lang = SITE_LANG,
  image = DEFAULT_OG_IMAGE,
  imageAlt = image === DEFAULT_OG_IMAGE ? DEFAULT_OG_IMAGE_ALT : title,
  type = "website",
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd = [],
} = Astro.props;

// Built from SITE_URL, never Astro.url: behind the production proxy
// Astro.url is http://localhost, which leaked into og:url / og:image.
const canonicalURL = absoluteUrl(Astro.url.pathname);
const absoluteImageUrl = absoluteUrl(image);

const structuredData = [
  organizationJsonLd(logo.src),
  websiteJsonLd(),
  ...jsonLd,
];

const GA_MEASUREMENT_ID = "AW-17974653170";

const servicesRoutes = await getServicesNavRoutes();
const renderedBranchId = resolveBranchId() ?? "";
---

<!doctype html>
<html lang={lang} class="scroll-smooth" data-branch-id={renderedBranchId}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow"}
    />
    <meta name="generator" content={Astro.generator} />

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
    ></script>

    <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", GA_MEASUREMENT_ID);
    </script>

    <!-- Favicons -->
    <link rel="icon" type="image/png" href={logo.src} />
    <link rel="apple-touch-icon" href={logo.src} />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {
      image === DEFAULT_OG_IMAGE && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={SITE_LOCALE} />
    {
      type === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      type === "article" && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Sitemap -->
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Structured data -->
    {
      structuredData.map((data) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(data).replace(/</g, "\\u003c")}
        />
      ))
    }

    <!-- A page restored from the back/forward cache may have been rendered
         for a branch the user has since switched away from: refetch it. -->
    <script is:inline>
      window.addEventListener("pageshow", function (event) {
        var stored = null;
        try {
          stored = localStorage.getItem("dyra_branch_id");
        } catch (e) {}
        var rendered = document.documentElement.dataset.branchId;
        if (event.persisted && stored && rendered && stored !== rendered) {
          window.location.reload();
        }
      });
    </script>

    <!-- Prevent CLS for critical components -->
    <style is:inline>
      /* Critical styles to prevent layout shift */
      header {
        min-height: 80px;
      }
    </style>
  </head>
  <body
    class="min-h-screen bg-ui-bg font-sans text-green-light antialiased flex flex-col"
  >
    <Header />

    <main
      id="main-content"
      class="grow w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 space-y-28 focus:outline-none"
      tabindex="-1"
    >
      <slot />
    </main>
    <ToastContainer client:only="react" />
    <FloatingActions client:load />

    <ModalManager client:load />
    <DrawerManager client:load services={servicesRoutes} />

    <BranchSelectorManager client:load />
    <Footer />
  </body>
</html>
