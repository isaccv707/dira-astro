---
import "../styles/global.css";
import Footer from "../sections/astro/Footer.astro";
import Header from "../sections/astro/Header.astro";
import FloatingIconWhatsapp from "../components/react/ui/FloatingIconWhatsapp";
import GlobalWrapper from "../components/react/wrappers/GlobalWrapper";

interface LayoutProps {
	title: string;
	description: string;
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body class="min-h-screen bg-gray-100">
		<Header />
		<slot />
		<Footer />
		<FloatingIconWhatsapp client:load />
	</body>
</html>
