---
import Button from "../../react/buttons/Button";

interface Props {
  routes: { label: string; href: string }[];
  text: string;
}

const { routes, text } = Astro.props;
---

<div class="relative inline-block text-left group">
  <Button client:load text={text} variant="primary" size="sm" />

  <div
    class="absolute left-0 mt-2 w-44 bg-white divide-y divide-ui-border rounded-clinical-sm shadow-sm opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200"
  >
    <ul class="py-2 text-sm text-green-primary">
      {
        routes.map((opt, index) => (
          <li>
            <a
              href={opt.href}
              class="block px-4 py-2 text-green-light hover:bg-green-primary hover:text-white"
            >
              {opt.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
