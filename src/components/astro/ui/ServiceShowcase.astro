---
interface Props {
  name: string;
  showcaseImage: string;
}

const { name, showcaseImage } = Astro.props;

const corners = [
  "top-4 left-4 border-t-2 border-l-2 rounded-tl-lg",
  "top-4 right-4 border-t-2 border-r-2 rounded-tr-lg",
  "bottom-4 left-4 border-b-2 border-l-2 rounded-bl-lg",
  "bottom-4 right-4 border-b-2 border-r-2 rounded-br-lg",
];
---

<div
  class="lg:col-span-5 xl:col-span-4 group relative overflow-hidden rounded-4xl bg-black-custom border border-green-primary/25 shadow-lg shadow-black-custom/20 transition-all duration-500 hover:shadow-2xl hover:shadow-green-primary/20"
>
  <div class="relative aspect-4/5 sm:aspect-3/4 w-full overflow-hidden">
    <img
      src={showcaseImage}
      alt={`Panel de referencia del servicio ${name}`}
      class="h-full w-full object-cover grayscale-15 transition-transform duration-700 group-hover:scale-105"
      loading="lazy"
      decoding="async"
    />

    {/* Duotone + legibility gradient over the photo */}
    <div
      class="absolute inset-0 bg-linear-to-b from-black-custom/70 via-black-custom/10 to-black-custom/90 mix-blend-multiply"
    >
    </div>
    <div
      class="absolute inset-0 bg-linear-to-t from-black-custom via-black-custom/10 to-transparent"
    >
    </div>

    {/* Viewfinder corner brackets, sharpen slightly on hover like a lens focusing */}
    {
      corners.map((position) => (
        <span
          aria-hidden="true"
          class={`pointer-events-none absolute h-6 w-6 border-green-secondary/70 transition-all duration-500 group-hover:h-7 group-hover:w-7 group-hover:border-green-secondary ${position}`}
        />
      ))
    }

    {/* Scanning beam sweep */}
    <div
      aria-hidden="true"
      class="motion-safe:animate-scan-line pointer-events-none absolute inset-x-0 h-14 bg-linear-to-b from-transparent via-green-secondary/50 to-transparent mix-blend-screen"
    >
    </div>

    {/* Manufacturer-style chip */}
    <span
      class="absolute top-6 left-1/2 -translate-x-1/2 inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/10 px-3 py-1 font-mono text-[10px] tracking-[0.2em] text-white/70 uppercase backdrop-blur-sm"
    >
      DYRA · Lab
    </span>

    {/* Readout overlay */}
    <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8 text-white space-y-2">
      <div
        class="inline-flex items-center gap-2 font-mono text-[10px] font-bold tracking-[0.25em] text-green-secondary uppercase"
      >
        <span class="relative flex h-1.5 w-1.5">
          <span
            class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-green-secondary opacity-75"
          ></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-green-secondary"
          ></span>
        </span>
        Ficha de servicio
      </div>
      <h3 class="text-xl sm:text-2xl font-black tracking-tight">
        {name}
      </h3>
      <p class="text-sm text-white/70 leading-relaxed">
        Atención profesional, confiable y segura en todo momento.
      </p>
    </div>
  </div>
</div>
