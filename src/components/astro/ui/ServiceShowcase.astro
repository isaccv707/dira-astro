---
interface Props {
  name: string;
  showcaseImage: string;
}

const { name, showcaseImage } = Astro.props;
---

<div
  class="lg:col-span-5 xl:col-span-4 group relative overflow-hidden rounded-[2.5rem] bg-linear-to-b from-gray-150 to-gray-50 border border-gray-200/50 shadow-lg transition-all duration-500 hover:shadow-2xl"
>
  <div class="relative aspect-3/4 w-full overflow-hidden">
    <img
      src={showcaseImage}
      alt={`Showcase de ${name}`}
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
      loading="lazy"
      decoding="async"
    />
    {/* Subtle gradient overlay to make image feel premium */}
    <div
      class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent"
    >
    </div>

    {/* Text inside the visual showcase */}
    <div class="absolute bottom-0 left-0 right-0 p-8 text-white space-y-3">
      <span
        class="inline-block px-3 py-1 bg-yellow-primary text-gray-900 text-[10px] font-black uppercase tracking-widest rounded-md"
      >
        DYRA Laboratorios
      </span>
      <h3 class="text-xl sm:text-2xl font-black tracking-tight">
        {name}
      </h3>
      <p class="text-sm text-white/80 leading-relaxed">
        Atención profesional, confiable y segura en todo momento.
      </p>
    </div>
  </div>
</div>
