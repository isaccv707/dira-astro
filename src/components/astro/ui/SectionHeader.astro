---
import { sectionLeadStyles, sectionTitleStyles } from "../../../styles/ui";

interface Props {
  title: string;
  lead?: string;
  /** id for aria-labelledby on the parent <section>. */
  id?: string;
  as?: "h1" | "h2" | "h3";
  /** Brand mark above the title; turn off when an Eyebrow already sits there. */
  mark?: boolean;
  class?: string;
}

const {
  title,
  lead,
  id,
  as: Heading = "h2",
  mark = true,
  class: className,
} = Astro.props;
const hasAside = Astro.slots.has("aside");
---

<div
  class:list={[
    hasAside && "flex flex-wrap items-end justify-between gap-3",
    className,
  ]}
>
  <div>
    {
      mark && (
        <span aria-hidden="true" class="mb-3 flex h-1.5 w-14 overflow-hidden rounded-full">
          <span class="flex-[2] bg-green-primary" />
          <span class="flex-1 bg-green-secondary" />
          <span class="flex-1 bg-yellow-primary" />
        </span>
      )
    }
    <Heading id={id} class={sectionTitleStyles}>{title}</Heading>
    {lead && <p class={sectionLeadStyles}>{lead}</p>}
  </div>
  {hasAside && <slot name="aside" />}
</div>
