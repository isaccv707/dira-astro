---
interface Props {
  title: string;
  paragraph: string;
}

const { title, paragraph } = Astro.props as Props;
---

<div
  class="relative overflow-hidden rounded-3xl bg-white ring-1 ring-black/5 p-6 sm:p-8 shadow-lg"
>
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-r from-green-primary/5 via-white to-yellow-primary/10"
  >
  </div>

  <div
    class="pointer-events-none absolute -top-24 -right-24 h-64 w-64 rounded-full bg-yellow-primary/15 blur-3xl"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-green-secondary/15 blur-3xl"
  >
  </div>

  <div
    class="relative flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="min-w-0">
      <div
        class="inline-flex items-center gap-2 rounded-full bg-green-primary/10 px-3 py-1 text-xs font-extrabold text-green-primary ring-1 ring-green-primary/20"
      >
        <span class="h-2 w-2 rounded-full bg-green-primary"></span>
        Asesoría sin costo
      </div>

      <p
        class="mt-3 text-lg sm:text-xl font-extrabold tracking-tight text-green-light"
      >
        {title}
      </p>

      <p class="mt-1 text-sm sm:text-base text-grey max-w-xl">
        {paragraph}
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 sm:items-center">
      <a
        href="/contact"
        class="group inline-flex items-center justify-center rounded-2xl px-6 py-3 text-sm font-extrabold text-white
               bg-green-primary hover:bg-green-secondary shadow-md hover:shadow-lg
               transition active:scale-[0.98]"
      >
        Contáctanos
        <span
          class="ml-2 inline-block transition-transform group-hover:translate-x-0.5"
          >→</span
        >
      </a>
    </div>
  </div>

  <div
    class="relative mt-6 h-px w-full bg-gradient-to-r from-transparent via-green-secondary/30 to-transparent"
  >
  </div>

  <p class="relative mt-3 text-xs text-grey">
    Respuesta rápida por WhatsApp o correo. También podemos recomendarte
    paquetes según tu objetivo.
  </p>
</div>
