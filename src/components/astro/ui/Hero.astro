---
import NavLinkButton from "../../react/ui/NavLinkButton";

interface Props {
  img?: ImageMetadata;
  textHeader: string;
  title: string;
  paragraph: string;
}
const { img, paragraph, textHeader, title } = Astro.props;
---

<div class="p-5 sm:p-7 lg:p-10">
  <div class="flex flex-col gap-6 md:flex-row md:items-center md:gap-6">
    {
      img && (
        <div class="mx-auto md:mx-0 shrink-0">
          <img
            src={img?.src}
            alt="DYRA"
            class="h-24 w-24 sm:h-28 sm:w-28 md:h-32 md:w-32 lg:h-36 lg:w-36 rounded-2xl object-contain p-2 "
            loading="eager"
            width={144}
            height={144}
          />
        </div>
      )
    }

    <div class="min-w-0 text-center md:text-left">
      <div class="flex justify-center md:justify-start">
        <div class="inline-flex items-center gap-2 rounded-full bg-green-primary/10 px-3 py-1 text-xs font-semibold text-green-primary">
          <span class="h-2 w-2 rounded-full bg-green-primary"></span>
          <span class="truncate">{textHeader}</span>
        </div>
      </div>

      <h1 class="mt-3 text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-yellow-secondary">
        {title}
      </h1>

      <p class="mt-2 text-sm sm:text-base lg:text-lg text-grey">
        {paragraph}
      </p>

      <div class="mt-4 flex justify-center md:justify-start">
        <NavLinkButton
          path={"/about"}
          text={"Conocénos"}
          variant={"secondary"}
          size={"sm"}
          width={"auto"}
        />
      </div>
    </div>
  </div>
</div>
