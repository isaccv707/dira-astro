---
import NavLinkButton from "../../react/ui/NavLinkButton";

interface Props {
    img?: ImageMetadata;
    textHeader: string;
    title: string;
    paragraph: string;
}
const { img, paragraph, textHeader, title } = Astro.props;
---

<div class="p-7 lg:p-10">
    <div class="flex items-center gap-4">
        {
            img && (
                <div class="shrink-0">
                    <img
                        src={img?.src}
                        alt="DYRA"
                        class="h-12 w-12 lg:h-36 lg:w-36 rounded-2xl object-contain p-2"
                        loading="lazy"
                    />
                </div>
            )
        }

        <div class="min-w-0">
            <div
                class="inline-flex items-center gap-2 rounded-full bg-green-primary/10 px-3 py-1 text-xs font-semibold text-green-primary"
            >
                <span class="h-2 w-2 rounded-full bg-green-primary"></span>
                {textHeader}
            </div>

            <h1
                class="mt-3 text-2xl lg:text-3xl font-bold tracking-tight text-yellow-secondary"
            >
                {title}
            </h1>

            <p class="mt-2 text-base lg:text-lg text-grey">
                {paragraph}
            </p>

            <div class="mt-4">
                <NavLinkButton
                    path={"/about"}
                    text={"Conocénos"}
                    variant={"secondary"}
                    size={"sm"}
                    width={"auto"}
                />
            </div>
        </div>
    </div>
</div>
