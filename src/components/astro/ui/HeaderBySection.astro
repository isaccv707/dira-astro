---
import NavLinkButton from "../../react/ui/NavLinkButton";

interface Props {
    textHeader: string;
    title: string;
    paragraph?: string;
    textColor?: string;
    img?: ImageMetadata;
    btn?: boolean;
}

const {
    paragraph,
    textHeader,
    title,
    textColor = "black",
    img,
    btn = false,
} = Astro.props;
---

<div class="flex items-center gap-4">
    {
        img && (
            <div class="shrink-0">
                <img
                    src={img?.src}
                    alt="DYRA"
                    class="h-12 w-12 lg:h-36 lg:w-36 rounded-2xl object-contain p-2"
                    loading="lazy"
                />
            </div>
        )
    }
    <div class="min-w-0">
        <div
            class="inline-flex items-center gap-2 rounded-full bg-green-primary/10 px-3 py-1 text-xs font-semibold text-green-primary"
        >
            <span class="h-2 w-2 rounded-full bg-green-primary"></span>
            {textHeader}
        </div>

        <h1
            class={`mt-3 text-2xl lg:text-3xl font-bold tracking-tight text-${textColor}`}
        >
            {title}
        </h1>

        <p class="mt-2 text-base lg:text-sm text-grey">
            {paragraph}
        </p>
        {
            btn && (
                <div class="mt-4">
                    <NavLinkButton
                        path="about"
                        text="Conócenos"
                        variant={"primary"}
                        align={"left"}
                    />
                </div>
            )
        }
    </div>
</div>
