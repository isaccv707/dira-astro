---
import NavLinkButton from "../../react/navigation/NavLinkButton";

interface BtnProperties {
  text: string;
  path?: string;
}

interface Props {
  textHeader: string;
  title: string;
  paragraph?: string;
  textColor?: keyof typeof TITLE_COLORS;
  img?: ImageMetadata;
  btn?: boolean;
  btnProperties?: BtnProperties;
}

// Explicit map, not a dynamic `text-${textColor}` template string — Tailwind's
// content scanner can only see literal class names, so an interpolated one
// only works by accident (if that exact string happens to appear elsewhere).
const TITLE_COLORS = {
  black: "text-green-light",
  "green-light": "text-green-light",
  "green-primary": "text-green-primary",
  "yellow-secondary": "text-yellow-secondary",
} as const;

const {
  paragraph,
  textHeader,
  title,
  textColor = "black",
  img,
  btn = false,
  btnProperties = { text: "Contáctanos", path: "/contact" },
} = Astro.props;
---

<div
  class="flex items-center gap-4 motion-safe:animate-fade-up"
  style="animation-fill-mode:backwards;"
>
  {
    img && (
      <div class="shrink-0">
        <img
          src={img?.src}
          alt="DYRA"
          class="h-24 w-24 sm:h-28 sm:w-28 md:h-32 md:w-32 lg:h-36 lg:w-36 rounded-clinical-md object-contain p-2"
          loading="eager"
          width={144}
          height={144}
        />
      </div>
    )
  }
  <div class="min-w-0">
    <div
      class="inline-flex items-center gap-2 rounded-full border border-green-primary/15 bg-green-primary/8 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-green-primary"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-green-primary"></span>
      {textHeader}
    </div>

    <h1
      class={`mt-3 text-2xl font-black tracking-tight lg:text-3xl ${TITLE_COLORS[textColor] ?? TITLE_COLORS.black}`}
    >
      {title}
    </h1>

    <p
      class="mt-2 max-w-xl text-base leading-relaxed text-grey-custom lg:text-sm"
    >
      {paragraph}
    </p>
    {
      btn && (
        <div class="mt-4">
          <NavLinkButton
            path={btnProperties.path ?? "/contact"}
            text={btnProperties.text}
            variant={"primary"}
            align={"left"}
          />
        </div>
      )
    }
  </div>
</div>
