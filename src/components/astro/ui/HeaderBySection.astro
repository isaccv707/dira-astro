---
import Button from "../../react/buttons/Button";
import NavLinkButton from "../../react/navigation/NavLinkButton";

interface BtnProperties {
  text: string;
}

interface navLinkBtnProperties {
  path: string;
  text: string;
}

interface Props {
  textHeader: string;
  title: string;
  paragraph?: string;
  textColor?: string;
  img?: ImageMetadata;
  navLinkBtn?: boolean;
  navLinkBtnProperties?: navLinkBtnProperties;
  btn?: boolean;
  btnProperties?: BtnProperties | undefined;
}

const {
  paragraph,
  textHeader,
  title,
  textColor = "black",
  img,
  navLinkBtn = false,
  navLinkBtnProperties = { path: "/contact", text: "Contáctanos" },
  btn = false,
  btnProperties = { text: "Contáctanos" },
} = Astro.props;
---

<div class="flex items-center gap-4">
  {
    img && (
      <div class="shrink-0">
        <img
          src={img?.src}
          alt="DYRA"
          class="h-24 w-24 sm:h-28 sm:w-28 md:h-32 md:w-32 lg:h-36 lg:w-36 rounded-2xl object-contain p-2 "
          loading="eager"
          width={144}
          height={144}
        />
      </div>
    )
  }
  <div class="min-w-0">
    <div
      class="inline-flex items-center gap-2 rounded-full bg-green-primary/10 px-3 py-1 text-xs font-semibold text-green-primary"
    >
      <span class="h-2 w-2 rounded-full bg-green-primary"></span>
      {textHeader}
    </div>

    <h1
      class={`mt-3 text-2xl lg:text-3xl font-bold tracking-tight text-${textColor}`}
    >
      {title}
    </h1>

    <p class="mt-2 text-base lg:text-sm text-grey">
      {paragraph}
    </p>
    {
      navLinkBtn && (
        <div class="mt-4">
          <NavLinkButton
            path={navLinkBtnProperties.path}
            text={navLinkBtnProperties.text}
            variant={"primary"}
            align={"left"}
          />
        </div>
      )
    }
    {
      btn && (
        <div class="mt-4">
          <Button text={`${btnProperties.text}`} />
        </div>
      )
    }
  </div>
</div>
