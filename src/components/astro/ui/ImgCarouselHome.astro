---
import {
  getCloudinarySrcSet,
  getCloudinaryUrl,
} from "../../../utils/cloudinary";

interface Props {
  imageUrl: string;
  mobileImageUrl: string;
  isLCP: boolean;
  index: number;
}

const { imageUrl, isLCP, index, mobileImageUrl } = Astro.props;

// Mobile (4:5 → 800×1000)
const mobileSrcset = getCloudinarySrcSet(mobileImageUrl, [400, 600, 800], {
  w: 4,
  h: 5,
});
const mobileFallback = getCloudinaryUrl(mobileImageUrl, {
  width: 800,
  height: 1000,
});

// Desktop (2:1 → 2000×1000)
const desktopSrcset = getCloudinarySrcSet(imageUrl, [800, 1200, 1600, 2000], {
  w: 2,
  h: 1,
});
const desktopFallback = getCloudinaryUrl(imageUrl, {
  width: 2000,
  height: 1000,
});
---

<div class="relative w-full h-full">
  <!-- Mobile portrait 4:5 — oculto en ≥md -->
  <img
    src={mobileFallback}
    srcset={mobileSrcset || undefined}
    sizes="100vw"
    alt={`Banner DYRA ${index + 1}`}
    class="block md:hidden w-full aspect-4/5 object-cover rounded-2xl"
    loading={isLCP ? "eager" : "lazy"}
    fetchpriority={isLCP ? "high" : "auto"}
    decoding={isLCP ? "sync" : "async"}
    width="800"
    height="1000"
  />
  <!-- Desktop landscape 2:1 — oculto en <md -->
  <img
    src={desktopFallback}
    srcset={desktopSrcset || undefined}
    sizes="50vw"
    alt={`Banner DYRA ${index + 1}`}
    class="hidden md:block w-full aspect-2/1 object-cover rounded-2xl"
    loading={isLCP ? "eager" : "lazy"}
    fetchpriority={isLCP ? "high" : "auto"}
    decoding={isLCP ? "sync" : "async"}
    width="2000"
    height="1000"
  />
</div>
