---

<figure class="max-w-3xl animate-pulse">
  <div class="flex items-center space-x-1 mb-4">
    {
      [...Array(5)].map((_, i) => (
        <div class="w-5 h-5 bg-ui-border rounded-full" />
      ))
    }
  </div>

  <div class="space-y-3">
    <div class="h-6 bg-ui-border rounded-md w-full"></div>
    <div class="h-6 bg-ui-border rounded-md w-3/4"></div>
  </div>

  <figcaption class="flex items-center mt-6 space-x-3">
    <div class="w-8 h-8 rounded-full bg-ui-border"></div>
    <div class="flex items-center divide-x divide-ui-border">
      <div class="h-4 bg-ui-border rounded w-24 pe-3"></div>
      <div class="h-4 bg-ui-border rounded w-16 ps-3"></div>
    </div>
  </figcaption>
</figure>
