---

<figure class="max-w-screen-md animate-pulse">
  <div class="flex items-center space-x-1 mb-4">
    {
      [...Array(5)].map((_, i) => (
        <div class="w-5 h-5 bg-gray-200 rounded-full" />
      ))
    }
  </div>

  <div class="space-y-3">
    <div class="h-6 bg-gray-200 rounded-md w-full"></div>
    <div class="h-6 bg-gray-200 rounded-md w-3/4"></div>
  </div>

  <figcaption class="flex items-center mt-6 space-x-3">
    <div class="w-8 h-8 rounded-full bg-gray-200"></div>
    <div class="flex items-center divide-x divide-gray-200">
      <div class="h-4 bg-gray-200 rounded w-24 pe-3"></div>
      <div class="h-4 bg-gray-200 rounded w-16 ps-3"></div>
    </div>
  </figcaption>
</figure>
