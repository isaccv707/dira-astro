---
import type { PanelNode } from "../../../interfaces/study.interface";

interface Props {
  nodes: PanelNode[];
  depth?: number;
}

// Server-rendered panel tree. Order comes from the API; children show their
// name only (no code or price) — the profile is sold as a whole.
const { nodes, depth = 0 } = Astro.props;

// Long flat lists (e.g. 19 HPV genotypes) read better in two columns.
const isFlatList = nodes.length > 8 && nodes.every((node) => !node.isPanel);
---

<ul
  class:list={[
    depth > 0 && "mt-2 border-l-2 border-green-primary/15 pl-4",
    isFlatList && "sm:columns-2 sm:gap-x-10",
  ]}
>
  {
    nodes.map((node) =>
      node.isPanel ? (
        <li class="break-inside-avoid border-b border-ui-border py-3 last:border-b-0">
          <p class="text-sm font-bold tracking-tight text-ink">
            {node.title ?? node.name}
          </p>
          {node.children.length > 0 ? (
            <Astro.self nodes={node.children} depth={depth + 1} />
          ) : (
            <p class="mt-1 text-xs text-ink-subtle">
              Sin estudios registrados
            </p>
          )}
        </li>
      ) : (
        <li class="break-inside-avoid border-b border-ui-border py-2.5 text-sm leading-snug text-ink-muted last:border-b-0">
          {node.title ?? node.name}
        </li>
      ),
    )
  }
</ul>
