---
import { Icon } from "astro-icon/components";
import { Buttonstyles } from "../../../styles/buttonsStyles";

interface Props {
  path: string;
  icon: string;
  accent: "green-primary" | "yellow-primary";
  text: string;
  description?: string;
}

const { text, path, icon, accent, description } = Astro.props;

// Explicit map, not an interpolated `bg-${accent}` string — Tailwind's
// content scanner needs literal class names to generate the utility.
// El anillo de foco se queda con el color por defecto de Buttonstyles
// (no se sobreescribe por acento) para no competir con el que ya trae
// la variante "tile".
const ACCENT = {
  "green-primary": {
    chip: "bg-green-primary/10 text-green-primary group-hover:bg-green-primary/20",
  },
  "yellow-primary": {
    chip: "bg-yellow-primary/10 text-yellow-secondary group-hover:bg-yellow-primary/20",
  },
} as const;

const { chip } = ACCENT[accent];
---

<a
  href={path}
  class:list={[
    Buttonstyles({ variant: "tile", size: "none", align: "left" }),
    "group w-full gap-4 p-5 md:w-80",
  ]}
>
  <div
    class:list={[
      "flex h-12 w-12 shrink-0 items-center justify-center rounded-xl text-2xl transition-colors duration-300",
      chip,
    ]}
  >
    {
      icon.startsWith("http") ? (
        <img src={icon} alt="" class="h-6 w-auto object-contain" />
      ) : (
        <Icon name={icon} class="h-6 w-6" />
      )
    }
  </div>

  <div class="min-w-0">
    <span class="block text-base font-bold text-green-light">{text}</span>
    {
      description && (
        <span class="mt-0.5 block text-xs text-grey-custom">{description}</span>
      )
    }
  </div>
</a>
