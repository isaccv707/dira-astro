---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="flex flex-wrap gap-2 mt-2">
  {
    tags.map((tag) => (
      <span class="rounded-clinical-sm border border-green-primary/15 bg-green-primary/8 px-2.5 py-1 text-2xs font-bold uppercase tracking-wide text-brand-ink">
        #{tag}
      </span>
    ))
  }
</div>
