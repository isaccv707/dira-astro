---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div>
  <div class="flex flex-wrap gap-1 mt-2">
    {
      tags.map((tag) => (
        <div class="bg-green-light rounded-full">
          <span class="px-3 py-1 rounded-full text-xs font-medium text-white">
            {tag}
          </span>
        </div>
      ))
    }
  </div>
</div>
