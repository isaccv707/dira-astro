---
import { Image } from "astro:assets";
import { getColorConfig } from "../../../utils/cardVariants-values";
import { Icon } from "astro-icon/components";

interface ListCompanyValues {
  title: string;
  text?: string;
}

interface Props {
  title: string;
  paragraph?: string;
  bgColor?: string;
  icon?: string;
  list?: ListCompanyValues[];
}

const { paragraph, title, bgColor = "green-primary", icon, list } = Astro.props;

const colorConfig = getColorConfig(bgColor);
---

<div
  class:list={[
    "group relative overflow-hidden rounded-clinical-lg p-8 transition-all duration-500 hover:-translate-y-2 shadow-sm",
    colorConfig.container,
    colorConfig.text,
  ]}
>
  <div class="relative flex flex-col gap-8">
    <div class="flex items-center gap-4">
      {
        icon && (
          <div
            class:list={[
              "flex h-14 w-14 shrink-0 items-center justify-center rounded-clinical-sm backdrop-blur-md border transition-transform duration-500 group-hover:scale-110",
              colorConfig.iconContainer,
            ]}
          >
            {icon.startsWith("http") ? (
              <img src={icon} alt={title} class="h-8 w-8 object-contain" />
            ) : (
              <Icon
                name={icon}
                class={"h-8 w-8 object-contain brightness-0 invert"}
              />
            )}
          </div>
        )
      }
      <h2
        class="text-xl font-black tracking-tight sm:text-2xl leading-tight"
      >
        {title}
      </h2>
    </div>

    {
      paragraph && (
        <div class="space-y-4">
          <p class="leading-relaxed opacity-90 text-balance text-sm sm:text-base">
            {paragraph}
          </p>
        </div>
      )
    }

    {
      list &&
        list.map(({ text, title }) => (
          <div class="">
            <p class="leading-relaxed opacity-90 text-balance text-sm sm:text-base">
              {title}
            </p>
            <p class="text-sm">{text}</p>
          </div>
        ))
    }
  </div>
</div>
