---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props;

const KNOWN_SETS = ["lucide:", "tabler:", "logos:", "simple-icons:"];
const isIconName = Boolean(icon && !icon.startsWith("http") && KNOWN_SETS.some((s) => icon.startsWith(s)));
const isIconImage = Boolean(icon?.startsWith("http"));
---

<div class="flex h-full gap-4 bg-white p-6">
  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-clinical-sm bg-green-primary/8 text-brand-ink">
    {
      isIconName ? (
        <Icon name={icon} aria-hidden="true" class="h-5 w-5" />
      ) : isIconImage ? (
        <img src={icon} alt="" class="h-5 w-5 object-contain" />
      ) : (
        <Icon name="lucide:check" aria-hidden="true" class="h-5 w-5" />
      )
    }
  </span>
  <div>
    <h3 class="text-base font-bold text-ink">{title}</h3>
    <p class="mt-1 text-sm leading-relaxed text-ink-muted">{description}</p>
  </div>
</div>
