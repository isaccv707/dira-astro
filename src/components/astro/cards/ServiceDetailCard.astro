---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description: string;
  image?: string | null;
  index: number;
}

const { title, description, image, index } = Astro.props;

// Dynamic Lucide icon helper based on detail content to guarantee visual excellence
const getDetailIcon = (titleStr: string, idx: number) => {
  const normalizedTitle = titleStr.toLowerCase();
  
  if (normalizedTitle.includes("frágil") || normalizedTitle.includes("fragil") || normalizedTitle.includes("niño") || normalizedTitle.includes("mayor") || normalizedTitle.includes("paciente") || normalizedTitle.includes("adulto")) {
    return "lucide:heart-handshake";
  }
  if (normalizedTitle.includes("tiempo") || normalizedTitle.includes("entrega") || normalizedTitle.includes("rápido") || normalizedTitle.includes("rapido") || normalizedTitle.includes("velocidad") || normalizedTitle.includes("urgente")) {
    return "lucide:clock";
  }
  if (normalizedTitle.includes("pago") || normalizedTitle.includes("tarjeta") || normalizedTitle.includes("efectivo") || normalizedTitle.includes("dinero") || normalizedTitle.includes("costo") || normalizedTitle.includes("precio")) {
    return "lucide:credit-card";
  }
  if (normalizedTitle.includes("cobertura") || normalizedTitle.includes("área") || normalizedTitle.includes("area") || normalizedTitle.includes("ciudad") || normalizedTitle.includes("metropolitana") || normalizedTitle.includes("amplia") || normalizedTitle.includes("zonas")) {
    return "lucide:map-pin";
  }
  if (normalizedTitle.includes("empresa") || normalizedTitle.includes("negocio") || normalizedTitle.includes("corporativo") || normalizedTitle.includes("empleado") || normalizedTitle.includes("colaborador") || normalizedTitle.includes("empresas")) {
    return "lucide:building-2";
  }
  if (normalizedTitle.includes("norma") || normalizedTitle.includes("ley") || normalizedTitle.includes("stps") || normalizedTitle.includes("oficial") || normalizedTitle.includes("regulación") || normalizedTitle.includes("validez")) {
    return "lucide:file-text";
  }
  if (normalizedTitle.includes("salud") || normalizedTitle.includes("médico") || normalizedTitle.includes("clinico") || normalizedTitle.includes("prevención") || normalizedTitle.includes("exámenes")) {
    return "lucide:user-check";
  }
  if (normalizedTitle.includes("seguridad") || normalizedTitle.includes("higiene") || normalizedTitle.includes("biológica") || normalizedTitle.includes("residuos") || normalizedTitle.includes("protocolos")) {
    return "lucide:shield-check";
  }

  const fallbackIcons = ["lucide:sparkles", "lucide:award", "lucide:activity", "lucide:check-circle-2"];
  return fallbackIcons[idx % fallbackIcons.length];
};

const detailIcon = getDetailIcon(title, index);
const hasDetailImage = image && image.trim() !== "";
---

<div
  class="group relative overflow-hidden rounded-3xl border border-white/30 bg-white/40 p-6 shadow-xs backdrop-blur-xl transition-all duration-300 hover:-translate-y-1.5 hover:bg-white/80 hover:shadow-xl hover:border-green-secondary/25"
>
  {/* Faint calibration grid, only visible on hover to keep the resting state quiet */}
  <div
    aria-hidden="true"
    class="absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100 bg-[radial-gradient(currentColor_1px,transparent_1px)] bg-size-[16px_16px] text-grey-custom/15"
  >
  </div>

  {/* Highlight gradient bar on hover, echoes the scan beam in the showcase panel */}
  <div class="absolute top-0 left-0 right-0 h-[3px] bg-linear-to-r from-green-primary to-green-secondary scale-x-0 origin-left transition-transform duration-500 group-hover:scale-x-100">
  </div>

  {/* Static calibration tick, quiet nod to the instrument-panel motif */}
  <span
    aria-hidden="true"
    class="absolute top-4 right-4 h-2.5 w-2.5 text-gray-300 group-hover:text-green-secondary/50 transition-colors duration-300"
  >
    <span class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-current"></span>
    <span class="absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-current"></span>
  </span>

  <div class="relative flex h-full flex-col justify-between gap-4">
    <div>
      {/* Image render if detail contains custom image, otherwise render themed icon */}
      {hasDetailImage ? (
        <div class="relative w-full h-32 rounded-2xl overflow-hidden mb-4 border border-gray-150/40">
          <img
            src={image}
            alt={title}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
        </div>
      ) : (
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-green-primary/10 text-green-primary transition-all duration-300 group-hover:scale-110 group-hover:bg-green-primary group-hover:text-white mb-2 shadow-xs">
          <Icon name={detailIcon} class="h-6 w-6" />
        </div>
      )}

      <h3 class="text-lg font-black tracking-tight text-gray-800 group-hover:text-green-primary transition-colors duration-200">
        {title}
      </h3>
      <p class="mt-2 text-sm leading-relaxed text-gray-600">
        {description}
      </p>
    </div>
  </div>
</div>
