---
import { getCloudinaryUrl, getCloudinarySrcSet } from "../../../utils/cloudinary";

interface Props {
  title: string;
  description: string;
  image?: string | null;
  imageMobile?: string | null;
}

const { title, description, image, imageMobile } = Astro.props;
const mobileSrc = imageMobile || image;
---

<article class="flex h-full flex-col overflow-hidden rounded-clinical-md border border-ui-border bg-white shadow-xs">
  {
    mobileSrc && (
      <picture>
        {image && (
          <source media="(min-width: 640px)" srcset={getCloudinarySrcSet(image, [640, 768, 1024])} />
        )}
        <img
          src={getCloudinaryUrl(mobileSrc, { width: 640, height: 480 })}
          alt=""
          class="aspect-4/3 h-auto w-full object-cover sm:aspect-video"
          loading="lazy"
          width={640}
          height={480}
        />
      </picture>
    )
  }
  <div class="flex grow flex-col gap-2 p-6">
    <h3 class="text-lg font-bold tracking-tight text-ink">{title}</h3>
    <p class="text-sm leading-relaxed text-ink-muted">{description}</p>
  </div>
</article>
