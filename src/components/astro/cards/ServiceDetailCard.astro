---
import {
  getCloudinaryUrl,
  getCloudinarySrcSet,
} from "../../../utils/cloudinary";

interface Props {
  title: string;
  description: string;
  image?: string | null;
  imageMobile?: string | null;
  index: number;
}

const { title, description, image, imageMobile, index } = Astro.props;

const mobileSrc = imageMobile || image;

const panelNumber = String(index + 1).padStart(2, "0");
---

<div
  class="group relative flex h-full flex-col overflow-hidden rounded-clinical-lg border border-ui-border bg-white shadow-xs transition-all duration-300 hover:-translate-y-1 hover:shadow-sm"
>
  <div
    class="relative aspect-4/3 w-full overflow-hidden bg-linear-to-br from-green-primary/8 to-green-secondary/10 sm:aspect-video"
  >
    {
      mobileSrc ? (
        <picture>
          {image && (
            <source
              media="(min-width: 640px)"
              srcset={getCloudinarySrcSet(image, [640, 768, 1024])}
            />
          )}
          <img
            src={getCloudinaryUrl(mobileSrc, { width: 640, height: 480 })}
            alt={title}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            width={640}
            height={480}
          />
        </picture>
      ) : (
        <div class="flex h-full w-full items-center justify-center">
          <span
            class="text-6xl font-black tracking-tighter text-green-primary/15 transition-colors duration-300 group-hover:text-green-primary/25"
          >
            {panelNumber}
          </span>
        </div>
      )
    }

    <div
      class="pointer-events-none absolute left-4 top-4 flex items-center gap-1.5 rounded-clinical-sm border border-green-primary/15 bg-white px-2.5 py-1 shadow-xs"
    >
      <span class="text-[10px] font-black uppercase tracking-widest text-green-primary">
        Panel {panelNumber}
      </span>
    </div>
  </div>

  <div class="flex grow flex-col gap-2 p-6">
    <h3 class="text-lg font-black tracking-tight text-green-light">
      {title}
    </h3>
    <p class="text-sm leading-relaxed text-grey-custom">
      {description}
    </p>
  </div>
</div>
