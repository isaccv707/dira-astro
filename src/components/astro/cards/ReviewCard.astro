---
import type { Review } from "../../../interfaces/review.interface";

interface Props {
  review: Review;
}

const { review } = Astro.props;

if (!review) return null;

const totalStars = 5;
const rating = Math.round(review.rating || 0);

const avatarFallback = `https://ui-avatars.com/api/?name=${encodeURIComponent(
  review.fullName,
)}&background=86AB27&color=fff&bold=true`;

const avatarUrl = review.avatarUrl || avatarFallback;
---

<figure
  class="flex flex-col h-full max-w-7xl shadow-xs p-8 rounded-clinical-lg border border-ui-border bg-white transition-all duration-300 hover:-translate-y-1 hover:shadow-sm"
>
  <div class="flex items-center space-x-1 mb-4 shrink-0">
    {
      [...Array(totalStars)].map((_, index) => (
        <svg
          class={`w-5 h-5 ${index < rating ? "text-yellow-primary" : "text-ui-border"}`}
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path d="M13.849 4.22c-.684-1.626-3.014-1.626-3.698 0L8.397 8.387l-4.552.361c-1.775.14-2.495 2.331-1.142 3.477l3.468 2.937-1.06 4.392c-.413 1.713 1.472 3.067 2.992 2.149L12 19.35l3.897 2.354c1.52.918 3.405-.436 2.992-2.15l-1.06-4.39 3.468-2.938c1.353-1.146.633-3.336-1.142-3.477l-4.552-.36-1.754-4.17Z" />
        </svg>
      ))
    }
  </div>

  <blockquote class="grow">
    <p
      class="text-xl font-semibold text-green-light tracking-tight line-clamp-4 italic"
    >
      "{review.comment}"
    </p>
  </blockquote>

  <figcaption
    class="flex items-center mt-6 space-x-3 shrink-0 pt-4 border-t border-ui-border"
  >
    <img
      class="w-10 h-10 rounded-full border border-ui-border object-cover"
      src={avatarUrl}
      alt={review.fullName}
    />
    <div class="flex items-center divide-x divide-ui-border">
      <cite class="pe-3 font-medium text-yellow-primary not-italic">
        {review.fullName}
      </cite>
      <cite class="ps-3 text-sm text-green-primary not-italic"> Paciente </cite>
    </div>
  </figcaption>
</figure>
