---
import type { Review } from "../../../interfaces/review.interface";

interface Props {
  review: Review;
}

const { review } = Astro.props;

if (!review) return null;

const TOTAL_STARS = 5;
const rating = Math.min(TOTAL_STARS, Math.max(0, Math.round(review.rating || 0)));

// Local initials instead of a third-party avatar service: the reviewer's
// name never leaves the site.
const initials = (review.fullName ?? "")
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase() ?? "")
  .join("");
---

<figure
  class="flex h-full flex-col rounded-clinical-md border border-ui-border bg-white p-6 shadow-xs"
>
  <div class="flex items-center gap-0.5" role="img" aria-label={`${rating} de ${TOTAL_STARS} estrellas`}>
    {
      [...Array(TOTAL_STARS)].map((_, index) => (
        <svg
          aria-hidden="true"
          class={`h-4 w-4 ${index < rating ? "text-yellow-mark" : "text-ui-border"}`}
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path d="M13.849 4.22c-.684-1.626-3.014-1.626-3.698 0L8.397 8.387l-4.552.361c-1.775.14-2.495 2.331-1.142 3.477l3.468 2.937-1.06 4.392c-.413 1.713 1.472 3.067 2.992 2.149L12 19.35l3.897 2.354c1.52.918 3.405-.436 2.992-2.15l-1.06-4.39 3.468-2.938c1.353-1.146.633-3.336-1.142-3.477l-4.552-.36-1.754-4.17Z" />
        </svg>
      ))
    }
  </div>

  <blockquote class="mt-4 grow">
    <p class="line-clamp-5 text-base leading-relaxed text-ink">“{review.comment}”</p>
  </blockquote>

  <figcaption class="mt-5 flex items-center gap-3 border-t border-ui-border pt-4">
    {
      review.avatarUrl ? (
        <img
          class="h-10 w-10 rounded-full border border-ui-border object-cover"
          src={review.avatarUrl}
          alt=""
          loading="lazy"
          width="40"
          height="40"
        />
      ) : (
        <span
          aria-hidden="true"
          class="flex h-10 w-10 items-center justify-center rounded-full bg-green-primary/8 text-sm font-semibold text-brand-ink"
        >
          {initials || "?"}
        </span>
      )
    }
    <span class="min-w-0">
      <cite class="block truncate text-sm font-semibold not-italic text-ink">{review.fullName}</cite>
      <span class="block text-xs text-ink-subtle">Paciente</span>
    </span>
  </figcaption>
</figure>
