---
import CarouselAbout from "../../react/carousel/CarouselAbout";
---

<div class="relative mx-auto w-full max-w-md">
    <div
        class="group relative rounded-3xl shadow-2xl bg-white p-4 shadow-green-prbg-green-primary/30 backdrop-blur"
    >
        <div class="flex items-center justify-between gap-4 pb-3">
            <div>
                <p
                    class="text-xs uppercase tracking-[0.2em] font-bold text-green-secondary"
                >
                    Laboratorio DYRA
                </p>
                <p class="text-xl font-bold text-green-primary">
                    Diagnóstico y Referencia Analítica
                </p>
            </div>
        </div>

        <div class="overflow-hidden rounded-2xl">
            <CarouselAbout client:load />
        </div>

        <div class="mt-4 grid gap-3 text-xs text-grey sm:text-sm">
            <div class="flex items-center justify-between gap-2">
                <span class="flex items-center gap-2">
                    <span
                        class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-green-primary/10 text-xs text-green-secondary"
                    >
                        ✔
                    </span>
                    Resultados con controles de calidad internos y externos
                </span>
            </div>
            <div class="flex items-center justify-between gap-2">
                <span class="flex items-center gap-2">
                    <span
                        class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-yellow-primary/10 text-xs text-yellow-primary"
                    >
                        ⏱
                    </span>
                    Procesos automatizados para tiempos de respuesta óptimos
                </span>
            </div>
            <div class="flex items-center justify-between gap-2">
                <span class="flex items-center gap-2">
                    <span
                        class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-green-primary/10 text-xs text-green-secondary"
                    >
                        🌐
                    </span>
                    Entrega digital y segura de resultados
                </span>
            </div>
        </div>
    </div>
</div>
