---
import CarouselAbout from "../../react/carousel/CarouselAbout";

interface Props {
  title: string;
  paragraph: string;
  images: any;
  items: {
    icon: string;
    text: string;
  }[];
}

const { title, paragraph, items, images } = Astro.props;
---

<div class="relative mx-auto w-full">
  <div
    class="group relative rounded-clinical-lg shadow-xl bg-white p-4 shadow-green-primary/10 backdrop-blur"
  >
    <div class="flex items-center justify-between gap-4 pb-3">
      <div>
        <p
          class="text-xs uppercase tracking-[0.2em] font-bold text-brand-ink"
        >
          {title}
        </p>
        <p class="text-xl font-bold text-brand-ink">
          {paragraph}
        </p>
      </div>
    </div>

    <div class="overflow-hidden rounded-clinical-md">
      <CarouselAbout client:load />
    </div>

    <div class="mt-10 grid gap-3 text-xs text-ink-muted sm:text-sm">
      {
        items.map(({ icon, text }) => (
          <div class="flex items-center justify-between gap-2">
            <span class="flex items-center gap-2">
              <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-green-primary/10 text-xs text-brand-ink">
                {icon}
              </span>
              {text}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</div>
