---
import NavLinkButton from '../../react/ui/NavLinkButton';


interface Props {
    icon: ImageMetadata;
    title: string;
    description: string;
    path: string;
    id: string;
    textButton?: string | undefined;
    category?: string | undefined;
    tags?: string[] | undefined;
}

const { icon, description, title, id, path, textButton = "", category = undefined } = Astro.props;
---

<div
    class="group max-w-sm w-full bg-white h-auto border border-gray-200 rounded-2xl shadow-md p-6 flex flex-col items-center text-center hover:shadow-2xl hover:-translate-y-1 transition-all duration-300"
    data-service-id={id}
    data-service-title={title}
    data-service-description={description}
    data-service-path={path}
    role="article"
    tabindex={0}
>
    <div
        class="w-16 h-16 flex items-center justify-center rounded-full mb-4 bg-gradient-to-tr from-green-ligth to-greenSecondary p-2"
    >
        <img src={icon.src} alt="icon-dyra" class="w-10 h-auto filter invert/10 transition-transform duration-300 group-hover:scale-110" />
    </div>

    <h5 class="mb-1 text-lg font-bold tracking-tight text-green-primary" data-service-title>
        {title}
    </h5>

    {category ? (
        <span class="text-xs px-2 py-1 rounded-full bg-green-primary/10 text-green-primary mb-3">{category}</span>
    ) : null}

    <p class="mb-6 text-sm text-green-secondary leading-relaxed" data-service-description>
        {description}
    </p>

    <div class="mt-6 w-full flex gap-3 items-center justify-center">
        <button
            type="button"
            class="px-4 py-2 rounded-lg bg-white border border-gray-200 text-sm text-green-primary hover:bg-green-primary hover:text-white transition"
            data-quickview
            aria-controls="service-modal"
            aria-expanded="false"
        >
            Vista rápida
        </button>

        <div class="ml-0">
            <NavLinkButton
                path={`${path}/${id}`}
                variant="primary"
                size="md"
                text={textButton}
            />
        </div>
    </div>
</div>
