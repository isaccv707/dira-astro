---
import NavLinkButton from '../../react/ui/NavLinkButton';


interface Props {
    icon: ImageMetadata;
    title: string;
    description: string;
    path: string;
    id: string;
    textButton?: string | undefined;
}

const { icon, description, title, id, path, textButton = "" } = Astro.props;
---

<div
    class="max-w-sm w-full bg-white h-auto border border-gray-200 rounded-2xl shadow-md p-6 flex flex-col items-center text-center hover:shadow-2xl hover:-translate-y-1 transition-all duration-300"
>
    <div
        class="w-16 h-16 flex items-center justify-center rounded-full bg-green-ligth mb-4"
    >
        <img src={icon.src} alt="icon-dyra" class="w-10 h-auto invert" />
    </div>

    <h5 class="mb-2 text-lg font-bold tracking-tight text-green-primary">
        {title}
    </h5>

    <p class="mb-6 text-sm text-green-secondary leading-relaxed">
        {description}
    </p>

    <div class="mt-auto">
        <NavLinkButton
            path={`${path}/${id}`}
            variant="primary"
            size="md"
            text={textButton}
        />
    </div>
</div>
