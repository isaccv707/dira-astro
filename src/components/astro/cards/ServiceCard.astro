---
import { Icon } from "astro-icon/components";
import type { Service } from "../../../interfaces/service.interface";
import NavLinkButton from "../../react/navigation/NavLinkButton";
import { Buttonstyles } from "../../../styles/buttonsStyles";

interface Props {
  service: Service;
}

const { service } = Astro.props;
const { description, id, slug, name, benefits, icon } = service;

const KNOWN_SETS = ["lucide:", "tabler:", "logos:", "simple-icons:"];
const isAstroIcon = icon && !icon.startsWith("http") && KNOWN_SETS.some((s) => icon.startsWith(s));
const isImgIcon = icon && icon.startsWith("http");
---

<div
  class="group service-card w-full h-full border border-ui-border rounded-clinical-md shadow-xs p-6 flex flex-col items-center text-center transition-all duration-300 hover:-translate-y-1 hover:shadow-sm bg-white"
  data-payload={JSON.stringify(service)}
>
  <div
    class="w-16 h-16 shrink-0 flex items-center justify-center rounded-full mb-4 bg-linear-to-tr from-green-light to-green-secondary/50 p-2 transition-transform duration-300 group-hover:scale-105"
  >
    {
      isAstroIcon ? (
        <Icon name={icon} class="text-white w-6 h-auto" />
      ) : (
        isImgIcon && <img src={icon} alt={name} class="w-6 h-6 object-contain" />
      )
    }
  </div>

  <h5
    class="mb-1 line-clamp-2 text-lg font-black tracking-tight text-green-light"
    data-service-title
  >
    {name}
  </h5>

  <p
    class="mb-6 grow line-clamp-3 text-sm text-grey-custom leading-relaxed"
    data-service-description
  >
    {description}
  </p>

  <div class="mt-auto w-full flex gap-3 items-center justify-center">
    <button
      class:list={[
        "btn-quick-view cursor-pointer",
        Buttonstyles({ variant: "outline", size: "sm" }),
      ]}
    >
      Vista rápida
    </button>

    <NavLinkButton
      path={`service/${slug}`}
      variant={"primary"}
      size="sm"
      text={"Más información"}
    />
  </div>
</div>

<script>
  import { openModal } from "../../../stores/modalStore";

  document.addEventListener("click", (event) => {
    const btn = (event.target as HTMLElement).closest(".btn-quick-view");
    if (!btn) return;

    const card = btn.closest(".service-card");
    const rawData = card?.getAttribute("data-payload");

    if (rawData) {
      const serviceData = JSON.parse(rawData);

      openModal("MODAL_SERVICE", {
        title: serviceData.name,
        data: serviceData,
      });
    }
  });
</script>
