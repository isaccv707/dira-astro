---
import { Icon } from "astro-icon/components";
import type { Service } from "../../../interfaces/service.interface";
import NavLinkButton from "../../react/navigation/NavLinkButton";

interface Props {
  service: Service;
}

const { service } = Astro.props;
const { description, id, slug, name, benefits, icon } = service;
---

<div
  class="group service-card max-w-sm w-full bg-white h-auto border border-gray-200 rounded-2xl shadow-md p-6 flex flex-col items-center text-center hover:shadow-2xl hover:-translate-y-1 transition-all duration-300"
  data-payload={JSON.stringify(service)}
>
  <div
    class="w-16 h-16 flex items-center justify-center rounded-full mb-4 bg-linear-to-tr from-green-light to-green-secondary/50 p-2"
  >
    <Icon name={icon} class={"text-white w-6 h-auto"} />
  </div>

  <h5
    class="mb-1 text-lg font-bold tracking-tight text-green-primary"
    data-service-title
  >
    {name}
  </h5>

  <p
    class="mb-6 text-sm text-green-secondary leading-relaxed"
    data-service-description
  >
    {description}
  </p>

  <div class="mt-6 w-full flex gap-3 items-center justify-center">
    <button
      class="btn-quick-view flex items-center justify-center text-sm font-semibold rounded-xl border border-gray-300 text-green-primary bg-white hover:bg-gray-50 transition-all duration-300 px-4 py-2 cursor-pointer"
    >
      Vista rápida
    </button>

    <NavLinkButton
      path={`service/${slug}`}
      variant={"primary"}
      size="sm"
      text={"Más información"}
    />
  </div>
</div>

<script>
  import { openModal } from "../../../stores/modalStore";

  document.addEventListener("click", (event) => {
    const btn = (event.target as HTMLElement).closest(".btn-quick-view");
    if (!btn) return;

    const card = btn.closest(".service-card");
    const rawData = card?.getAttribute("data-payload");

    if (rawData) {
      const serviceData = JSON.parse(rawData);

      // Enviamos la información exacta al Nano Store global
      openModal("MODAL_SERVICE", {
        title: serviceData.name,
        data: serviceData,
      });
    }
  });
</script>
