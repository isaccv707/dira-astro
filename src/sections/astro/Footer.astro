---
import { routesFooter } from "../../routes/routes";
import dyraLogo from "../../assets/images/logo.png";
import { Phone } from "lucide-react";
import NavLinkButton from "../../components/react/ui/NavLinkButton";
import { SOCIAL_NETWORKS } from "../../constants/socialNetworks";
---

<footer class="bg-green-primary text-white pt-10">
  <div
    class="max-w-7xl mx-auto px-4 sm:px-8 grid grid-cols-1 md:grid-cols-3 gap-10"
  >
    <div>
      <img src={dyraLogo.src} alt="logo" class="w-28 h-auto mb-4" />
      <p class="text-sm leading-6">
        En DYRA, ofrecemos servicios de calidad con un enfoque profesional para
        garantizar la mejor experiencia a nuestros clientes.
      </p>
    </div>

    <div class="flex flex-col justify-start">
      <h4 class="text-white font-semibold">Enlaces</h4>
      <ul class="">
        {
          routesFooter.map(({ path, text }, index) => (
            <li>
              <NavLinkButton
                path={path}
                text={text}
                variant={"footer"}
                size={"sm"}
                align={"left"}
                width={"full"}
              />
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h4 class="text-white font-semibold mb-4">Contáctanos</h4>
      <p class="text-sm mb-2 flex items-center gap-2">
        <Phone size={16} /> +52 3332559229
      </p>

      <div class="flex mt-4">
        {
          SOCIAL_NETWORKS.map(({ href, icon }, index) => (
            <a
              href={href}
              class="p-2 rounded-full w-12 h-auto"
              aria-label="Facebook"
            >
              <img src={icon.src} alt="icon-facebook" />
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="mt-10 border-t border-gray-700 text-center py-4 text-sm">
    © {new Date().getFullYear()} Dyra. Todos los derechos reservados.
  </div>
</footer>
