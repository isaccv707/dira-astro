---
import { Icon } from "astro-icon/components";
import Eyebrow from "../../../components/astro/ui/Eyebrow.astro";
import { brandFill } from "../../../styles/ui";

const heroAccent = "text-green-primary"; // ui-guard-ok: 36px+ heading, 4.0:1 ≥ 3:1 large-text AA
import StudySearch from "../../../components/react/search/StudySearch";
import CarouselHome from "../home/CarouselHome.astro";
import fallbackBanner from "../../../assets/images/home/carousel/2A.jpg";
import {
  getActiveBranchContact,
  getActiveBranchResultsUrl,
} from "../../../api/branchesApi/branchesApi";
import { buildWhatsappUrl } from "../../../utils/whatsapp";
import { urlWhatsapp } from "../../../constants/urlWhatsapp";

const contact = await getActiveBranchContact();
const resultsUrl = (await getActiveBranchResultsUrl()) ?? "/branches";
const whatsappUrl = contact?.phone
  ? buildWhatsappUrl(contact.phone)
  : urlWhatsapp;

// The three things patients come to do besides finding a study.
const actions = [
  {
    href: "/quoter",
    icon: "lucide:file-text",
    label: "Cotizar estudios",
    detail: "Total con IVA y PDF",
    external: false,
  },
  {
    href: whatsappUrl,
    icon: "tabler:brand-whatsapp",
    label: "Agendar por WhatsApp",
    detail: "Escribe a tu sucursal",
    external: true,
  },
  {
    href: resultsUrl,
    icon: "lucide:test-tube-diagonal",
    label: "Consultar resultados",
    detail: "En línea",
    external: resultsUrl.startsWith("http"),
  },
].filter((action) => Boolean(action.href));
---

<section aria-labelledby="hero-title" class="relative">
  <!-- Lab grid: hero-only motif, fades out so it never competes with content -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 -top-8 bottom-0 [mask-image:linear-gradient(to_bottom,black,transparent)]"
    style="background-image: linear-gradient(rgba(34,143,4,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(34,143,4,0.05) 1px, transparent 1px); background-size: 48px 48px;"
  >
  </div>

  <div class="relative grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-6">
      <h1
        id="hero-title"
        class="mt-4 text-4xl font-bold leading-[1.08] tracking-tight text-ink sm:text-5xl"
      >
        Tu salud, analizada con
        <span class={heroAccent}>precisión.</span>
      </h1>

      <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-muted">
        Busca entre los estudios de tu sucursal, revisa recomendaciones y cotiza
        en línea. Resultados confiables para ti, tu médico y tu empresa.
      </p>

      <div class="mt-8 max-w-xl">
        <p class="mb-2 text-sm font-semibold text-ink">
          ¿Qué estudio necesitas?
        </p>
        <StudySearch
          client:idle
          variant="inline"
          size="lg"
          placeholder="Nombre o código del estudio"
        />
        <p class="mt-2 text-sm text-ink-subtle">
          O explora el <a
            href="/estudios"
            class="font-semibold text-brand-ink underline-offset-4 hover:underline"
            >catálogo completo</a
          >.
        </p>
      </div>

      <ul class="mt-8 grid gap-3 sm:grid-cols-3">
        {
          actions.map((action, index) => (
            <li>
              <a
                href={action.href}
                target={action.external ? "_blank" : undefined}
                rel={action.external ? "noopener noreferrer" : undefined}
                class="group flex h-full items-center gap-3 rounded-clinical-md border border-ui-border bg-white p-4 shadow-xs transition-[border-color,box-shadow] duration-200 hover:border-brand-ink/30 hover:shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-primary focus-visible:ring-offset-2"
              >
                <span
                  class:list={[
                    "flex h-10 w-10 shrink-0 items-center justify-center rounded-clinical-sm",
                    brandFill(index),
                  ]}
                >
                  <Icon name={action.icon} aria-hidden="true" class="h-5 w-5" />
                </span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-ink group-hover:text-brand-ink">
                    {action.label}
                  </span>
                  <span class="block text-xs text-ink-muted">
                    {action.detail}
                    {action.external && (
                      <span class="sr-only"> (se abre en otra pestaña)</span>
                    )}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="lg:col-span-6">
      <!-- Brand-colored mat around the banner -->
      <div class="rounded-clinical-lg bg-green-primary p-2 shadow-sm sm:p-3">
        <div class="overflow-hidden rounded-clinical-md bg-white">
          <CarouselHome>
            <img
              slot="fallback"
              src={fallbackBanner.src}
              alt="Tu salud en manos de expertos. Más de 500 análisis clínicos."
              width={fallbackBanner.width}
              height={fallbackBanner.height}
              class="h-auto w-full"
              loading="eager"
              fetchpriority="high"
            />
          </CarouselHome>
        </div>
      </div>
    </div>
  </div>
</section>
