---
import Eyebrow from "../../../components/astro/ui/Eyebrow.astro";
import PillarGrid from "../../../components/astro/ui/PillarGrid.astro";
import { benefitsCompany } from "../../../data/about/aboutIdentity";
export const prerender = true;
---

<section>
  <Eyebrow>Conócenos</Eyebrow>

  <h1
    class="text-yellow-ink text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl"
  >
    Un laboratorio clínico
    <span
      class="block bg-linear-to-r from-green-primary via-green-secondary to-yellow-primary bg-clip-text text-transparent"
    >
      confiable, humano y tecnológico.
    </span>
  </h1>

  <p class="max-w-xl text-pretty text-sm text-ink-muted sm:text-base">
    En <span class="font-semibold text-brand-ink"
      >Diagnóstico y Referencia Analítica (DYRA)</span
    >
    {" "}unimos experiencia médica, tecnología de punta y procesos
    estandarizados para ofrecer resultados precisos, oportunos y fáciles de
    interpretar para pacientes, médicos y empresas.
  </p>

  <div class="mt-4 grid gap-4 sm:grid-cols-3">
    {
      benefitsCompany.map(({ title, description }) => (
        <PillarGrid title={title} description={description} />
      ))
    }
  </div>
</section>
