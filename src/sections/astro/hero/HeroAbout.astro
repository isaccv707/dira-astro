---
import Eyebrow from "../../../components/astro/ui/Eyebrow.astro";
import { benefitsCompany } from "../../../data/about/aboutIdentity";
---

<header class="grid gap-10 lg:grid-cols-12 lg:items-start">
  <div class="lg:col-span-7">
    <Eyebrow>Quiénes somos</Eyebrow>
    <h1 class="mt-4 text-3xl font-bold leading-tight tracking-tight text-ink sm:text-4xl lg:text-5xl">
      Un laboratorio clínico confiable, humano y tecnológico.
    </h1>
    <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-muted sm:text-lg">
      En Diagnóstico y Referencia Analítica (DYRA) unimos experiencia médica,
      tecnología de punta y procesos estandarizados para ofrecer resultados
      precisos, oportunos y fáciles de interpretar para pacientes, médicos y
      empresas.
    </p>
  </div>

  <ul class="divide-y divide-ui-border rounded-clinical-md border border-ui-border bg-white lg:col-span-5">
    {
      benefitsCompany.map(({ title, description }) => (
        <li class="p-5">
          <h2 class="text-base font-bold text-ink">{title}</h2>
          <p class="mt-1 text-sm leading-relaxed text-ink-muted">{description}</p>
        </li>
      ))
    }
  </ul>
</header>
