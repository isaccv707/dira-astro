---
import type { Benefits } from "../../../interfaces/service.interface";
import BenefitCardService from "../../../components/astro/cards/BenefitCardService.astro";

interface Props {
  benefits: Benefits[];
}

const { benefits } = Astro.props;
if (!benefits || benefits.length === 0) return;
---

<section class="space-y-8">
  <div
    class="motion-safe:animate-fade-up"
    style="animation-fill-mode:backwards;"
  >
    <div
      class="inline-flex items-center gap-2 rounded-full border border-green-primary/15 bg-green-primary/8 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-green-primary"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-green-primary"></span>
      Beneficios
    </div>
    <h2
      class="mt-3 text-2xl font-black tracking-tight text-green-light sm:text-3xl"
    >
      Por qué elegir este servicio
    </h2>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      benefits.map(({ id, title, description, icon }) => (
        <BenefitCardService
          title={title}
          description={description}
          icon={icon}
        />
      ))
    }
  </div>
</section>
