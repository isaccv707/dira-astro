---
import Eyebrow from "../../../components/astro/ui/Eyebrow.astro";
import type { Benefits } from "../../../interfaces/service.interface";
import BenefitCardService from "../../../components/astro/cards/BenefitCardService.astro";

interface Props {
  benefits: Benefits[];
}

const { benefits } = Astro.props;
if (!benefits || benefits.length === 0) return;
---

<section class="space-y-8">
  <div
    class="motion-safe:animate-fade-up"
    style="animation-fill-mode:backwards;"
  >
    <Eyebrow>Beneficios</Eyebrow>
    <h2
      class="mt-3 text-2xl font-bold tracking-tight text-ink sm:text-3xl"
    >
      Por qué elegir este servicio
    </h2>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      benefits.map(({ id, title, description, icon }) => (
        <BenefitCardService
          title={title}
          description={description}
          icon={icon}
        />
      ))
    }
  </div>
</section>
