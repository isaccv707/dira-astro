---
import SectionHeader from "../../../components/astro/ui/SectionHeader.astro";
import type { Benefits } from "../../../interfaces/service.interface";
import BenefitCardService from "../../../components/astro/cards/BenefitCardService.astro";

interface Props {
  benefits: Benefits[];
}

const { benefits } = Astro.props;
if (!benefits || benefits.length === 0) return;
---

<section aria-labelledby="benefits-title" class="space-y-8">
  <SectionHeader id="benefits-title" title="Por qué elegir este servicio" />
  <ul class="grid gap-px overflow-hidden rounded-clinical-md border border-ui-border bg-ui-border sm:grid-cols-2 lg:grid-cols-3">
    {
      benefits.map(({ title, description, icon }) => (
        <li>
          <BenefitCardService title={title} description={description} icon={icon} />
        </li>
      ))
    }
  </ul>
</section>
