---
import type { Service } from "../../../interfaces/service.interface";
import { Icon } from "astro-icon/components";
import { urlWhatsapp } from "../../../constants/urlWhatsapp";

// Import specialized components
import ServiceDetailCard from "../../../components/astro/cards/ServiceDetailCard.astro";
import ServiceShowcase from "../../../components/astro/ui/ServiceShowcase.astro";
import ServiceCTA from "../../../components/astro/CTA/ServiceCTA.astro";

interface Props {
  service?: Service;
}

const { service } = Astro.props;

if (!service) return null;

const {
  name,
  slug,
  description,
  imageUrl,
  mobileImageUrl,
  details = [],
} = service;

const isHomeShots = slug === "tomas-a-domicilio";
const defaultCtaText = isHomeShots
  ? "Agendar toma de muestras a domicilio"
  : "Contactar a un consultor de salud";

const whatsappText = isHomeShots
  ? `Hola, me interesa agendar una toma de muestras a domicilio de ${name}.`
  : `Hola, me interesa solicitar una cotización o informes sobre el servicio de ${name}.`;
const encodedWhatsappText = encodeURIComponent(whatsappText);
const ctaLink = urlWhatsapp
  ? `${urlWhatsapp}?text=${encodedWhatsappText}`
  : `/contact`;

const showcaseImage = mobileImageUrl || imageUrl;
---

<div class="w-full space-y-20">
  {/* TITLE SECTION */}
  <div class="max-w-3xl">
    <div
      class="inline-flex items-center gap-2 rounded-full bg-green-primary/10 px-4 py-1.5 text-xs font-bold text-green-primary uppercase tracking-wider"
    >
      <span class="h-2 w-2 rounded-full bg-green-primary animate-pulse"></span>
      Detalles del Servicio
    </div>
    <h2
      class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-gray-900 leading-[1.15]"
    >
      Conoce todos los detalles sobre <br class="hidden sm:inline" />
      <span
        class="bg-gradient-to-r from-green-primary to-green-secondary bg-clip-text text-transparent"
        >{name}</span
      >
    </h2>
    {
      description && (
        <p class="mt-4 text-base sm:text-lg text-gray-600 leading-relaxed">
          {description}
        </p>
      )
    }
  </div>

  {/* MAIN GRID BLOCK */}
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    {/* Showcase Banner */}
    {
      showcaseImage && (
        <ServiceShowcase name={name} showcaseImage={showcaseImage} />
      )
    }

    {/* Details Grid */}
    <div
      class={`${showcaseImage ? "lg:col-span-7 xl:col-span-8" : "lg:col-span-12"} grid grid-cols-1 sm:grid-cols-2 gap-6`}
    >
      {
        details.length > 0 ? (
          details.map((detail, index) => (
            <ServiceDetailCard
              title={detail.title}
              description={detail.description}
              image={detail.image}
              index={index}
            />
          ))
        ) : (
          <div class="col-span-full py-16 flex flex-col items-center justify-center text-center bg-white/30 backdrop-blur-md rounded-3xl border-2 border-dashed border-gray-200">
            <div class="p-4 bg-green-primary/10 text-green-primary rounded-full mb-4">
              <Icon name="lucide:sparkles" class="w-8 h-8" />
            </div>
            <h3 class="text-lg font-bold text-gray-800">Servicio Disponible</h3>
            <p class="text-sm text-gray-500 mt-2 max-w-xs leading-relaxed">
              Consúltanos para conocer todos los detalles personalizados para
              este servicio.
            </p>
          </div>
        )
      }
    </div>
  </div>

  {/* CTA BANNER */}
  <ServiceCTA ctaLink={ctaLink} defaultCtaText={defaultCtaText} />
</div>
