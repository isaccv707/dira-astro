---
import { getAllService } from "../../../api/servicesApi/serviceApi";
import ServiceLinkCard from "../../../components/astro/cards/ServiceLinkCard.astro";
import SectionHeader from "../../../components/astro/ui/SectionHeader.astro";
import type { Service } from "../../../interfaces/service.interface";

let services: Service[] = [];
try {
  services = await getAllService();
} catch (error) {
  console.error("[OurServices] Error fetching services:", error);
}
---

{
  services.length > 0 && (
    <section aria-labelledby="services-title" class="space-y-8">
      <SectionHeader
        id="services-title"
        title="Servicios"
        lead="Cada servicio tiene su catálogo de estudios con precios de tu sucursal."
      />
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service, index) => (
          <li>
            <ServiceLinkCard service={service} index={index} />
          </li>
        ))}
      </ul>
    </section>
  )
}
