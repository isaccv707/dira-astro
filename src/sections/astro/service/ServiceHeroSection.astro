---
import HeaderBySection from "../../../components/astro/ui/HeaderBySection.astro";
import logo from "../../../assets/images/logo.png";
import type { Service } from "../../../interfaces/service.interface";

interface Props {
  service: Service<any>;
}

const { service } = Astro.props;
const { products = [], title, description, img } = service;
---

<section class="w-full">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 lg:py-16">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div class="order-1">
        <div class="rounded-3xl">
          <HeaderBySection
            img={logo}
            textHeader={"Servicio"}
            title={title}
            paragraph={description}
            textColor={"yellow-secondary"}
            btn={true}
            btnProperties={{ text: `Ver ${title}` }}
          />
        </div>
      </div>

      <div class="order-2 lg:order-2">
        <div
          class="relative overflow-hidden rounded-3xl shadow-xl ring-1 ring-black/5 bg-gradient-to-b from-green-primary/10 to-yellow-primary/10"
        >
          <div class="aspect-[16/7] sm:aspect-[16/7] lg:aspect-[16/7]">
            <img
              src={img?.image167?.src}
              alt={title}
              class="h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
