---
import Eyebrow from "../../../components/astro/ui/Eyebrow.astro";
import type { Service } from "../../../interfaces/service.interface";
import { getAllService } from "../../../api/servicesApi/serviceApi";
import ServiceCard from "../../../components/astro/cards/ServiceCard.astro";

interface Props {
  currentServiceId?: string;
}

const { currentServiceId } = Astro.props;

const RECOMMENDED_COUNT = 3;

let recommendedServices: Service[] = [];
try {
  const allServices = await getAllService();
  recommendedServices = allServices
    .filter((service) => service.id !== currentServiceId)
    .slice(0, RECOMMENDED_COUNT);
} catch (error) {
  console.error("[ServiceRecommended] Error fetching services:", error);
}
---

{
  recommendedServices.length > 0 && (
    <section class="space-y-8">
      <div
        class="motion-safe:animate-fade-up"
        style="animation-fill-mode:backwards;"
      >
        <Eyebrow>Sigue explorando</Eyebrow>
        <h2 class="mt-3 text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          Otros servicios que podrían interesarte
        </h2>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-muted sm:text-base">
          Conoce el resto de nuestra oferta clínica.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {recommendedServices.map((service, index) => (
          <div
            class="motion-safe:animate-fade-up"
            style={`animation-delay:${(index % 3) * 100}ms`}
          >
            <ServiceCard service={service} />
          </div>
        ))}
      </div>
    </section>
  )
}
