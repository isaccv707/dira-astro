---
import SectionHeader from "../../../components/astro/ui/SectionHeader.astro";
import ServiceLinkCard from "../../../components/astro/cards/ServiceLinkCard.astro";
import type { Service } from "../../../interfaces/service.interface";
import { getAllService } from "../../../api/servicesApi/serviceApi";

interface Props {
  currentServiceId?: string;
}

const { currentServiceId } = Astro.props;

const RECOMMENDED_COUNT = 3;

let recommendedServices: Service[] = [];
try {
  const allServices = await getAllService();
  recommendedServices = allServices
    .filter((service) => service.id !== currentServiceId)
    .slice(0, RECOMMENDED_COUNT);
} catch (error) {
  console.error("[ServiceRecommended] Error fetching services:", error);
}
---

{
  recommendedServices.length > 0 && (
    <section aria-labelledby="other-services-title" class="space-y-8">
      <SectionHeader id="other-services-title" title="Otros servicios" />
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {recommendedServices.map((service, index) => (
          <li>
            <ServiceLinkCard service={service} index={index} />
          </li>
        ))}
      </ul>
    </section>
  )
}
