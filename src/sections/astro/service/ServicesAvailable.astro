---
import type { Service } from "../../../interfaces/service.interface";
import { Icon } from "astro-icon/components";

import ServiceDetailCard from "../../../components/astro/cards/ServiceDetailCard.astro";
import ServiceShowcase from "../../../components/astro/ui/ServiceShowcase.astro";

interface Props {
  service?: Service;
}

const { service } = Astro.props;

if (!service) return null;

const {
  name,
  slug,
  description,
  imageUrl,
  mobileImageUrl,
  details = [],
} = service;

const showcaseImage = mobileImageUrl || imageUrl;
---

<div class="w-full space-y-16 sm:space-y-20">
  <div class="relative max-w-3xl">
    {/* Faint blueprint grid behind the header, a quiet echo of the lab's technical side */}
    <div
      aria-hidden="true"
      class="absolute -top-6 -left-6 -z-10 h-40 w-40 bg-[radial-gradient(var(--color-green-primary)_1px,transparent_1px)] bg-size-[14px_14px] opacity-10 sm:h-56 sm:w-56"
    >
    </div>

    <div
      class="inline-flex items-center gap-2 rounded-full bg-green-primary/10 px-4 py-1.5 font-mono text-[11px] font-bold text-green-primary uppercase tracking-[0.2em]"
    >
      <span class="relative flex h-2 w-2">
        <span
          class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-green-primary opacity-75"
        ></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-green-primary"
        ></span>
      </span>
      // Detalles del servicio
    </div>
    <h2
      class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-gray-900 leading-[1.15]"
    >
      Conoce todos los detalles sobre <br class="hidden sm:inline" />
      <span
        class="bg-linear-to-r from-green-primary to-green-secondary bg-clip-text text-transparent"
        >{name}</span
      >
    </h2>
    {
      description && (
        <p class="mt-4 text-base sm:text-lg text-gray-600 leading-relaxed">
          {description}
        </p>
      )
    }
  </div>

  {/* MAIN GRID BLOCK */}
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    {/* Showcase Banner */}
    {
      showcaseImage && (
        <ServiceShowcase name={name} showcaseImage={showcaseImage} />
      )
    }

    {/* Details Grid */}
    <div
      class={`${showcaseImage ? "lg:col-span-7 xl:col-span-8" : "lg:col-span-12"} grid grid-cols-1 sm:grid-cols-2 gap-6`}
    >
      {
        details.length > 0 ? (
          details.map((detail, index) => (
            <ServiceDetailCard
              title={detail.title}
              description={detail.description}
              image={detail.image}
              index={index}
            />
          ))
        ) : (
          <div class="relative col-span-full overflow-hidden py-16 flex flex-col items-center justify-center text-center bg-white/30 backdrop-blur-md rounded-3xl border-2 border-dashed border-gray-200">
            <span
              aria-hidden="true"
              class="absolute top-4 left-5 font-mono text-[10px] tracking-[0.2em] text-gray-300 uppercase"
            >
              Sin datos cargados
            </span>
            <div class="p-4 bg-green-primary/10 text-green-primary rounded-full mb-4">
              <Icon name="lucide:sparkles" class="w-8 h-8" />
            </div>
            <h3 class="text-lg font-bold text-gray-800">Servicio disponible</h3>
            <p class="text-sm text-gray-500 mt-2 max-w-xs leading-relaxed">
              Consúltanos para conocer todos los detalles personalizados para
              este servicio.
            </p>
          </div>
        )
      }
    </div>
  </div>
</div>
