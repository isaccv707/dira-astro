---
import SectionHeader from "../../../components/astro/ui/SectionHeader.astro";
import type { Details } from "../../../interfaces/service.interface";
import ServiceDetailCard from "../../../components/astro/cards/ServiceDetailCard.astro";

interface Props {
  details: Details[];
}

const { details } = Astro.props;
if (!details || details.length === 0) return;
---

<section aria-labelledby="details-title" class="space-y-8">
  <SectionHeader
    id="details-title"
    title="Qué incluye este servicio"
    lead="Las áreas y procesos que cubrimos dentro de este servicio."
  />
  <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      details.map((detail) => (
        <li>
          <ServiceDetailCard
            title={detail.title}
            description={detail.description}
            image={detail.image}
            imageMobile={detail.imageMobile}
          />
        </li>
      ))
    }
  </ul>
</section>
