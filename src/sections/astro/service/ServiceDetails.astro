---
import Eyebrow from "../../../components/astro/ui/Eyebrow.astro";
import type { Details } from "../../../interfaces/service.interface";
import ServiceDetailCard from "../../../components/astro/cards/ServiceDetailCard.astro";

interface Props {
  details: Details[];
}

const { details } = Astro.props;
if (!details || details.length === 0) return;
---

<section class="space-y-8">
  <div
    class="motion-safe:animate-fade-up"
    style="animation-fill-mode:backwards;"
  >
    <Eyebrow>Detalles</Eyebrow>
    <h2
      class="mt-3 text-2xl font-bold tracking-tight text-ink sm:text-3xl"
    >
      Qué incluye este servicio
    </h2>
    <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-muted sm:text-base">
      Un vistazo a las áreas y procesos que cubrimos dentro de este servicio.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      details.map((detail, index) => (
        <div
          class="motion-safe:animate-fade-up"
          style={`animation-delay:${(index % 4) * 100}ms`}
        >
          <ServiceDetailCard
            title={detail.title}
            description={detail.description}
            image={detail.image}
            imageMobile={detail.imageMobile}
            index={index}
          />
        </div>
      ))
    }
  </div>
</section>
