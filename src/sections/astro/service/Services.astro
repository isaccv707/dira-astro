---
import SectionHeader from "../../../components/astro/ui/SectionHeader.astro";
import Eyebrow from "../../../components/astro/ui/Eyebrow.astro";
import type { ServiceDetail } from "../../../interfaces/service.interface";
import StudyCatalog from "../../../components/react/study/StudyCatalog";
import type { CatalogQuery } from "../../../utils/catalogQuery";

interface Props {
  service: ServiceDetail;
  catalogQuery: CatalogQuery;
  pageSize: number;
}

const { service, catalogQuery, pageSize } = Astro.props;
const { priceSheet, studies, slug, branchId } = service;
const initialStudies = studies?.data ?? [];

// With a search or filter active an empty page just means "no matches":
// keep the catalog (and its controls) visible instead of the notice.
const isFiltered = Boolean(catalogQuery.search) || catalogQuery.studyType !== "all";
const hasStudies = initialStudies.length > 0 || isFiltered || catalogQuery.page > 1;
---

<section id="servicio-detalle" aria-labelledby="catalog-title" class="scroll-mt-24">
  {
    priceSheet && hasStudies ? (
      <div class="space-y-6">
        <div>
          <Eyebrow>Catálogo de estudios</Eyebrow>
          <SectionHeader
            id="catalog-title"
            class="mt-3"
            title={priceSheet.name}
            lead={priceSheet.description || `Estudios de ${service.name} disponibles y sus precios.`}
          />
        </div>

        <StudyCatalog
          client:visible
          source={{ type: "service", slug }}
          branchId={branchId}
          basePath={`/service/${slug}`}
          pageSize={pageSize}
          initialQuery={catalogQuery}
          initialStudies={initialStudies}
          initialTotal={studies?.total ?? initialStudies.length}
          initialTotalPages={studies?.totalPages ?? 1}
          scopeLabel={`en ${service.name}`}
        />
      </div>
    ) : (
      <div class="rounded-clinical-md border border-ui-border bg-white p-8 text-center shadow-xs">
        <h2 id="catalog-title" class="text-lg font-bold tracking-tight text-ink">
          Sin estudios disponibles
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-muted">
          {service.name} aún no tiene estudios con precio en esta sucursal.
          Consulta en sucursal o busca en el{" "}
          <a href="/estudios" class="font-semibold text-brand-ink underline-offset-4 hover:underline">
            catálogo completo
          </a>
          .
        </p>
      </div>
    )
  }
</section>
