---
import type { Service } from "../../../interfaces/service.interface";
import StudiesServices from "../../react/service/StudiesServices-section";
import ServicesAvailable from "./ServicesAvailable .astro";

interface Props {
  service: Service;
}

const { service } = Astro.props;
const { _count } = service;
---

<section>
{
  (_count?.studies ?? 0) > 0 ? (
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-green-light">
        {`Servicios de ${service.name} disponibles`}
      </h2>
      <p class="text-sm sm:text-base text-grey">
        Explora nuestro catálogo con una gran variedad de servicios y encuentra el
        ideal para ti.
      </p>
      <StudiesServices client:visible />
    ) : (
      <ServicesAvailable service={service} />
    )
  }
    </section>
