---
import type { ServiceDetail } from "../../../interfaces/service.interface";
import ServiceStudiesCatalog from "../../react/service/ServiceStudiesCatalog";
import type { StudyTypeFilter } from "../../../utils/studyTypeFilter";

interface Props {
  service: ServiceDetail;
  studyType?: StudyTypeFilter;
}

const { service, studyType = "all" } = Astro.props;
const { priceSheet, studies, slug, branchId } = service;
const initialStudies = studies?.data ?? [];

// With a filter active an empty page just means "none of that kind" — keep
// the catalog (and its filter) visible instead of the no-studies notice.
const hasStudies = initialStudies.length > 0 || studyType !== "all";
---

<section id="servicio-detalle" class="scroll-mt-24">
  {
    priceSheet && hasStudies ? (
      <div class="space-y-8">
        <div
          class="motion-safe:animate-fade-up"
          style="animation-fill-mode:backwards;"
        >
          <div class="inline-flex items-center gap-2 rounded-full border border-green-primary/15 bg-green-primary/8 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-green-primary">
            <span class="h-1.5 w-1.5 rounded-full bg-green-primary" />
            Catálogo de estudios
          </div>
          <h2 class="mt-3 text-2xl font-black tracking-tight text-green-light sm:text-3xl">
            {priceSheet.name}
          </h2>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-grey-custom sm:text-base">
            {priceSheet.description ||
              `Estudios de ${service.name} disponibles y sus precios.`}
          </p>
        </div>

        <ServiceStudiesCatalog
          slug={slug}
          branchId={branchId}
          initialStudies={initialStudies}
          initialPage={studies?.page ?? 1}
          initialTotalPages={studies?.totalPages ?? 1}
          initialTotal={studies?.total ?? initialStudies.length}
          initialStudyType={studyType}
          client:visible
        />
      </div>
    ) : (
      <div class="rounded-clinical-md border border-ui-border bg-white p-8 text-center shadow-xs motion-safe:animate-fade-up">
        <h3 class="text-lg font-black tracking-tight text-green-light">
          Sin estudios disponibles
        </h3>
        <p class="mt-2 text-sm text-grey-custom leading-relaxed">
          Este servicio aún no tiene estudios disponibles en esta sucursal.
          Consulta directamente en sucursal.
        </p>
      </div>
    )
  }
</section>
