---
import HeaderBySection from "../../../components/astro/ui/HeaderBySection.astro";
import logo from "../../../assets/images/logos/logo.png";
import type { Service } from "../../../interfaces/service.interface";

interface Props {
  name: string;
  description: string;
  imageUrl: string;
}

const { name, description, imageUrl } = Astro.props;
---

<section class="w-full">
  <div class="mx-auto max-w-7xl">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <HeaderBySection
        img={logo}
        textHeader={"Servicio"}
        title={name}
        paragraph={description}
        textColor={"yellow-secondary"}
        btn={true}
        btnProperties={{ text: `Ver ${name}` }}
      />

      <div
        class="relative overflow-hidden rounded-3xl shadow-xl ring-1 ring-black/5 bg-linear-to-b from-green-primary/10 to-yellow-primary/10"
      >
        <div class="aspect-16/7 sm:aspect-16/7 lg:aspect-16/7">
          <img
            src={imageUrl}
            alt={name}
            class="h-full w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>
