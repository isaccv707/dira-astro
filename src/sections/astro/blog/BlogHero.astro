---
import Eyebrow from "../../../components/astro/ui/Eyebrow.astro";

// The blog's first view is the article list itself: a short header is
// enough, the posts' own images do the visual work.
---

<header class="max-w-3xl">
  <Eyebrow>Blog</Eyebrow>
  <h1 class="mt-4 text-3xl font-bold tracking-tight text-ink sm:text-4xl">
    Salud y diagnóstico clínico
  </h1>
  <p class="mt-3 text-base leading-relaxed text-ink-muted">
    Consejos, noticias y artículos sobre salud y diagnóstico clínico.
  </p>
</header>
