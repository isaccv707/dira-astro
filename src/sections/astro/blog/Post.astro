---
import Eyebrow from "../../../components/astro/ui/Eyebrow.astro";
import SectionHeader from "../../../components/astro/ui/SectionHeader.astro";
import { Icon } from "astro-icon/components";
import type { Post, ContentBlock } from "../../../api/postsApi/post.interface";
import { fetchGetAllPosts } from "../../../api/postsApi/postApi";
import Tags from "../../../components/astro/Tags.astro";
import CTAContact from "../../../components/astro/CTA/CTAContact.astro";
import PostCard from "../../../components/react/cards/PostCard";
import { formattedDate } from "../../../utils/formattedDate";
import { getCloudinaryUrl, getCloudinarySrcSet } from "../../../utils/cloudinary";

interface Props {
  post: Post | undefined;
}

const { post } = Astro.props;
if (!post) return;

const date = formattedDate(post.createdAt);

const rawImage = post.image as unknown as string | ImageMetadata | undefined;
const heroImageSrc = typeof rawImage === "string" ? rawImage : rawImage?.src;
const rawMobileImage = post.imageMobile as unknown as string | ImageMetadata | undefined;
const heroImageMobileSrc =
  typeof rawMobileImage === "string" ? rawMobileImage : rawMobileImage?.src;

const contentBlocks = post.contentBlocks ?? [];

let relatedPosts: Post[] = [];
try {
  const { data } = await fetchGetAllPosts({ limit: 4 });
  relatedPosts = data.filter((p) => p.slug !== post.slug).slice(0, 3);
} catch (error) {
  console.error("[Post] Error fetching related posts:", error);
}
---

<article class="mx-auto w-full max-w-5xl">
  <a
    href="/blog"
    class="mb-8 inline-flex items-center gap-1.5 text-sm font-semibold text-ink-muted transition-colors hover:text-brand-ink"
  >
    <Icon name="tabler:arrow-left" aria-hidden="true" class="h-4 w-4" />
    Volver al blog
  </a>

  <header class="max-w-3xl">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      {post.category && <Eyebrow>{post.category}</Eyebrow>}
      <p class="flex items-center gap-2 text-sm text-ink-subtle">
        <Icon name="tabler:clock" aria-hidden="true" class="h-4 w-4" />
        <span>{post.readingTime} min de lectura</span>
        <span aria-hidden="true">·</span>
        <time datetime={String(post.createdAt)}>{date}</time>
      </p>
    </div>

    <h1 class="mt-5 text-3xl font-bold leading-tight tracking-tight text-ink sm:text-4xl lg:text-5xl">
      {post.title}
    </h1>

    {
      post.description && (
        <p class="mt-5 text-lg leading-relaxed text-ink-muted">{post.description}</p>
      )
    }

    <div class="mt-6 flex items-center gap-3">
      <img
        src={post.author.avatar || "/favicon.svg"}
        alt=""
        class="h-14 w-14 rounded-full border border-ui-border bg-ui-bg object-cover"
        loading="lazy"
        width="56"
        height="56"
      />
      <p class="text-sm">
        <span class="block font-semibold text-ink">{post.author.name}</span>
        <span class="block text-ink-subtle">Autor(a)</span>
      </p>
    </div>
  </header>

  {
    heroImageSrc && (
      <div class="mt-10 overflow-hidden rounded-clinical-lg border border-ui-border bg-white">
        <picture>
          <source
            media="(min-width: 768px)"
            srcset={getCloudinarySrcSet(heroImageSrc, [1024, 1280, 1600], { w: 16, h: 7 })}
          />
          <img
            src={getCloudinaryUrl(heroImageMobileSrc || heroImageSrc, { width: 1200, height: 900 })}
            alt=""
            class="aspect-4/3 h-auto w-full object-cover md:aspect-16/7"
            loading="eager"
            fetchpriority="high"
            width={1200}
            height={900}
          />
        </picture>
      </div>
    )
  }

  <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-12">
    <div class="max-w-prose lg:col-span-8">
      {
        contentBlocks.map((block: ContentBlock) => {
          switch (block.type) {
            case "PARAGRAPH":
              return <p class="mb-6 text-lg leading-relaxed text-ink-muted">{block.content}</p>;

            case "SUBTITLE":
              return (
                <h2 class="mb-4 mt-12 text-2xl font-bold tracking-tight text-ink">{block.content}</h2>
              );

            case "LIST": {
              const listItems =
                block.content
                  ?.split(/(?=\d+\.\s)/)
                  .map((item) => item.trim())
                  .filter((item) => item.length > 0) || [];
              return (
                <ul class="my-8 space-y-3">
                  {listItems.map((item) => (
                    <li class="flex items-start gap-3">
                      <Icon name="lucide:check" aria-hidden="true" class="mt-1 h-4 w-4 shrink-0 text-brand-ink" />
                      <span class="text-lg leading-relaxed text-ink-muted">{item}</span>
                    </li>
                  ))}
                </ul>
              );
            }

            case "QUOTE":
              return (
                <blockquote class="my-10 border-l-4 border-green-primary pl-6">
                  <p class="text-xl font-semibold leading-snug text-ink">{block.content}</p>
                </blockquote>
              );

            case "IMAGE":
              return (
                <figure class="my-10">
                  <img
                    src={block.src}
                    alt={block.alt || ""}
                    class="h-auto w-full rounded-clinical-lg border border-ui-border"
                    loading="lazy"
                  />
                  {block.alt && (
                    <figcaption class="mt-3 text-center text-sm text-ink-subtle">{block.alt}</figcaption>
                  )}
                </figure>
              );

            default:
              return null;
          }
        })
      }

      {
        post.tags?.length > 0 && (
          <div class="mt-12 flex flex-wrap items-center gap-3 border-t border-ui-border pt-6">
            <span class="text-sm font-semibold text-ink-muted">Etiquetas</span>
            <Tags tags={post.tags} />
          </div>
        )
      }
    </div>

    <aside class="h-fit space-y-6 lg:sticky lg:top-24 lg:col-span-4">
      <CTAContact variant="inline" />
      <p class="rounded-clinical-md border border-ui-border bg-white p-5 text-sm leading-relaxed text-ink-muted">
        La información de este artículo es de carácter informativo. Consulta
        siempre a tu médico para interpretar tus estudios.
      </p>
    </aside>
  </div>

  {
    relatedPosts.length > 0 && (
      <section aria-labelledby="related-title" class="mt-20 space-y-8 border-t border-ui-border pt-12">
        <SectionHeader id="related-title" title="Artículos relacionados" />
        <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relatedPosts.map((relatedPost) => (
            <li>
              <PostCard post={relatedPost} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</article>
