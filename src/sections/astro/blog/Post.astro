---
import type { Post, ContentBlock } from "../../../api/postsApi/post.interface";
import Tags from "../../../components/astro/Tags.astro";
import { formattedDate } from "../../../utils/formattedDate";

interface Props {
  post: Post | undefined;
}

const { post } = Astro.props;
if (!post) return;

const date = formattedDate(post.createdAt);
---

<article class="w-full max-w-5xl mx-auto py-12 animate-fade-up">
  <!-- Header Section -->
  <header class="mb-12">
    <div class="flex flex-wrap items-center gap-4 mb-6">
      <span
        class="px-4 py-1.5 bg-green-light/10 text-green-light text-xs font-bold uppercase tracking-wider rounded-full border border-green-light/20"
      >
        {post.category}
      </span>
      <div class="flex items-center gap-2 text-gray-400 text-sm">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>{post.readingTime} min de lectura</span>
        <span class="mx-1">•</span>
        <span>{formattedDate}</span>
      </div>
    </div>

    <h1
      class="text-4xl md:text-5xl lg:text-6xl font-black text-green-light leading-[1.1] mb-8"
    >
      {post.title}
    </h1>

    <p
      class="text-lg md:text-xl text-gray-600 leading-relaxed font-medium mb-10 border-l-4 border-yellow-secondary pl-6"
    >
      {post.description}
    </p>

    <!-- Author Profile -->
    <div
      class="flex items-center gap-4 p-4 bg-gray-50 rounded-2xl border border-gray-100 w-fit"
    >
      <div class="relative">
        <img
          src={post.author.avatar || "/favicon.svg"}
          alt={post.author.name}
          class="w-14 h-14 rounded-full object-cover border-2 border-white shadow-sm ring-1 ring-gray-200"
          loading="lazy"
        />
        <div
          class="absolute -bottom-0.5 -right-0.5 w-4 h-4 bg-green-secondary border-2 border-white rounded-full"
        >
        </div>
      </div>
      <div>
        <p class="text-sm font-bold text-gray-900 leading-tight">
          {post.author.name}
        </p>
        <p
          class="text-xs text-yellow-secondary font-medium uppercase tracking-tighter mt-0.5"
        >
          Especialista en Salud
        </p>
      </div>
    </div>
  </header>

  <!-- Hero Image -->
  {
    post.image && (
      <div class="relative aspect-21/9 w-full mb-16 overflow-hidden rounded-4xl shadow-2xl ring-1 ring-black/5">
        <img
          src={post.image.src}
          alt={post.title}
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-linear-to-t from-black/20 to-transparent" />
      </div>
    )
  }

  <!-- Content Body -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
    <main class="lg:col-span-8">
      <div
        class="prose prose-lg prose-gray max-w-none
                prose-headings:text-green-light prose-headings:font-black
                prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-8
                prose-p:text-gray-600 prose-p:leading-8 prose-p:mb-8
                prose-strong:text-gray-900
                prose-ul:my-8 prose-li:text-gray-600"
      >
        {
          post.contentBlocks?.map((block: ContentBlock) => {
            switch (block.type) {
              case "PARAGRAPH":
                return (
                  <p class="text-gray-600 leading-relaxed text-lg mb-8 first-letter:text-5xl first-letter:font-black first-letter:text-green-light first-letter:mr-3 first-letter:float-left">
                    {block.content}
                  </p>
                );

              case "SUBTITLE":
                return (
                  <div class="relative group mt-16 mb-8">
                    <h2 class="inline-block relative z-10 text-3xl font-black text-green-light m-0">
                      {block.content}
                    </h2>
                    <div class="absolute -bottom-2 left-0 w-24 h-2 bg-yellow-primary/30 group-hover:w-full transition-all duration-500 rounded-full z-0" />
                  </div>
                );

              case "LIST":
                const listItems =
                  block.content
                    ?.split(/(?=\d+\.\s)/)
                    .map((item) => item.trim())
                    .filter((item) => item.length > 0) || [];
                return (
                  <ul class="list-none space-y-6 my-10 pl-0">
                    {listItems.map((item) => (
                      <li class="flex items-start gap-4 p-4 bg-gray-50/50 rounded-2xl border border-transparent hover:border-green-light/10 hover:bg-white transition-all duration-300">
                        <div class="mt-1 shrink-0 w-6 h-6 rounded-lg bg-green-light/10 flex items-center justify-center">
                          <svg
                            class="w-4 h-4 text-green-light"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="3"
                              d="M5 13l4 4L19 7"
                            />
                          </svg>
                        </div>
                        <span class="text-gray-700 font-medium leading-relaxed">
                          {item}
                        </span>
                      </li>
                    ))}
                  </ul>
                );

              case "QUOTE":
                return (
                  <div class="relative my-14">
                    <div class="absolute -top-6 -left-4 text-8xl text-yellow-primary/20 font-serif select-none">
                      “
                    </div>
                    <blockquote class="not-prose relative z-10 px-8 py-4 border-l-4 border-yellow-secondary">
                      <p class="text-2xl md:text-3xl font-bold text-gray-800 italic leading-snug tracking-tight">
                        {block.content}
                      </p>
                    </blockquote>
                    <div class="absolute -bottom-6 -right-4 text-8xl text-yellow-primary/20 font-serif select-none rotate-180">
                      “
                    </div>
                  </div>
                );

              case "IMAGE":
                return (
                  <figure class="not-prose my-16 group">
                    <div class="relative overflow-hidden rounded-[2.5rem] shadow-2xl border border-gray-100">
                      <img
                        src={block.src}
                        alt={block.alt || ""}
                        class="w-full h-auto transform transition-transform duration-700 group-hover:scale-105"
                        loading="lazy"
                      />
                      <div class="absolute inset-0 ring-1 ring-inset ring-black/10 rounded-[2.5rem]" />
                    </div>
                    {block.alt && (
                      <figcaption class="mt-6 text-center">
                        <span class="inline-block px-4 py-1 bg-gray-100 text-gray-500 text-xs font-bold uppercase tracking-widest rounded-full">
                          {block.alt}
                        </span>
                      </figcaption>
                    )}
                  </figure>
                );

              default:
                return null;
            }
          })
        }
      </div>

      <!-- Tags Section -->
      <div class="mt-16 pt-8 border-t border-gray-100">
        <div class="flex items-center gap-3 flex-wrap">
          <span
            class="text-sm font-bold text-gray-400 uppercase tracking-widest"
            >Etiquetas:</span
          >
          <Tags tags={post.tags} />
        </div>
      </div>
    </main>

    <!-- Sidebar / CTA -->
    <aside class="lg:col-span-4 lg:sticky lg:top-24 h-fit">
      <div
        class="bg-green-light rounded-[2.5rem] p-8 text-white shadow-2xl shadow-green-light/30"
      >
        <h3 class="text-2xl font-black mb-4">¿Necesitas orientación?</h3>
        <p class="text-white/80 text-sm leading-relaxed mb-8">
          Nuestros especialistas están listos para ayudarte con tus dudas sobre
          preparación, resultados y más.
        </p>
        <a
          href="/contact"
          class="block w-full text-center py-4 bg-white text-green-light font-bold rounded-2xl hover:bg-yellow-primary hover:text-white transition-all duration-300 shadow-lg"
        >
          Contactar ahora
        </a>
      </div>

      <div class="mt-8 p-8 bg-gray-50 rounded-[2.5rem] border border-gray-100">
        <p class="text-xs text-gray-400 font-medium leading-relaxed italic">
          * La información presentada es de carácter informativo. Consulta
          siempre a tu médico para una interpretación personalizada de tus
          estudios.
        </p>
      </div>
    </aside>
  </div>
</article>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-up {
    animation: fadeUp 0.6s ease-out forwards;
  }
</style>
