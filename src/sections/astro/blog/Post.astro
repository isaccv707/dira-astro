---
import { Icon } from "astro-icon/components";
import type { Post, ContentBlock } from "../../../api/postsApi/post.interface";
import { fetchGetAllPosts } from "../../../api/postsApi/postApi";
import Tags from "../../../components/astro/Tags.astro";
import CTAContact from "../../../components/astro/CTA/CTAContact.astro";
import PostCard from "../../../components/react/cards/PostCard";
import { formattedDate } from "../../../utils/formattedDate";

interface Props {
  post: Post | undefined;
}

const { post } = Astro.props;
if (!post) return;

const date = formattedDate(post.createdAt);

// The API returns `image` as a plain URL string, not the `ImageMetadata`
// object the shared Post interface declares — handle both shapes safely.
const rawImage = post.image as unknown as string | ImageMetadata | undefined;
const heroImageSrc =
  typeof rawImage === "string" ? rawImage : rawImage?.src;

const contentBlocks = post.contentBlocks ?? [];
const firstParagraphIndex = contentBlocks.findIndex(
  (block) => block.type === "PARAGRAPH",
);

let relatedPosts: Post[] = [];
try {
  const { data } = await fetchGetAllPosts({ limit: 4 });
  relatedPosts = data.filter((p) => p.slug !== post.slug).slice(0, 3);
} catch (error) {
  console.error("[Post] Error fetching related posts:", error);
}
---

<article class="w-full max-w-5xl mx-auto py-12 motion-safe:animate-fade-up">
  <!-- Back to blog -->
  <a
    href="/blog"
    class="mb-8 inline-flex items-center gap-1.5 text-sm font-semibold text-grey-custom transition-colors hover:text-green-primary"
  >
    <Icon name="tabler:arrow-left" class="h-4 w-4" />
    Volver al blog
  </a>

  <!-- Header Section -->
  <header class="mb-12">
    <div class="mb-6 flex flex-wrap items-center gap-4">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-green-primary/15 bg-green-primary/8 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-green-primary"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-green-primary"></span>
        {post.category}
      </div>
      <div class="flex items-center gap-2 text-sm text-grey-custom/70">
        <Icon name="tabler:clock" class="h-4 w-4" />
        <span>{post.readingTime} min de lectura</span>
        <span class="text-grey-custom/40">•</span>
        <Icon name="tabler:calendar" class="h-4 w-4" />
        <span>{date}</span>
      </div>
    </div>

    <h1
      class="mb-8 text-4xl font-black leading-[1.1] tracking-tight text-green-light md:text-5xl lg:text-6xl"
    >
      {post.title}
    </h1>

    <p
      class="mb-10 border-l-4 border-green-primary pl-6 text-lg font-medium leading-relaxed text-grey-custom md:text-xl"
    >
      {post.description}
    </p>

    <!-- Author Profile -->
    <div
      class="flex w-fit items-center gap-4 rounded-clinical-md border border-ui-border bg-ui-bg p-4"
    >
      <div class="relative">
        <img
          src={post.author.avatar || "/favicon.svg"}
          alt={post.author.name}
          class="h-14 w-14 rounded-full border-2 border-white object-cover shadow-sm ring-1 ring-ui-border"
          loading="lazy"
        />
        <div
          class="absolute -bottom-0.5 -right-0.5 h-4 w-4 rounded-full border-2 border-white bg-green-secondary"
        >
        </div>
      </div>
      <div>
        <p class="text-sm font-bold leading-tight text-green-light">
          {post.author.name}
        </p>
        <p
          class="mt-0.5 text-xs font-medium uppercase tracking-tighter text-green-primary"
        >
          Especialista en Salud
        </p>
      </div>
    </div>
  </header>

  <!-- Hero Image -->
  {
    heroImageSrc && (
      <div class="relative mb-16 w-full">
        <div class="relative aspect-21/9 w-full overflow-hidden rounded-clinical-lg shadow-xl ring-1 ring-black/5">
          <img
            src={heroImageSrc}
            alt={post.title}
            class="h-full w-full object-cover"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/20 to-transparent" />
        </div>

        <div class="pointer-events-none absolute -bottom-4 left-6 flex items-center gap-2 rounded-full border border-green-primary/15 bg-white px-4 py-2 shadow-md">
          <span class="h-1.5 w-1.5 rounded-full bg-green-primary" />
          <span class="text-[11px] font-bold uppercase tracking-widest text-green-primary">
            Artículo DYRA
          </span>
        </div>
      </div>
    )
  }

  <!-- Content Body -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
    <main class="lg:col-span-8">
      <div
        class="prose prose-lg prose-gray max-w-none
                prose-headings:text-green-light prose-headings:font-black
                prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-8
                prose-p:text-grey-custom prose-p:leading-8 prose-p:mb-8
                prose-strong:text-green-light
                prose-ul:my-8 prose-li:text-grey-custom"
      >
        {
          contentBlocks.map((block: ContentBlock, index: number) => {
            switch (block.type) {
              case "PARAGRAPH":
                const isFirstParagraph = index === firstParagraphIndex;
                return (
                  <p
                    class={
                      isFirstParagraph
                        ? "text-grey-custom leading-relaxed text-lg mb-8 first-letter:text-5xl first-letter:font-black first-letter:text-green-light first-letter:mr-3 first-letter:float-left"
                        : "text-grey-custom leading-relaxed text-lg mb-8"
                    }
                  >
                    {block.content}
                  </p>
                );

              case "SUBTITLE":
                return (
                  <div class="relative group mt-16 mb-8">
                    <h2 class="inline-block relative z-10 text-3xl font-black text-green-light m-0">
                      {block.content}
                    </h2>
                    <div class="absolute -bottom-2 left-0 w-24 h-2 bg-yellow-primary/30 group-hover:w-full transition-all duration-500 rounded-full z-0" />
                  </div>
                );

              case "LIST":
                const listItems =
                  block.content
                    ?.split(/(?=\d+\.\s)/)
                    .map((item) => item.trim())
                    .filter((item) => item.length > 0) || [];
                return (
                  <ul class="list-none space-y-6 my-10 pl-0">
                    {listItems.map((item) => (
                      <li class="flex items-start gap-4 p-4 bg-ui-bg/50 rounded-clinical-md border border-transparent hover:border-green-primary/15 hover:bg-white transition-all duration-300">
                        <div class="mt-1 shrink-0 w-6 h-6 rounded-clinical-sm bg-green-primary/10 flex items-center justify-center">
                          <svg
                            class="w-4 h-4 text-green-primary"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="3"
                              d="M5 13l4 4L19 7"
                            />
                          </svg>
                        </div>
                        <span class="text-grey-custom font-medium leading-relaxed">
                          {item}
                        </span>
                      </li>
                    ))}
                  </ul>
                );

              case "QUOTE":
                return (
                  <div class="relative my-14">
                    <div class="absolute -top-6 -left-4 text-8xl text-yellow-primary/20 font-serif select-none">
                      “
                    </div>
                    <blockquote class="not-prose relative z-10 px-8 py-4 border-l-4 border-yellow-secondary">
                      <p class="text-2xl md:text-3xl font-bold text-green-light italic leading-snug tracking-tight">
                        {block.content}
                      </p>
                    </blockquote>
                    <div class="absolute -bottom-6 -right-4 text-8xl text-yellow-primary/20 font-serif select-none rotate-180">
                      “
                    </div>
                  </div>
                );

              case "IMAGE":
                return (
                  <figure class="not-prose my-16 group">
                    <div class="relative overflow-hidden rounded-clinical-lg shadow-xl border border-ui-border">
                      <img
                        src={block.src}
                        alt={block.alt || ""}
                        class="w-full h-auto transform transition-transform duration-700 group-hover:scale-105"
                        loading="lazy"
                      />
                      <div class="absolute inset-0 ring-1 ring-inset ring-black/10 rounded-clinical-lg" />
                    </div>
                    {block.alt && (
                      <figcaption class="mt-6 text-center">
                        <span class="inline-block px-4 py-1 bg-ui-bg text-grey-custom text-xs font-bold uppercase tracking-widest rounded-full">
                          {block.alt}
                        </span>
                      </figcaption>
                    )}
                  </figure>
                );

              default:
                return null;
            }
          })
        }
      </div>

      <!-- Tags Section -->
      <div class="mt-16 pt-8 border-t border-ui-border">
        <div class="flex items-center gap-3 flex-wrap">
          <span
            class="text-sm font-bold text-grey-custom uppercase tracking-widest"
            >Etiquetas:</span
          >
          <Tags tags={post.tags} />
        </div>
      </div>
    </main>

    <!-- Sidebar / CTA -->
    <aside class="lg:col-span-4 lg:sticky lg:top-24 h-fit space-y-6">
      <CTAContact />

      <div class="rounded-clinical-md border border-ui-border bg-ui-bg p-6">
        <p class="text-xs italic leading-relaxed text-grey-custom/70">
          * La información presentada es de carácter informativo. Consulta
          siempre a tu médico para una interpretación personalizada de tus
          estudios.
        </p>
      </div>
    </aside>
  </div>

  <!-- Related posts -->
  {
    relatedPosts.length > 0 && (
      <section class="mt-20 border-t border-ui-border pt-12">
        <div class="motion-safe:animate-fade-up">
          <div class="inline-flex items-center gap-2 rounded-full border border-green-primary/15 bg-green-primary/8 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-green-primary">
            <span class="h-1.5 w-1.5 rounded-full bg-green-primary" />
            Sigue leyendo
          </div>
          <h2 class="mt-3 text-2xl font-black tracking-tight text-green-light sm:text-3xl">
            Artículos relacionados
          </h2>
          <p class="mt-2 text-sm text-grey-custom sm:text-base">
            Más contenido sobre salud y diagnóstico clínico que te puede
            interesar.
          </p>
        </div>

        <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relatedPosts.map((relatedPost) => (
            <PostCard post={relatedPost} />
          ))}
        </div>
      </section>
    )
  }
</article>
