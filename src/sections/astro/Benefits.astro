---
import BenefitCard from "../../components/astro/cards/BenefitCard.astro";
import HeaderBySection from "../../components/astro/ui/HeaderBySection.astro";
import { benefits } from "../../data/benefits/benefits-data";

        // paragraph={`Atención rápida, resultados confiables y una experiencia clara para que tomes decisiones con seguridad.`}
---

<div class="flex justify-center text-center mb-5">
    <HeaderBySection
        textHeader={"Beneficios para nuestros clientes"}
        title={"Lo que obtienes al elegir DYRA"}
        textColor="white"
    />
</div>

<div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-20 text-center space-y-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8">
        {
            benefits.map(({ icon, description, title }) => (
                <BenefitCard
                    title={title}
                    description={description}
                    icon={icon}
                />
            ))
        }
    </div>
</div>
