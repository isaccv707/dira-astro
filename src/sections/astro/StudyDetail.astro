---
import { Icon } from "astro-icon/components";
import {
  getCatalogName,
  type PanelTree,
  type Study,
} from "../../interfaces/study.interface";
import StudyActionCard from "../../components/react/cards/StudyActionCard";
import CardStudy from "../../components/react/cards/CardStudy";
import StudyPanelTree from "../../components/astro/study/StudyPanelTree.astro";
import { countPanelLeaves } from "../../hooks/usePanelTree";
import { buildBarcode } from "../../utils/barcode";
import { getFastingHours } from "../../utils/studyPreparation";
import { Buttonstyles } from "../../styles/buttonsStyles";

interface Props {
  study: Study | null;
  panelTree?: PanelTree | null;
  recommendedStudies?: Study[];
}

const { study, panelTree = null, recommendedStudies = [] } = Astro.props;

if (!study) {
  return null; // The page already redirects when the study is missing
}

const { name, code, description, preparation } = study;
// Abbreviation often repeats the code verbatim — show it only when distinct.
const abbreviation =
  study.abbreviation &&
  study.abbreviation.toLowerCase() !== code.toLowerCase()
    ? study.abbreviation
    : null;
const sampleType = getCatalogName(study.sampleType);
const section = getCatalogName(study.section);
const technique = getCatalogName(study.technique);
const isPanel = Boolean(study.isPanel);

const reveal = (delayMs: number) =>
  `animation-delay:${delayMs}ms; animation-fill-mode:backwards;`;

// Specimen-label signature: bars derived from the study code.
const barcode = buildBarcode(`${code}${abbreviation ?? ""}`);

// Split free-text preparation into sentences so each instruction reads as
// its own step, and surface fasting hours when the text states them.
const prepSteps = (preparation ?? "")
  .split(/(?<=\.)\s+(?=[A-ZÁÉÍÓÚÑ¿¡])/)
  .map((step) => step.trim())
  .filter(Boolean);
const fastingHours = getFastingHours(preparation);


const panelChildren = panelTree?.children ?? [];
const panelCount = panelTree ? countPanelLeaves(panelChildren) : 0;

const labelRows = [
  { label: "Muestra", value: sampleType },
  { label: "Técnica", value: technique },
  {
    label: "Incluye",
    value: isPanel && panelTree
      ? `${panelCount} ${panelCount === 1 ? "estudio" : "estudios"}`
      : null,
  },
].filter((row): row is { label: string; value: string } => Boolean(row.value));
---

<div class="space-y-16">
  <!-- ===== Header: name + specimen label ===== -->
  <header>
    <nav
      aria-label="Breadcrumb"
      class="mb-8 flex items-center gap-1.5 text-xs text-grey-custom/70"
    >
      <a href="/" class="transition-colors hover:text-green-primary">Inicio</a>
      <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
      <a href="/quoter" class="transition-colors hover:text-green-primary"
        >Cotizador</a
      >
      <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
      <span class="max-w-50 truncate font-semibold text-green-light sm:max-w-xs"
        >{name}</span
      >
    </nav>

    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div
          class="inline-flex items-center gap-2 rounded-full border border-green-primary/15 bg-green-primary/8 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-green-primary motion-safe:animate-fade-up"
          style={reveal(0)}
        >
          <span class="h-1.5 w-1.5 rounded-full bg-green-primary"></span>
          {isPanel ? "Perfil" : "Estudio"}{section && ` · ${section}`}
        </div>

        <h1
          class="mt-4 text-3xl font-black leading-[1.05] tracking-tight text-green-light motion-safe:animate-fade-up sm:text-4xl lg:text-5xl"
          style={reveal(60)}
        >
          {name}
        </h1>

        {
          description && (
            <p
              class="mt-5 max-w-2xl text-base leading-relaxed text-grey-custom motion-safe:animate-fade-up sm:text-lg"
              style={reveal(120)}
            >
              {description}
            </p>
          )
        }
      </div>

      <!-- Signature: the study as its specimen label -->
      <figure
        class="relative overflow-hidden rounded-clinical-md border border-ui-border bg-white shadow-xs motion-safe:animate-fade-up lg:col-span-5"
        style={reveal(180)}
        aria-label={`Ficha del estudio ${name}`}
      >
        <div class="absolute inset-y-0 left-0 w-1.5 bg-green-primary"></div>

        <div class="pl-7 pr-6 pt-5">
          <div
            class="flex items-center justify-between text-[10px] font-bold uppercase tracking-[0.2em] text-grey-custom/70"
          >
            <span>DYRA · Laboratorio</span>
            {abbreviation && <span>{abbreviation}</span>}
          </div>

          <svg
            aria-hidden="true"
            class="mt-4 h-14 w-full text-green-light"
            viewBox={`0 0 ${barcode.width} 40`}
            preserveAspectRatio="none"
          >
            {
              barcode.bars.map((bar) => (
                <rect x={bar.x} y="0" width={bar.width} height="40" fill="currentColor" />
              ))
            }
          </svg>

          <p class="mt-2 font-mono text-xs tracking-[0.3em] text-green-light">
            <span class="sr-only">Código </span>{code}
          </p>
        </div>

        {
          labelRows.length > 0 && (
            <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-dashed border-ui-border pb-5 pl-7 pr-6 pt-5">
              {labelRows.map((row) => (
                <div class="min-w-0">
                  <dt class="text-[10px] font-bold uppercase tracking-wider text-grey-custom/70">
                    {row.label}
                  </dt>
                  <dd class="mt-0.5 text-sm font-bold leading-snug text-green-light">
                    {row.value}
                  </dd>
                </div>
              ))}
            </dl>
          )
        }
      </figure>
    </div>
  </header>

  <!-- ===== Body ===== -->
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
    <div class="space-y-10 lg:col-span-8">
      <section aria-labelledby="prep-title">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <h2
              id="prep-title"
              class="text-2xl font-black tracking-tight text-green-light sm:text-3xl"
            >
              Antes de tu toma
            </h2>
            <p class="mt-2 text-sm text-grey-custom sm:text-base">
              Sigue estas indicaciones para que tu muestra sea válida.
            </p>
          </div>
          {
            fastingHours && (
              <div class="inline-flex items-center gap-2 rounded-clinical-sm border border-yellow-secondary/25 bg-yellow-primary/10 px-3 py-1.5 text-xs font-black text-yellow-secondary">
                <Icon name="lucide:timer" class="h-4 w-4" />
                Ayuno de {fastingHours} h
              </div>
            )
          }
        </div>

        <div
          class="mt-6 rounded-clinical-md border border-ui-border bg-white p-6 shadow-xs"
        >
          {
            prepSteps.length > 0 ? (
              <ul class="space-y-4">
                {prepSteps.map((step) => (
                  <li class="flex gap-3">
                    <Icon
                      name="lucide:check"
                      class="mt-0.5 h-4 w-4 shrink-0 text-green-primary"
                    />
                    <span class="text-sm leading-relaxed text-grey-custom sm:text-base">
                      {step}
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="flex gap-3 text-sm leading-relaxed text-grey-custom sm:text-base">
                <Icon
                  name="lucide:check"
                  class="mt-0.5 h-4 w-4 shrink-0 text-green-primary"
                />
                Sin indicaciones registradas. Confirma en sucursal antes de tu
                toma.
              </p>
            )
          }
        </div>
      </section>

      {
        isPanel && panelTree && (
          <section aria-labelledby="panel-title">
            <div class="flex flex-wrap items-end justify-between gap-3">
              <div>
                <h2
                  id="panel-title"
                  class="text-2xl font-black tracking-tight text-green-light sm:text-3xl"
                >
                  Estudios incluidos
                </h2>
                <p class="mt-2 text-sm text-grey-custom sm:text-base">
                  Este perfil se procesa y cobra como un solo estudio.
                </p>
              </div>
              {panelCount > 0 && (
                <span class="text-sm font-bold tabular-nums text-grey-custom/70">
                  {panelCount} {panelCount === 1 ? "estudio" : "estudios"}
                </span>
              )}
            </div>

            <div class="mt-6 rounded-clinical-md border border-ui-border bg-white px-6 py-2 shadow-xs">
              {panelChildren.length > 0 ? (
                <StudyPanelTree nodes={panelChildren} />
              ) : (
                <p class="py-4 text-sm leading-relaxed text-grey-custom">
                  Este perfil no tiene estudios registrados.
                </p>
              )}
            </div>
          </section>
        )
      }
    </div>

    <aside class="lg:col-span-4">
      <div class="sticky top-24 space-y-4">
        <StudyActionCard study={study} client:load />

        <button
          type="button"
          onclick="history.back()"
          class:list={[
            "w-full cursor-pointer justify-center",
            Buttonstyles({ variant: "text", size: "none" }),
          ]}
        >
          <Icon name="lucide:arrow-left" class="h-5 w-5" />
          Regresar
        </button>
      </div>
    </aside>
  </div>

  {
    recommendedStudies.length > 0 && (
      <section>
        <div class="motion-safe:animate-fade-up">
          <h2 class="text-2xl font-black tracking-tight text-green-light sm:text-3xl">
            Otros estudios
          </h2>
          <p class="mt-2 text-sm text-grey-custom sm:text-base">
            Disponibles en tu sucursal.
          </p>
        </div>

        <div class="mt-8 grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 xl:grid-cols-4">
          {recommendedStudies.map((recommended, index) => (
            <div
              class="motion-safe:animate-fade-up"
              style={`animation-delay:${(index % 4) * 100}ms`}
            >
              <CardStudy study={recommended} client:visible />
            </div>
          ))}
        </div>
      </section>
    )
  }
</div>
