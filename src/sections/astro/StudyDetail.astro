---
import { Icon } from "astro-icon/components";
import {
  getCatalogName,
  type PanelTree,
  type Study,
} from "../../interfaces/study.interface";
import StudyActionCard from "../../components/react/cards/StudyActionCard";
import CardStudy from "../../components/react/cards/CardStudy";
import StudyPanelTree from "../../components/astro/study/StudyPanelTree.astro";
import SpecimenLabel from "../../components/astro/study/SpecimenLabel.astro";
import Eyebrow from "../../components/astro/ui/Eyebrow.astro";
import SectionHeader from "../../components/astro/ui/SectionHeader.astro";
import { countPanelLeaves } from "../../hooks/usePanelTree";
import { getFastingHours } from "../../utils/studyPreparation";
import { Buttonstyles } from "../../styles/buttonsStyles";
import { cardStyles } from "../../styles/ui";

interface Props {
  study: Study | null;
  panelTree?: PanelTree | null;
  recommendedStudies?: Study[];
}

const { study, panelTree = null, recommendedStudies = [] } = Astro.props;

if (!study) {
  return null; // The page already redirects when the study is missing
}

const { name, code, description, preparation } = study;
// Abbreviation often repeats the code verbatim — show it only when distinct.
const abbreviation =
  study.abbreviation &&
  study.abbreviation.toLowerCase() !== code.toLowerCase()
    ? study.abbreviation
    : null;
const sampleType = getCatalogName(study.sampleType);
const section = getCatalogName(study.section);
const technique = getCatalogName(study.technique);
const isPanel = Boolean(study.isPanel);

const reveal = (delayMs: number) =>
  `animation-delay:${delayMs}ms; animation-fill-mode:backwards;`;

// Split free-text preparation into sentences so each instruction reads as
// its own step, and surface fasting hours when the text states them.
const prepSteps = (preparation ?? "")
  .split(/(?<=\.)\s+(?=[A-ZÁÉÍÓÚÑ¿¡])/)
  .map((step) => step.trim())
  .filter(Boolean);
const fastingHours = getFastingHours(preparation);


const panelChildren = panelTree?.children ?? [];
const panelCount = panelTree ? countPanelLeaves(panelChildren) : 0;

const labelRows = [
  { label: "Muestra", value: sampleType },
  { label: "Técnica", value: technique },
  {
    label: "Incluye",
    value: isPanel && panelTree
      ? `${panelCount} ${panelCount === 1 ? "estudio" : "estudios"}`
      : null,
  },
].filter((row): row is { label: string; value: string } => Boolean(row.value));
---

<div class="space-y-16">
  <!-- ===== Header: name + specimen label ===== -->
  <header>
    <nav
      aria-label="Breadcrumb"
      class="mb-8 flex items-center gap-1.5 text-xs text-ink-subtle"
    >
      <a href="/" class="transition-colors hover:text-brand-ink">Inicio</a>
      <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
      <a href="/quoter" class="transition-colors hover:text-brand-ink"
        >Cotizador</a
      >
      <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
      <span class="max-w-50 truncate font-semibold text-ink sm:max-w-xs"
        >{name}</span
      >
    </nav>

    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <Eyebrow class="motion-safe:animate-fade-up" style={reveal(0)}>
          {isPanel ? "Perfil" : "Estudio"}{section && ` · ${section}`}
        </Eyebrow>

        <h1
          class="mt-4 text-3xl font-bold leading-[1.05] tracking-tight text-ink motion-safe:animate-fade-up sm:text-4xl lg:text-5xl"
          style={reveal(60)}
        >
          {name}
        </h1>

        {
          description && (
            <p
              class="mt-5 max-w-2xl text-base leading-relaxed text-ink-muted motion-safe:animate-fade-up sm:text-lg"
              style={reveal(120)}
            >
              {description}
            </p>
          )
        }
      </div>

      <SpecimenLabel
        code={code}
        abbreviation={abbreviation}
        rows={labelRows}
        label={`Ficha del estudio ${name}`}
        class="motion-safe:animate-fade-up lg:col-span-5"
        style={reveal(180)}
      />
    </div>
  </header>

  <!-- ===== Body ===== -->
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
    <div class="space-y-10 lg:col-span-8">
      <section aria-labelledby="prep-title">
        <SectionHeader
          id="prep-title"
          title="Antes de tu toma"
          lead="Sigue estas indicaciones para que tu muestra sea válida."
        >
          {
            fastingHours && (
              <span
                slot="aside"
                class="inline-flex items-center gap-2 rounded-clinical-sm border border-yellow-secondary/25 bg-yellow-primary/10 px-3 py-1.5 text-xs font-bold text-yellow-ink"
              >
                <Icon name="lucide:timer" class="h-4 w-4" />
                Ayuno de {fastingHours} h
              </span>
            )
          }
        </SectionHeader>

        <div class:list={[cardStyles(), "mt-6"]}>
          {
            prepSteps.length > 0 ? (
              <ul class="space-y-4">
                {prepSteps.map((step) => (
                  <li class="flex gap-3">
                    <Icon
                      name="lucide:check"
                      class="mt-0.5 h-4 w-4 shrink-0 text-brand-ink"
                    />
                    <span class="text-sm leading-relaxed text-ink-muted sm:text-base">
                      {step}
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="flex gap-3 text-sm leading-relaxed text-ink-muted sm:text-base">
                <Icon
                  name="lucide:check"
                  class="mt-0.5 h-4 w-4 shrink-0 text-brand-ink"
                />
                Sin indicaciones registradas. Confirma en sucursal antes de tu
                toma.
              </p>
            )
          }
        </div>
      </section>

      {
        isPanel && panelTree && (
          <section aria-labelledby="panel-title">
            <SectionHeader
              id="panel-title"
              title="Estudios incluidos"
              lead="Este perfil se procesa y cobra como un solo estudio."
            >
              {panelCount > 0 && (
                <span slot="aside" class="text-sm font-bold tabular-nums text-ink-subtle">
                  {panelCount} {panelCount === 1 ? "estudio" : "estudios"}
                </span>
              )}
            </SectionHeader>

            <div class:list={[cardStyles({ padding: "none" }), "mt-6 px-6 py-2"]}>
              {panelChildren.length > 0 ? (
                <StudyPanelTree nodes={panelChildren} />
              ) : (
                <p class="py-4 text-sm leading-relaxed text-ink-muted">
                  Este perfil no tiene estudios registrados.
                </p>
              )}
            </div>
          </section>
        )
      }
    </div>

    <aside class="lg:col-span-4">
      <div class="sticky top-24 space-y-4">
        <StudyActionCard study={study} client:load />

        <button
          type="button"
          onclick="history.back()"
          class:list={[
            "w-full cursor-pointer justify-center",
            Buttonstyles({ variant: "text", size: "none" }),
          ]}
        >
          <Icon name="lucide:arrow-left" class="h-5 w-5" />
          Regresar
        </button>
      </div>
    </aside>
  </div>

  {
    recommendedStudies.length > 0 && (
      <section>
        <SectionHeader
          class="motion-safe:animate-fade-up"
          title="Otros estudios"
          lead="Disponibles en tu sucursal."
        />

        <div class="mt-8 grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 xl:grid-cols-4">
          {recommendedStudies.map((recommended, index) => (
            <div
              class="motion-safe:animate-fade-up"
              style={`animation-delay:${(index % 4) * 100}ms`}
            >
              <CardStudy study={recommended} client:visible />
            </div>
          ))}
        </div>
      </section>
    )
  }
</div>
