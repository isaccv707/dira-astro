---
import type { Study } from "../../interfaces/study.interface";
import HeaderBySection from "../../components/astro/ui/HeaderBySection.astro";

interface Props {
  study: Study | null;
}

const { study } = Astro.props;

if (!study) {
  return null; // Or a redirect, but the page already handles this
}

const { name, code, description, preparation, sampleType, deliveryTime } =
  study;
---

<section class="min-h-screen bg-gray-50 pb-20">
  <div
    class="bg-white pt-10 pb-16 px-4 sm:px-8 md:px-16 border-b border-gray-100"
  >
    <div class="max-w-7xl mx-auto">
      <HeaderBySection
        textHeader="Detalle del Estudio"
        title={name}
        paragraph={`Código: ${code}`}
        textColor="black"
      />
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-8 md:px-16 mt-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Left Column: Info -->
      <div class="lg:col-span-2 space-y-8">
        <!-- Description Section -->
        <div
          class="bg-white p-8 rounded-[2.5rem] shadow-sm border border-gray-100"
        >
          <div class="flex items-center gap-3 mb-6">
            <div
              class="p-3 bg-green-secondary/10 rounded-2xl text-green-secondary"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-file-text"
                ><path
                  d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"
                ></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path
                  d="M10 9H8"></path><path d="M16 13H8"></path><path
                  d="M16 17H8"></path></svg
              >
            </div>
            <h2 class="text-xl font-bold text-black">
              Descripción del Estudio
            </h2>
          </div>
          <p class="text-grey leading-relaxed">
            {
              description ||
                "Este estudio clínico proporciona información valiosa para el diagnóstico y seguimiento de diversos padecimientos. Realizado bajo los más altos estándares de calidad."
            }
          </p>
        </div>

        <!-- Preparation & Sample -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Preparation -->
          <div
            class="bg-white p-8 rounded-[2.5rem] shadow-sm border border-gray-100"
          >
            <div class="flex items-center gap-3 mb-6">
              <div
                class="p-3 bg-yellow-primary/10 rounded-2xl text-yellow-secondary"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-flask-conical"
                  ><path d="M10 2v7.5"></path><path d="M14 2v7.5"></path><path
                    d="M4.8 22h14.4c.5 0 .9-.3 1.1-.7.3-.5.2-1-.1-1.4L14 9.5V2h-4v7.5L3.9 19.9c-.3.4-.4.9-.1 1.4.2.4.6.7 1 .7Z"
                  ></path></svg
                >
              </div>
              <h2 class="text-lg font-bold text-black">Preparación</h2>
            </div>
            <p class="text-sm text-grey leading-relaxed">
              {
                preparation ||
                  "No requiere preparación especial para este estudio."
              }
            </p>
          </div>

          <!-- Details Stats -->
          <div
            class="bg-white p-8 rounded-[2.5rem] shadow-sm border border-gray-100 flex flex-col justify-between"
          >
            <div class="space-y-6">
              <div class="flex items-center gap-4">
                <div class="p-2 bg-green-light/10 rounded-xl text-green-light">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="lucide lucide-test-tube-2"
                    ><path d="M21 7 7 21"></path><path d="M16 2.5 2.5 16"
                    ></path><path d="M12 11 6 5"></path><path d="m19 14-6-6"
                    ></path><path d="M10 16 4 10"></path><path
                      d="M20 4a2 2 0 0 0-2.828 0L14 7.172l2.828 2.828L20 7.172A2 2 0 0 0 20 4Z"
                    ></path></svg
                  >
                </div>
                <div>
                  <p
                    class="text-[10px] font-bold uppercase tracking-wider text-grey"
                  >
                    Tipo de Muestra
                  </p>
                  <p class="text-sm font-bold text-black">
                    {sampleType || "No especificado"}
                  </p>
                </div>
              </div>

              <div class="flex items-center gap-4">
                <div
                  class="p-2 bg-green-secondary/10 rounded-xl text-green-secondary"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="lucide lucide-clock"
                    ><circle cx="12" cy="12" r="10"></circle><polyline
                      points="12 6 12 12 16 14"></polyline></svg
                  >
                </div>
                <div>
                  <p
                    class="text-[10px] font-bold uppercase tracking-wider text-grey"
                  >
                    Tiempo de Entrega
                  </p>
                  <p class="text-sm font-bold text-black">
                    {deliveryTime} horas
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom CTA -->
        <div
          class="p-8 rounded-[2.5rem] bg-gradient-to-r from-green-primary to-green-secondary text-white overflow-hidden relative group"
        >
          <div
            class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6"
          >
            <div class="text-center md:text-left">
              <h3 class="text-2xl font-bold mb-2 text-white">
                ¿Buscas otros estudios?
              </h3>
              <p class="text-white/80 max-w-md">
                Contamos con un amplio catálogo de análisis clínicos para tu
                salud.
              </p>
            </div>
            <a
              href="/quoter"
              class="px-8 py-3 bg-white text-green-primary rounded-full font-bold hover:shadow-lg transition-all transform hover:scale-105"
            >
              Explorar Catálogo
            </a>
          </div>
          <!-- Decorative Circle -->
          <div
            class="absolute -right-10 -bottom-10 w-40 h-40 bg-white/10 rounded-full blur-3xl group-hover:bg-white/20 transition-all"
          >
          </div>
        </div>
      </div>

      <!-- Right Column: Action Card -->
      <div class="lg:col-span-1">
        <div class="sticky top-24">
          <!-- <StudyDetailActions study={study} client:load /> -->

          <div class="mt-8 flex justify-center">
            <button
              onclick="history.back()"
              class="flex items-center gap-2 text-grey font-semibold hover:text-black transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-arrow-left"
                ><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg
              >
              Regresar
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
