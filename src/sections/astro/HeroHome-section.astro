---
import Hero from "../../components/astro/ui/Hero.astro";
import logo from "../../assets/images/logos/logo.png";
import CarouselHomeSection from "./hero/CarouselHome-section.astro";
---

<section class="relative flex items-center overflow-hidden">
  <div
    class="container relative z-10 mx-auto max-w-7xl px-6 lg:px-8 pt-6 pb-12 md:pt-10 md:pb-16"
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <div
        class="lg:col-span-6 xl:col-span-5 text-center lg:text-left space-y-6"
      >
        <div
          class="relative group transition-all duration-700 hover:translate-x-1"
        >
          <Hero
            img={logo}
            textHeader={"Resultados confiables • Atención rápida"}
            title={"Precisión que inspira confianza."}
            paragraph={`En DYRA combinamos excelencia clínica y calidez humana para ofrecerte diagnósticos precisos cuando más los necesitas.`}
          />
        </div>
      </div>

      <div class="lg:col-span-6 xl:col-span-7 relative">
        <div class="relative group">
          <div
            class="relative bg-white p-2 md:p-4 rounded-[2.5rem] shadow-[0_32px_64px_-16px_rgba(0,0,0,0.1)] border border-white/40 backdrop-blur-sm transition-all duration-500 group-hover:shadow-[0_48px_80px_-20px_rgba(0,0,0,0.15)] group-hover:-translate-y-2"
          >
            <div class="overflow-hidden rounded-[1.8rem]">
              <CarouselHomeSection />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
