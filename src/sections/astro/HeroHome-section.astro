---
import Hero from "../../components/astro/ui/Hero.astro";
import CarouselHomeWrapper from "../../components/react/wrappers/CarouselWrapper";
import logo from "../../assets/images/logos/logo.png";
---

<section>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:gap-12 items-center">
        <div class="text-center md:text-left">
            <Hero
                img={logo}
                textHeader={"Resultados confiables • Atención rápida"}
                title={"Bienvenido a DYRA"}
                paragraph={`Explora nuestros servicios y encuentra lo que necesitas con una experiencia rápida, clara y profesional.`}
            />
        </div>

        <div class="w-full">
            <CarouselHomeWrapper client:load />
        </div>
    </div>
</section>
