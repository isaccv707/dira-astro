---
import CarouselHomeSection from "./hero/CarouselHome-section.astro";
import { Icon } from "astro-icon/components";
import logo from "../../assets/images/logos/logo.png";
import NavLinkButton from "../../components/react/navigation/NavLinkButton";

const stats = [
  { value: "+15", label: "Años de experiencia", accent: "text-green-primary" },
  { value: "2", label: "Ciudades", accent: "text-green-primary" },
  { value: "500+", label: "Estudios disponibles", accent: "text-yellow-secondary" },
];

const features = [
  {
    icon: "tabler:microscope",
    label: "Análisis Clínicos",
    desc: "Alta precisión",
    path: "/service/analisis-clinicos",
  },
  {
    icon: "tabler:building-community",
    label: "Salud Empresarial",
    desc: "Programas a tu medida",
    path: "/service/salud-empresarial",
  },
  {
    icon: "tabler:home-check",
    label: "Tomas a Domicilio",
    desc: "Servicio en tu hogar",
    path: "/service/tomas-a-domicilio",
  },
];
---

<section class="relative overflow-hidden bg-white py-12 md:py-16 lg:py-20">

  <!-- Decorative background -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="absolute -top-40 -right-40 h-150 w-150 rounded-full bg-green-primary/5 blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 h-96 w-96 rounded-full bg-green-secondary/8 blur-3xl"></div>
    <div class="absolute top-1/2 left-1/3 h-56 w-56 -translate-y-1/2 rounded-full bg-yellow-primary/8 blur-3xl"></div>
    <div
      class="absolute inset-0"
      style="background-image: linear-gradient(rgba(34,143,4,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(34,143,4,0.035) 1px, transparent 1px); background-size: 52px 52px;"
    ></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">

      <!-- ===== LEFT: Hero content ===== -->
      <div class="flex flex-col items-center text-center lg:items-start lg:text-left">

        <!-- Logo + live badge -->
        <div class="mb-6 flex flex-col items-center gap-4 sm:flex-row sm:items-center lg:flex-row">
          <div class="relative shrink-0">
            <div class="absolute -inset-1 rounded-2xl bg-green-primary/20 blur-sm"></div>
            <img
              src={logo.src}
              alt="DYRA – Diagnóstico y Referencia Analítica"
              class="relative h-20 w-20 rounded-2xl object-contain shadow-md ring-2 ring-green-primary/25"
              loading="eager"
              width={80}
              height={80}
            />
          </div>
          <div
            class="inline-flex items-center gap-2 rounded-full border border-green-primary/25 bg-green-primary/10 px-4 py-1.5 text-xs font-semibold text-green-primary"
          >
            <span class="h-2 w-2 animate-pulse rounded-full bg-green-primary"></span>
            Resultados confiables · Atención rápida
          </div>
        </div>

        <!-- Main heading -->
        <h1 class="mb-5 text-4xl font-black leading-[1.1] tracking-tight sm:text-5xl lg:text-5xl xl:text-6xl">
          <span class="text-black-custom">Tu salud,</span><br />
          <span class="text-green-primary">analizada</span><br />
          <span class="text-yellow-secondary">con precisión.</span>
        </h1>

        <!-- Paragraph -->
        <p class="mb-8 max-w-lg text-base leading-relaxed text-grey-custom sm:text-lg">
          Laboratorio clínico certificado con tecnología de vanguardia. Resultados
          confiables, entrega rápida y atención personalizada en Jalisco y Colima.
        </p>

        <!-- CTA buttons -->
        <div class="mb-10 flex flex-wrap justify-center gap-3 lg:justify-start">
          <NavLinkButton
            path="/service/analisis-clinicos"
            text="Ver servicios"
            variant="primary"
            size="lg"
            width="auto"
          />
          <NavLinkButton
            path="/quoter"
            text="Cotizar estudios"
            variant="ghost"
            size="lg"
            width="auto"
          />
        </div>

        <!-- Stats -->
        <div class="flex flex-wrap justify-center gap-3 lg:justify-start">
          {
            stats.map(({ value, label, accent }) => (
              <div class="flex min-w-22.5 flex-col items-center rounded-xl border border-green-primary/10 bg-white px-5 py-3 shadow-sm">
                <span class={`text-2xl font-black leading-none ${accent}`}>{value}</span>
                <span class="mt-1 text-[11px] font-medium text-grey-custom">{label}</span>
              </div>
            ))
          }
        </div>

      </div>

      <!-- ===== RIGHT: Carousel + service pills ===== -->
      <div class="flex flex-col gap-4">

        <!-- Carousel with decorative frame -->
        <div class="relative">
          <div
            class="absolute -inset-2 rounded-3xl blur-md"
            style="background: linear-gradient(135deg, rgba(34,143,4,0.18), rgba(110,194,37,0.12));"
          ></div>
          <div class="relative overflow-hidden rounded-2xl shadow-2xl ring-1 ring-green-primary/15">
            <CarouselHomeSection />
          </div>
        </div>

        <!-- Service pills -->
        <div class="grid grid-cols-3 gap-2">
          {
            features.map(({ icon, label, desc, path }) => (
              <a
                href={path}
                class="group flex flex-col items-center gap-2 rounded-xl border border-green-primary/10 bg-white p-3 text-center shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-green-primary/30 hover:shadow-md"
              >
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-green-primary/10 transition-colors duration-200 group-hover:bg-green-primary/20">
                  <Icon name={icon} class="h-5 w-5 text-green-primary" />
                </div>
                <span class="text-xs font-bold leading-tight text-black-custom">{label}</span>
                <span class="text-[10px] leading-tight text-grey-custom">{desc}</span>
              </a>
            ))
          }
        </div>

      </div>

    </div>
  </div>
</section>
