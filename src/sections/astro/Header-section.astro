---
import { Image } from "astro:assets";
import logoDyra from "../../assets/images/logos/logo_dyra.png";
import NavbarSection from "./Navbar-section.astro";
import ButtonDrawer from "../../components/react/buttons/ButtonDrawer";
import NavDrawer from "../../components/react/drawer/NavDrawer";
---

<header class="bg-white shadow-md px-4 sm:px-8 py-4 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto flex justify-between items-center">
    <a href="/" class="flex items-center gap-3">
      <Image
        src={logoDyra}
        width={64}
        height={64}
        alt="Icono descriptivo"
        format="webp"
      />
    </a>

    <div class="flex items-center gap-4">
      <div class="hidden md:block">
        <NavbarSection />
      </div>

      <div class="md:hidden">
        <ButtonDrawer client:load />
      </div>
    </div>
  </div>
</header>
