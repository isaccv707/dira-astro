---
import logoDyra from "../../assets/images/logos/logo_dyra.png";

import ButtonDrawer from "../../components/react/buttons/ButtonDrawer";
import BranchSwitcher from "../../components/react/branch/BranchSwitcher";
import StudySearch from "../../components/react/search/StudySearch";
import NavLinkButton from "../../components/react/navigation/NavLinkButton";
import Navbar from "./layout/Navbar.astro";
import BrandStripe from "../../components/astro/ui/BrandStripe.astro";
import {
  getActiveBranchName,
  getActiveBranchResultsUrl,
} from "../../api/branchesApi/branchesApi";

// Middleware falls back to DEFAULT_BRANCH_ID without a cookie; only show a
// name when the visitor actually picked one.
const hasBranchCookie = Boolean(Astro.cookies.get("dyra_branch_id")?.value);
const branchName = hasBranchCookie ? await getActiveBranchName() : null;
const resultsUrl = (await getActiveBranchResultsUrl()) ?? "/branches";
const resultsIsExternal = resultsUrl.startsWith("http");
---

<a
  href="#main-content"
  class="sr-only z-60 rounded-clinical-sm bg-brand-ink px-4 py-2 text-sm font-semibold text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
>
  Saltar al contenido
</a>

<header class="sticky top-0 z-50 border-b border-ui-border bg-white">
  <BrandStripe />
  <div
    class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 sm:px-6 lg:px-8"
  >
    <a
      href="/"
      class="shrink-0 rounded-clinical-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-primary focus-visible:ring-offset-2"
      aria-label="DYRA, ir al inicio"
    >
      <img src={logoDyra.src} alt="" width="48" height="48" class="h-12 w-12" />
    </a>

    <div class="hidden min-w-0 lg:block">
      <BranchSwitcher client:load initialName={branchName} />
    </div>

    <!-- Wide screens: always-visible search -->
    <div class="ml-2 hidden max-w-sm flex-1 xl:block">
      <StudySearch client:idle variant="inline" />
    </div>

    <div class="ml-auto hidden items-center gap-2 lg:flex">
      <Navbar />
      <div class="xl:hidden">
        <StudySearch client:idle variant="toggle" />
      </div>
      <NavLinkButton
        path={resultsUrl}
        text="Resultados"
        variant="accent"
        size="sm"
        target={resultsIsExternal ? "_blank" : "_self"}
        ariaLabel={resultsIsExternal ? "Resultados (se abre en otra pestaña)" : undefined}
      />
    </div>

    <!-- Phones and tablets -->
    <div class="ml-auto flex min-w-0 items-center gap-1 lg:hidden">
      <BranchSwitcher client:load initialName={branchName} variant="compact" />
      <StudySearch client:idle variant="toggle" />
      <ButtonDrawer client:load />
    </div>
  </div>
</header>
