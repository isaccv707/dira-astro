---

import DrawerWrapper from "../../components/react/wrappers/DrawerWrapper";
import logoDyra from "../../assets/images/logos/logo.png";
import { SOCIAL_NETWORKS } from "../../constants/socialNetworks";
import NavbarSection from "./Navbar-section.astro";
---

<header class="bg-white shadow-md px-4 sm:px-8 py-4 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto flex justify-between items-center">
    <a href="/" class="flex items-center gap-3">
      <img
        src={logoDyra.src}
        alt="logo-dyra"
        class="w-20 h-auto object-contain"
      />
    </a>

    <div class="flex items-center gap-4">
      <div class="hidden md:block">
        <NavbarSection />
      </div>

      <div class="hidden md:flex items-center gap-4">
        {
          SOCIAL_NETWORKS.map(({ href, icon }, index) => (
            <a href={href} aria-label="Facebook">
              <img src={icon.src} alt="Facebook" class="w-8 h-8" />
            </a>
          ))
        }
      </div>

      <div class="md:hidden">
        <DrawerWrapper client:load />
      </div>
    </div>
  </div>
</header>
