---
import type { ReviewResponse } from "../../../api/reviewsApi/review.interface";
import { getAllReviews } from "../../../api/reviewsApi/reviewsApi";
import ReviewCard from "../../../components/astro/cards/ReviewCard.astro";
import SectionHeader from "../../../components/astro/ui/SectionHeader.astro";
import AddReviewButton from "../../../components/react/buttons/AddReviewButton";
import Carousel from "../../../components/react/carousel/Carousel";

let reviews: ReviewResponse[] = [];
let isError = false;

try {
  const result = await getAllReviews();
  reviews = result.data ?? [];
} catch (error) {
  console.error("[Review] Error fetching reviews:", error);
  isError = true;
}
---

<section aria-labelledby="reviews-title" class="space-y-8">
  <SectionHeader
    id="reviews-title"
    title="Opiniones de pacientes"
    lead="Reseñas publicadas por personas que se atendieron en DYRA."
  >
    <div slot="aside">
      <AddReviewButton client:visible modalId="MODA_REVIEW_FROM" />
    </div>
  </SectionHeader>

  {
    isError ? (
      <p class="rounded-clinical-md border border-ui-border bg-white p-6 text-sm text-ink-muted">
        No pudimos cargar las reseñas en este momento.
      </p>
    ) : reviews.length > 0 ? (
      <Carousel
        client:visible
        swipperOptions={{
          breakpoints: {
            320: { slidesPerView: 1, spaceBetween: 12 },
            640: { slidesPerView: 1.3, spaceBetween: 16 },
            768: { slidesPerView: 2, spaceBetween: 20 },
            1024: { slidesPerView: 3, spaceBetween: 24 },
          },
        }}
      >
        {reviews.map((review: ReviewResponse) => (
          <div class="h-full py-1">
            <ReviewCard review={review} />
          </div>
        ))}
      </Carousel>
    ) : (
      <p class="rounded-clinical-md border border-dashed border-ui-border bg-white p-6 text-sm text-ink-muted">
        Aún no hay reseñas publicadas. Sé la primera persona en compartir tu experiencia.
      </p>
    )
  }
</section>
