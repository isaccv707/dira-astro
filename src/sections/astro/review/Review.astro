---
import type { ReviewResponse } from "../../../api/reviewsApi/review.interface";
import { getAllReviews } from "../../../api/reviewsApi/reviewsApi";
import ReviewCard from "../../../components/astro/cards/ReviewCard.astro";
import ReviewCardSkeleton from "../../../components/astro/skeletons/ReviewCardSkeleton.astro";
import HeaderBySection from "../../../components/astro/ui/HeaderBySection.astro";
import AddReviewButton from "../../../components/react/buttons/AddReviewButton";
import Carousel from "../../../components/react/carousel/Carousel";

const branchId = Astro.cookies.get("dyra_branch_id")?.value;

let reviews: ReviewResponse[] = [];
let isError = false;
let isLoading = true;

try {
  const result = await getAllReviews(branchId);
  reviews = result.data;
  isLoading = false;
} catch (error) {
  isError = true;
  isLoading = false;
}
---

<section>
  <div class="flex justify-center text-center">
    <HeaderBySection
      title="Lo que nuestros pacientes dicen de nosotros"
      textHeader="Reseñas de nuestros pacientes"
    />
  </div>
  <div>
    {
      isError ? (
        <p class="text-center text-red-custom">
          No se pudieron cargar las reseñas.
        </p>
      ) : isLoading ? (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          {[...Array(3)].map((_, i) => (
            <ReviewCardSkeleton />
          ))}
        </div>
      ) : reviews.length > 0 ? (
        <div class="relative w-full px-4 md:px-0">
          <Carousel
            client:visible
            swipperOptions={{
              breakpoints: {
                320: {
                  slidesPerView: 1,
                  spaceBetween: 10,
                },
                640: {
                  slidesPerView: 1.2,
                  spaceBetween: 20,
                },
                768: {
                  slidesPerView: 2,
                  spaceBetween: 20,
                },
                1024: {
                  slidesPerView: 3,
                  spaceBetween: 30,
                },
              },
            }}
          >
            {reviews?.map((review: ReviewResponse) => (
              <div class="h-full py-2">
                <ReviewCard review={review} />
              </div>
            ))}
          </Carousel>
        </div>
      ) : (
        <p class="text-center text-grey-custom">No hay reseñas disponibles.</p>
      )
    }
    <div class="mt-8">
      <AddReviewButton client:load modalId="MODA_REVIEW_FROM" />
    </div>
  </div>
</section>
