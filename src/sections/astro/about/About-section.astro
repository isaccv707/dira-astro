---
import logo from "../../../assets/images/logos/logo.png";
import imgAbout from "../../../assets/images/home/carousel/2A.jpg";
import HeaderBySection from "../../../components/astro/ui/HeaderBySection.astro";

export const prerender = true;
---

<section>
  <div class="grid items-center gap-10 md:grid-cols-2 md:gap-12">
    <div class="w-full">
      <div class="max-w-prose">
        <HeaderBySection
          textHeader="Diagnóstico y Referencia Analítica"
          title="Acerca de nosotros"
          paragraph="En DYRA brindamos servicios de diagnóstico clínico y referencia analítica con un enfoque en precisión, rapidez y atención humana. Contamos con procesos estandarizados y control de calidad para ofrecer resultados confiables que apoyen la toma de decisiones médicas."
          img={logo}
          textColor="yellow-secondary"
          btn={true}
        />
      </div>
    </div>

    <div
      class="relative flex justify-center motion-safe:animate-fade-up md:justify-start"
      style="animation-delay:120ms; animation-fill-mode:backwards;"
    >
      <img
        src={imgAbout.src}
        alt="Imagen DYRA"
        class="w-full max-w-md md:max-w-lg h-auto rounded-3xl object-cover shadow-lg ring-1 ring-black/5"
        loading="lazy"
        decoding="async"
        width={512}
        height={400}
      />

      <!-- Floating certification badge — echoes the Hero's instrument-badge language -->
      <div
        class="pointer-events-none absolute -bottom-4 left-6 flex items-center gap-2 rounded-full border border-green-primary/15 bg-white px-4 py-2 shadow-md"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-green-primary"></span>
        <span class="text-[11px] font-bold uppercase tracking-widest text-green-primary">
          Laboratorio certificado
        </span>
      </div>
    </div>
  </div>
</section>
