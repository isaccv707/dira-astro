---
import SectionHeader from "../../../components/astro/ui/SectionHeader.astro";
import { companyValues } from "../../../data/about/companyValues-data";

const statements = companyValues.filter((item) => item.paragraph);
const values = companyValues.find((item) => item.list)?.list ?? [];
---

<section aria-labelledby="identity-title" class="space-y-8">
  <SectionHeader id="identity-title" title="Misión, visión y valores" />

  <div class="grid gap-4 lg:grid-cols-2">
    {
      statements.map(({ title, paragraph }) => (
        <article class="rounded-clinical-md border border-ui-border bg-white p-6 shadow-xs">
          <h3 class="text-lg font-bold text-ink">{title}</h3>
          <p class="mt-3 leading-relaxed text-ink-muted">{paragraph?.replace(/\s+/g, " ")}</p>
        </article>
      ))
    }
  </div>

  {
    values.length > 0 && (
      <div>
        <h3 class="text-lg font-bold text-ink">Valores</h3>
        <dl class="mt-4 grid gap-px overflow-hidden rounded-clinical-md border border-ui-border bg-ui-border sm:grid-cols-2">
          {values.map(({ title, text }) => (
            <div class="bg-white p-6">
              <dt class="font-semibold text-ink">{title}</dt>
              {text && <dd class="mt-2 text-sm leading-relaxed text-ink-muted">{text}</dd>}
            </div>
          ))}
        </dl>
      </div>
    )
  }
</section>
