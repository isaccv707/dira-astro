---
import Dropdown from "../../../components/astro/ui/Dropdown.astro";
import { getServicesNavRoutes } from "../../../api/servicesApi/serviceApi";
import { getToKnowRoutes, isActivePath, routes } from "../../../routes/routes";

const currentPath = Astro.url.pathname;
const servicesRoutes = await getServicesNavRoutes();
const toMenu = (items: { path: string; text: string }[]) =>
  items.map(({ path, text }) => ({ label: text, href: path }));
---

<nav aria-label="Principal" class="flex items-center gap-1">
  <Dropdown text="Servicios" routes={toMenu(servicesRoutes)} currentPath={currentPath} />
  {
    routes.map(({ path, text }) => {
      const isActive = isActivePath(currentPath, path);
      return (
        <a
          href={path}
          aria-current={isActive ? "page" : undefined}
          class:list={[
            "relative rounded-clinical-sm px-2 py-2 text-sm font-medium transition-colors duration-200 hover:text-brand-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-primary focus-visible:ring-offset-2",
            isActive
              ? "text-brand-ink after:absolute after:inset-x-2 after:-bottom-px after:h-0.5 after:rounded-full after:bg-green-primary"
              : "text-ink",
          ]}
        >
          {text}
        </a>
      );
    })
  }
  <Dropdown text="Nosotros" routes={toMenu(getToKnowRoutes)} currentPath={currentPath} />
</nav>
