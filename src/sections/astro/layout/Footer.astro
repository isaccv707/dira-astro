---
import NavigationButton from "../../../components/astro/navigation/NavigationButton.astro";
import NavLinkButton from "../../../components/react/navigation/NavLinkButton";
import { SOCIAL_NETWORKS } from "../../../constants/socialNetworks";
import { getToKnowRoutes, routes, type Routes } from "../../../routes/routes";
import { getServicesNavRoutes } from "../../../api/servicesApi/serviceApi";
import { getActiveBranchResultsUrl } from "../../../api/branchesApi/branchesApi";
import dyraLogo from "../../../assets/images/logos/logo.png";

const servicesRoutes = await getServicesNavRoutes();
const resultsUrl = (await getActiveBranchResultsUrl()) ?? "/branches";
const resultsRoutes: Routes[] = [
  { path: resultsUrl, text: "Consultar resultados" },
];
---

<footer class="bg-green-primary text-white pt-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="grid grid-cols-1 lg:grid-cols-3 gap-10 items-center border-b border-white/20 pb-10"
    >
      <div
        class="lg:col-span-2 flex flex-col md:flex-row items-center md:items-start gap-6 text-center md:text-left"
      >
        <img src={dyraLogo.src} alt="logo" class="w-36 h-auto shrink-0" />
        <div class="md:border-l-2 md:border-white/30 md:pl-6">
          <p class="text-sm md:text-base font-bold leading-relaxed max-w-xl">
            En DYRA, ofrecemos servicios de calidad con un enfoque profesional
            para garantizar la mejor experiencia a nuestros clientes.
          </p>
        </div>
      </div>

      <div class="flex flex-col items-center lg:items-end space-y-4">
        <h4 class="font-bold uppercase tracking-widest text-xs">Contáctanos</h4>
        <div class="flex gap-4">
          {
            SOCIAL_NETWORKS.map(({ name, route, icon }) => (
              <NavigationButton
                href={route}
                icon={icon}
                target={name !== "Gmail" ? "_blank" : "_self"}
                className="inline-flex items-center justify-center transition hover:scale-105 active:scale-95"
                iconClassName="w-7 h-7"
              />
            ))
          }
        </div>
      </div>
    </div>

    <div class="py-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      {
        [
          { title: "Generales", data: routes },
          { title: "Servicios", data: servicesRoutes },
          { title: "Conócenos", data: getToKnowRoutes },
          { title: "Resultados", data: resultsRoutes },
        ].map((section) => (
          <div class="flex flex-col items-center sm:items-start">
            <h2 class="font-bold text-lg">{section.title}:</h2>
            <nav class="flex flex-col space-y-1 w-full text-center sm:text-left">
              {section.data.map(({ path, text }) => (
                <div class="footer-link-container">
                  <NavLinkButton text={text} path={path} variant={"footer"} />
                </div>
              ))}
            </nav>
          </div>
        ))
      }
    </div>

    <div
      class="border-t border-white/10 py-6 text-center text-xs tracking-wide"
    >
      Consulte a su médico; es el único facultado para indicar el tipo de
      estudio de laboratorio a realizar de acuerdo a su historia clínica y a la
      interpretación de sus resultados.
    </div>

    <div
      class="border-t border-white/10 py-6 flex flex-col md:flex-row justify-center items-center gap-4 text-xs opacity-60 tracking-wide"
    >
      <p>© {new Date().getFullYear()} DYRA. TODOS LOS DERECHOS RESERVADOS.</p>
      <span class="hidden md:inline">|</span>
      <a
        href="/aviso-de-privacidad.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-medium uppercase tracking-wider hover:underline hover:opacity-100 transition-all duration-300"
      >
        AVISO DE PRIVACIDAD
      </a>
    </div>
  </div>
</footer>

<style>
  .footer-link-container :global(a),
  .footer-link-container :global(button) {
    display: block !important;
    width: 100% !important;
    padding: 0.5rem 0 !important;
    background: transparent !important;
    text-align: inherit !important;
  }
</style>
