---
import logoDyra from "../../assets/images/logo.png";
import {
  facebook,
  instagram,
  whatsapp,
} from "../../assets/icons/networks-icons";
import Navbar from "./Navbar.astro";
import DrawerWrapper from "../../components/react/wrappers/DrawerWrapper";
---

<header class="bg-white shadow-md px-4 sm:px-8 py-4 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto flex justify-between items-center">
    {/* IZQUIERDA: LOGO */}
    <a href="/" class="flex items-center gap-3">
      <img
        src={logoDyra.src}
        alt="logo-dyra"
        class="w-20 h-auto object-contain"
      />
    </a>

    <div class="flex items-center gap-4">
      <div class="hidden md:block">
        <Navbar />
      </div>

      {/* ICONOS SOLO EN DESKTOP */}
      <div class="hidden md:flex items-center gap-4">
        <a href="#" aria-label="Facebook">
          <img src={facebook.src} alt="Facebook" class="w-8 h-8" />
        </a>
        <a href="#" aria-label="Instagram">
          <img src={instagram.src} alt="Instagram" class="w-8 h-8" />
        </a>
        <a href="#" aria-label="WhatsApp">
          <img src={whatsapp.src} alt="WhatsApp" class="w-8 h-8" />
        </a>
      </div>

      <div class="md:hidden">
        <!-- <HeaderReact client:load /> -->
        <DrawerWrapper client:load />
      </div>
    </div>
  </div>
</header>
