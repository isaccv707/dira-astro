---
import dyraLogo from '../../assets/images/logo.png';
import NavLinkButton from '../../components/react/ui/NavLinkButton';

---

<div
    class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-20 py-20 flex flex-col-reverse lg:flex-row items-center gap-10"
>
    <div class="lg:w-1/2 text-center lg:text-left space-y-6">
        <h1
            class="text-4xl sm:text-5xl font-extrabold text-green-700 leading-tight"
        >
            Mejora tu salud con análisis clínicos confiables
        </h1>
        <p
            class="text-green-prbg-green-primary dark:text-black text-lg sm:text-xl"
        >
            Resultados rápidos, precisos y a domicilio. Descubre cómo podemos
            ayudarte a cuidar tu salud.
        </p>
        <NavLinkButton
            path="/appointment"
            text="Agenda tu cita"
            variant="primary"
            size="lg"
        />
    </div>

    <div class="lg:w-1/2 flex justify-center">
        <img src={dyraLogo.src} alt="Laboratorio" class="w-full max-w-sm" />
    </div>
</div>
