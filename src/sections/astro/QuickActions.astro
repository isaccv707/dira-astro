---
import type { ReactNode } from "react";
import { CiCalendar } from "react-icons/ci";
import { GiChemicalDrop } from "react-icons/gi";
import type { IconType } from "react-icons";
import { BiDollar } from "react-icons/bi";

interface QuickActions {
    Icon: IconType;
    text: string;
    path: string;
    bgColor: string;
}

const quickActions: QuickActions[] = [
    {
        Icon: CiCalendar,
        text: "Agenda tu cita",
        path: "https://wa.me/3318622542",
        bgColor: "bg-green-primary",
    },
    {
        Icon: GiChemicalDrop,
        text: "Consulta tus resultados",
        path: "/results",
        bgColor: "bg-green-secondary",
    },
    {
        Icon: BiDollar,
        text: "Cotizador",
        path: "/quoter",
        bgColor: "bg-yellow-primary",
    },
];
---

<section class="py-12 bg-white">
    <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-green-primary">
            Ahora más fácil en línea
        </h2>
    </div>

    <div
        class="flex flex-col md:flex-row justify-center items-center gap-6 md:gap-10 px-6"
    >
        {
            quickActions.map(({ path, bgColor, Icon, text }) => (
                <a
                    href={path}
                    class={`flex items-center justify-center gap-4 text-white font-semibold rounded-xl shadow-md transition-all duration-300 ${bgColor} hover:brightness-110 w-full md:w-80 p-6`}
                >
                    <div class="flex items-center justify-center w-12 h-12 rounded-full bg-white/20 text-2xl">
                        <Icon />
                    </div>
                    <span class="text-lg text-center">{text}</span>
                </a>
            ))
        }
    </div>
</section>
