---
import NavigationQuickActions from "../../components/astro/buttons/NavigationQuickAction.astro";
import { quickActions } from "../../data/quickActions/quickActions";
import QuickActionButton from "../../components/react/buttons/QuickActionButton";
---

<section>
  <div
    class="flex flex-col items-center justify-center gap-4 md:flex-row md:gap-6"
  >
    {
      quickActions.map(({ path, accent, icon, text, description }) => (
        <NavigationQuickActions
          path={path}
          text={text}
          description={description}
          accent={accent}
          icon={icon}
        />
      ))
    }

    <QuickActionButton
      text="Resultados"
      description="Consulta tus estudios en línea"
      client:load
    />
  </div>
</section>
