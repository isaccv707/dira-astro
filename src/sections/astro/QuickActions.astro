---
import NavigationQuickActions from "../../components/astro/buttons/NavigationQuickAction.astro";
import { quickActions } from "../../data/quickActions/quickActions";
import QuickActionButton from "../../components/react/buttons/QuickActionButton";
import { getActiveBranchContact } from "../../api/branchesApi/branchesApi";
import { buildWhatsappUrl } from "../../utils/whatsapp";

const contact = await getActiveBranchContact();
---

<section>
  <div
    class="flex flex-col items-center justify-center gap-4 md:flex-row md:gap-6"
  >
    {
      quickActions.map(({ path, isWhatsapp, accent, icon, text, description }) => (
        <NavigationQuickActions
          path={isWhatsapp && contact?.phone ? buildWhatsappUrl(contact.phone) : path}
          text={text}
          description={description}
          accent={accent}
          icon={icon}
        />
      ))
    }

    <QuickActionButton
      text="Resultados"
      description="Consulta tus estudios en línea"
      client:load
    />
  </div>
</section>
