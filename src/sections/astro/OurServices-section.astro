---
import HeaderBySection from "../../components/astro/ui/HeaderBySection.astro";
import ModalServiceWrapper from "../../components/react/wrappers/ModalServiceWrapper";
---

<section class="w-full py-12 md:py-20 lg:py-24 px-4 sm:px-8 lg:px-12">
    <div class="flex justify-center text-center mb-10">
        <HeaderBySection
            textHeader={"Servicios"}
            title={"Soluciones clínicas para cada necesidad"}
            paragraph={`Conoce nuestros servicios y estudios disponibles. Te ayudamos con atención clara, procesos confiables y resultados listos cuando los necesites.`}
            textColor="green-secondary"
        />
    </div>
    <ModalServiceWrapper client:load />
</section>
