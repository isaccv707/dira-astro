# Copiar a .env. Nunca versionar el .env real.

# Backend, incluye el prefijo /api
PUBLIC_API_URL=http://localhost:3000/api
PORT=4321

# Origen público para canonical, Open Graph y sitemap (default https://dyranalitica.com)
PUBLIC_SITE_URL=http://localhost:4321
# Sucursal usada sin cookie dyra_branch_id. Sin valor cae a la de producción, que no existe
# en una base local: usar la sucursal del seed de desarrollo del backend.
PUBLIC_DEFAULT_BRANCH_ID=a1b2c3d4-0001-4000-8000-000000000001

# Link de WhatsApp para agendar citas
PUBLIC_URL_WHATSAPP=

# EmailJS (formulario de contacto)
PUBLIC_SERVICE_EMAILJS=
PUBLIC_TEMPLATEID_EMAILJS=
PUBLIC_KEY_EMAILJS=
